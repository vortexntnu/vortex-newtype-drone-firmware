{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:ICACHE",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "title": "Add a label",
              "type": "array",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_ICACHE_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "actions": [
                {
                  "type": "warning",
                  "condition": "$info.init_type != 'called'",
                  "message": "ICACHE is not called automatically at startup"
                }
              ],
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_ICACHE_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "associativity_mode": {
              "title": "Associativity mode",
              "type": "string",
              "description": "The associativity mode is a compromise solution in which the cache lines are divided into sets, and the middle bits of its address determine which set a block will be stored in: within each set the cache remains fully associative.\nThe associativity mode can be set to 1-way for applications needing very-low-power consumption profile.",
              "oneOf": [
                {
                  "title": "1-way",
                  "const": "1WAY"
                },
                {
                  "title": "2-ways",
                  "const": "2WAYS"
                }
              ],
              "default": "2WAYS"
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "remap_regions": {
              "title": "Memory address remap",
              "type": "array",
              "source": "Array.from({ length: ($resource.features.Region)}, (_, i) => ({ id: ('REGION_' + i ) }))",
              "itemId": "id",
              "itemVar": "region",
              "items": {
                "type": "object",
                "properties": {
                  "use_region": {
                    "title": "Use region",
                    "type": "boolean",
                    "default": false
                  },
                  "size": {
                    "title": "Size",
                    "type": "integer",
                    "description": "Value of the memory region size.",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable remap region."
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "2 MB",
                        "const": 2
                      },
                      {
                        "title": "4 MB",
                        "const": 4
                      },
                      {
                        "title": "8 MB",
                        "const": 8
                      },
                      {
                        "title": "16 MB",
                        "const": 16
                      },
                      {
                        "title": "32 MB",
                        "const": 32
                      },
                      {
                        "title": "64 MB",
                        "const": 64
                      },
                      {
                        "title": "128 MB",
                        "const": 128
                      }
                    ],
                    "default": 2
                  },
                  "base_address": {
                    "title": "Base address",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable remap region."
                      }
                    ],
                    "description": "Base address must be between 0x0 and 0x1FE00000.",
                    "minimum": 0,
                    "maximum": 534773760,
                    "display_format": [
                      "hex"
                    ],
                    "default": 0
                  },
                  "remap_address": {
                    "title": "Remap address",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable remap region."
                      }
                    ],
                    "description": "Remap address must be between 0x0 and 0xFFE00000.",
                    "minimum": 0,
                    "maximum": 4292870144,
                    "display_format": [
                      "hex"
                    ],
                    "default": 0
                  },
                  "master_port": {
                    "title": "Master port",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region && ($resource.features.SMaster !== 0)",
                        "message": "Enable remap region; requires multiple master ports."
                      },
                      {
                        "type": "set",
                        "condition": "$resource.features.SMaster === 0",
                        "attributes": {
                          "description": "One AHB master port: master1 port (outputs to Fast bus of main AHB bus matrix)."
                        }
                      },
                      {
                        "type": "set",
                        "condition": "$resource.features.SMaster !== 0",
                        "attributes": {
                          "description": "Two AHB Master ports: master1 and master2 ports (outputs to Fast and Slow buses of main AHB bus matrix, respectively)."
                        }
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Master1 port",
                        "const": 1
                      },
                      {
                        "title": "Master2 port",
                        "const": 2,
                        "actions": [
                          {
                            "type": "exclude",
                            "condition": "$resource.features.SMaster === 0"
                          }
                        ]
                      }
                    ],
                    "default": 1
                  },
                  "output_burst": {
                    "title": "Output burst",
                    "type": "string",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable remap region."
                      }
                    ],
                    "description": "This is the output burst type for cache master port read accesses.\nPossibility to configure burst type of AHB memory transaction for remapped remap_regions: INCRw or WRAPw (size w aligned on cache line size).",
                    "oneOf": [
                      {
                        "title": "Wrap",
                        "const": "WRAP"
                      },
                      {
                        "title": "Incr",
                        "const": "INCR"
                      }
                    ],
                    "default": "WRAP"
                  }
                }
              }
            },
            "monitors": {
              "title": "Monitors",
              "type": "object",
              "properties": {
                "hit_monitor": {
                  "title": "Hit monitor",
                  "type": "boolean",
                  "description": "The 32-bit hit monitor counts the cacheable AHB-transactions on the slave cache port that hit the ICACHE content.",
                  "default": false
                },
                "miss_monitor": {
                  "title": "Miss monitor",
                  "type": "boolean",
                  "description": "The 16-bit miss monitor counts the cacheable AHB-transactions on the slave cache port that miss the ICACHE content.",
                  "default": false
                }
              }
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "title": "IRQ Handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($info.layer === 'HAL') && $system.nvic.enable_interruption"
                    }
                  ]
                },
                "chose_error_interrupt": {
                  "title": "ICACHE interrupts enabled at startup",
                  "type": "object",
                  "description": "Select which ICACHE interrupts are enabled at startup.",
                  "properties": {
                    "cache_error": {
                      "title": "Cache error",
                      "type": "boolean",
                      "description": "Enable interrupt when a cache error occurs.",
                      "default": false,
                      "actions": [
                        {
                          "type": "enable",
                          "condition": "($system.nvic.enable_interruption)",
                          "message": "Enable NVIC interrupt."
                        },
                        {
                          "type": "set",
                          "condition": "!($system.nvic.enable_interruption)",
                          "attributes": {
                            "const": false
                          }
                        }
                      ]
                    }
                  }
                },
                "irq_config1": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}