{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:RNG",
  "grammarVersion": "3.9",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Add labels to create clear aliases for init, deinit, and get-handle helper functions in your application code.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RNG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "rng_standard": {
              "type": "integer",
              "title": "RNG standard",
              "oneOf": [
                {
                  "const": 0,
                  "title": "Certified NIST",
                  "actions": [
                    {
                  "type": "exclude",
                  "condition": "true"
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "Candidate NIST"
                },
                {
                  "const": 2,
                  "title": "German BSI"
                },
                {
                  "const": 3,
                  "title": "Custom"
                }
              ],
              "default": 1
            },
            "config_1": {
              "type": "integer",
              "title": "Custom profile value 1",
              "description": "Set custom profile value 1. Allowed range: 0x00 to 0x3F.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 63,
              "minimum": 0,
              "default": 8
            },
            "config_2": {
              "type": "integer",
              "title": "Custom profile value 2",
              "description": "Set custom profile value 2. Allowed range: 0x0 to 0x7.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 7,
              "default": 0
            },
            "config_3": {
              "type": "integer",
              "title": "Custom profile value 3",
              "description": "Set custom profile value 3. Allowed range: 0x0 to 0xF.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "display_format": [
                "hex"
              ],
              "maximum": 15,
              "minimum": 0,
              "default": 13
            },
            "health_test": {
              "type": "integer",
              "title": "Health test",
              "description": "RNG health test.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "maximum": 4294967295,
              "minimum": 0,
              "default": 29356
            },
            "clock_divider": {
              "type": "integer",
              "title": "Clock divider",
              "description": "Number of clock cycles per internal clock.",
              "default": 1,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "oneOf": [
                {
                  "title": "1 clock cycle",
                  "const": 1
                },
                {
                  "title": "2 clock cycles",
                  "const": 2
                },
                {
                  "title": "4 clock cycles",
                  "const": 4
                },
                {
                  "title": "8 clock cycles",
                  "const": 8
                },
                {
                  "title": "16 clock cycles",
                  "const": 16
                },
                {
                  "title": "32 clock cycles",
                  "const": 32
                },
                {
                  "title": "64 clock cycles",
                  "const": 64
                },
                {
                  "title": "128 clock cycles",
                  "const": 128
                },
                {
                  "title": "256 clock cycles",
                  "const": 256
                },
                {
                  "title": "512 clock cycles",
                  "const": 512
                },
                {
                  "title": "1024 clock cycles",
                  "const": 1024
                },
                {
                  "title": "2048 clock cycles",
                  "const": 2048
                },
                {
                  "title": "4096 clock cycles",
                  "const": 4096
                },
                {
                  "title": "8192 clock cycles",
                  "const": 8192
                },
                {
                  "title": "16384 clock cycles",
                  "const": 16384
                },
                {
                  "title": "32768 clock cycles",
                  "const": 32768
                }
              ]
            },
            "standard": {
              "type": "string",
              "title": "Standard",
              "description": "RNG NIST compliance.",
              "default": "CUSTOM",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "oneOf": [
                {
                  "title": "RNG custom",
                  "const": "CUSTOM"
                },
                {
                  "title": "RNG NIST compliant",
                  "const": "NIST"
                }
              ]
            },
            "clock_error_detection": {
              "type": "boolean",
              "default": true,
              "title": "RNG clock error detection state",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ]
            },
            "noise_source": {
              "type": "object",
              "title": "Noise source",
              "description": "Choose the oscillator sources used to build entropy for the custom profile.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==3"
                }
              ],
              "properties": {
                "osc_1_src": {
                  "type": "object",
                  "title": "Oscillator noise source 1",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_2_src": {
                  "type": "object",
                  "title": "Oscillator noise source 2",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_3_src": {
                  "type": "object",
                  "title": "Oscillator noise source 3",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_4_src": {
                  "type": "object",
                  "title": "Oscillator noise source 4",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_5_src": {
                  "type": "object",
                  "title": "Oscillator noise source 5",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                },
                "osc_6_src": {
                  "type": "object",
                  "title": "Oscillator noise source 6",
                  "description": "This parameter represent the selection of one or a combination of oscillator noise sources.",
                  "objectType": "polynomial",
                  "size": [
                    3
                  ],
                  "default": {
                    "value": 7,
                    "size": 3
                  }
                }
              }
            },
            "rng_cert_nist_cr": {
              "type": "integer",
              "title": "Certified NIST ",
              "default": 15731968,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 15731968
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cert_nist_nscr": {
              "type": "integer",
              "title": "Certified NIST noise source",
              "default": 97467,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 97467
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cert_nist_htcr": {
              "type": "integer",
              "title": "Certified NIST health test",
              "default": 41648,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==0"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==0",
                  "attributes": {
                    "const": 41648
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_cr": {
              "type": "integer",
              "title": "Candidate NIST",
              "default":1048832,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":1048832
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_nscr": {
              "type": "integer",
              "title": "Candidate NIST noise source",
              "default":511,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":511
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_nist_htcr": {
              "type": "integer",
              "title": "Candidate NIST health test",
              "default":43719,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==1"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==1",
                  "attributes": {
                    "const":43719
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_cr": {
              "type": "integer",
              "title": "Candidate german BSI",
              "default":136318720,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":136318720
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_nscr": {
              "type": "integer",
              "title": "Candidate german BSI noise source",
              "default":511,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":511
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            },
            "rng_cand_german_bsi_htcr": {
              "type": "integer",
              "title": "Candidate german BSI health test",
              "default":43719,
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.rng_standard==2"
                },
                {
                  "type": "set",
                  "condition": "$basic.rng_standard==2",
                  "attributes": {
                    "const":43719
                  }
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is disabled by default."
                }
              ],
              "display_format": [
                "hex"
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "description": "All Functions.",
          "title": "Advanced features",
          "properties": {
            "enable_clock_error_detection": {
              "type": "boolean",
              "title": "Clock error detection",
              "default": false
            },
            "enable_auto_reset": {
              "type": "boolean",
              "title": "Automatic reset",
              "default": false
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "#comment": "Use for instance for RNG",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "description": "Control system-level RNG options, including interrupt behavior.",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "default": false,
                  "title": "Interrupt"
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}