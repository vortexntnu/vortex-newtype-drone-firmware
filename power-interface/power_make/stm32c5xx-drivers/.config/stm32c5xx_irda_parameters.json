{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:UART",
  "grammarVersion": "3.1",
  "functions": [
    {
      "path": ".config/template/helpers/uart_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_UART_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "UART"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "baud_rate": {
              "type": "integer",
              "title": "Baud rate",
              "description": "This member configures the UART/IRDA communication baud rate.\n      The baud rate register is computed using the following formula:\n          - UART:\n               Baud Rate Register = ((uart_ker_ckpres) / ((hal_uart_config_t->baud_rate)))\n              ((hal_uart_config_t->baud_rate)))[15:4]\n              Baud Rate Register[3] =  0\n              Baud Rate Register[2:0] =  (((2 * uart_ker_ckpres) /\n              ((hal_uart_config_t->baud_rate)))[3:0]) >> 1\n            where uart_ker_ck_pres is the UART input clock divided by a prescaler.",
              "actions": [
                {
                  "type": "set",
                  "computed": {
                    "minimum": "$common.helper_uart_get_min_baud_rate($get('clock.frequency',$resource.id), $basic.clock_prescaler, 16, $resource.features.baudgen_type)",
                    "maximum": "$common.helper_uart_get_max_baud_rate($get('clock.frequency',$resource.id), $basic.clock_prescaler, 16, $resource.features.baudgen_type)"
                  },
                  "condition": "true"
                }
              ],
              "minimum": 0,
              "maximum": 20000000,
              "default": 115200
            },
            "clock_prescaler": {
              "type": "integer",
              "title": "Clock prescaler",
              "description": "Prescaler value used to divide the IRDA clock source.",
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                },
                {
                  "title": "DIV256",
                  "const": 256
                }
              ],
              "default": 1
            },
            "word_length": {
              "type": "string",
              "title": "Word length",
              "description": "Number of data bits transmitted or received in a frame.",
              "oneOf": [
                {
                  "title": "7-bit (including parity)",
                  "const": "7"
                },
                {
                  "title": "8-bit (including parity)",
                  "const": "8"
                },
                {
                  "title": "9-bit (including parity)",
                  "const": "9"
                }
              ],
              "default": "8"
            },
            "irda_power_mode": {
              "type": "string",
              "title": "IRDA power mode",
              "description": "Power mode selection for IRDA protocol.",
              "oneOf": [
                {
                  "title": "Normal mode",
                  "const": "NORMAL"
                },
                {
                  "title": "Low power mode",
                  "const": "LOW"
                }
              ],
              "default": "NORMAL"
            },
            "direction": {
              "type": "string",
              "title": "Data direction",
              "description": "Receive and/or transmit mode selection.",
              "oneOf": [
                {
                  "title": "Receive",
                  "const": "RX"
                },
                {
                  "title": "Transmit",
                  "const": "TX"
                },
                {
                  "title": "Transmit and receive",
                  "const": "TX_RX",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'RX') || !$get('pinout.peripheralCanBeMapped', $resource.id, 'TX')"
                    }
                  ]
                }
              ],
              "default": "TX_RX"
            },
            "irda_prescaler": {
              "type": "integer",
              "title": "IRDA prescaler",
              "description": "Specifies the Prescaler value for dividing the UART/USART source clock to achieve low-power frequency.",
              "minimum": 1,
              "maximum": 255,
              "default": 1
            },
            "parity": {
              "type": "string",
              "title": "Parity",
              "description": "Parity mode. When parity is enabled, the computed parity is inserted at the MSB position of the transmitted data (9th bit when the word length is set to 9 data bits; 8th bit when the word length is set to 8 data bits).",
              "oneOf": [
                {
                  "title": "None",
                  "const": "NONE"
                },
                {
                  "title": "Even",
                  "const": "EVEN"
                },
                {
                  "title": "Odd",
                  "const": "ODD"
                }
              ],
              "default": "NONE"
            },
            "one_bit_sampling": {
              "type": "boolean",
              "title": "One bit sampling",
              "description": "Single sample or three samples majority. Selecting the single sample method increases the receiver tolerance to clock deviations.",
              "default": false,
              "actions": [
                {
                  "message": "One bit sampling is not available in this instance.",
                  "type": "disable",
                  "condition": "$resource.features.baudgen_type==true"
                }
              ]
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "enable_stop_mode": {
              "type": "boolean",
              "title": "Wake up from low power mode (LP)",
              "default": false
            },
            "enable_tx_pin_level_invert": {
              "type": "boolean",
              "title": "Tx pin active level inversion",
              "default": false
            },
            "enable_rx_pin_level_invert": {
              "type": "boolean",
              "title": "Rx pin active level inversion",
              "default": false
            },
            "enable_data_invert": {
              "type": "boolean",
              "title": "Data inversion",
              "default": false
            },
            "enable_tx_rx_swap": {
              "type": "boolean",
              "title": "Tx and Rx pins swapping",
              "default": false
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_tx": {
                  "title": "GPIO Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') && ($basic.direction === 'TX' || $basic.direction === 'TX_RX')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rx": {
                  "title": "GPIO Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'RX') && ($basic.direction === 'RX' || $basic.direction === 'TX_RX')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "type": "boolean",
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'TX' || $basic.direction === 'TX_RX'"
                    }
                  ],
                  "default": false
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "default": "INCREMENTED"
                        },
                        "dest_inc": {
                          "default": "FIXED"
                        },
                        "dest_data_width": {
                          "default": "BYTE"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rx": {
                  "type": "boolean",
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'RX' || $basic.direction === 'TX_RX'"
                    }
                  ],
                  "default": false
                },
                "dma_config_rx": {
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "default": "FIXED"
                        },
                        "dest_inc": {
                          "default": "INCREMENTED"
                        },
                        "dest_data_width": {
                          "default": "BYTE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "message": "Interrupt is mandatory when DMA is enabled.",
                      "type": "disable",
                      "condition": "$system.dma.enable_dma_tx"
                    },
                    {
                      "type": "set",
                      "condition": "$system.dma.enable_dma_tx",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC UART global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}