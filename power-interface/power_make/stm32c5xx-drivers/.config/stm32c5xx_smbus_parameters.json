{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:SMBUS",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/i2c_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_SMBUS_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "SMBUS"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "advanced_timing_configuration": {
              "type": "boolean",
              "title": "Additional parameters for the timing calculation",
              "default": false
            },
            "speed_frequency_hz": {
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.advanced_timing_configuration"
                }
              ],
              "type": "integer",
              "title": "Speed frequency",
              "oneOf": [
                {
                  "title": "Standard mode - 100 kHz",
                  "const": 100000
                },
                {
                  "title": "Fast mode - 400 kHz",
                  "const": 400000
                },
                {
                  "title": "Fast mode plus - 1 MHz",
                  "const": 1000000
                }
              ],
              "default": 100000
            },
            "timing": {
              "type": "integer",
              "title": "Timing register",
              "description": "This timing is directly calculated by CubeMX2.",
              "display_format": [
                "hex"
              ],
              "maximum": 4043309055,
              "default": 0,
              "readOnly": true,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.advanced_timing_configuration"
                },
                {
                  "type": "set",
                  "computed": {
                    "const": "$common.helper_compute_timing_basic($get('clock.frequency',$resource.id), $basic.speed_frequency_hz).timing_reg"
                  }
                }
              ]
            },
            "clock_timing_configuration": {
              "type": "object",
              "title": "Clock timing",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.advanced_timing_configuration"
                }
              ],
              "properties": {
                "speed_frequency_custom": {
                  "type": "integer",
                  "title": "Speed frequency",
                  "minimum": 1,
                  "maximum": 1000000,
                  "default": 100000,
                  "unit": "Hz",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    }
                  ]
                },
                "rise_time": {
                  "type": "integer",
                  "title": "Rise time",
                  "maximum": 1000,
                  "default": 0,
                  "unit": "ns",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    },
                    {
                      "type": "set",
                      "condition": "$basic.clock_timing_configuration.speed_frequency_custom <= 100000",
                      "attributes": {
                        "maximum": 1000
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$basic.clock_timing_configuration.speed_frequency_custom > 100000 && $basic.clock_timing_configuration.speed_frequency_custom <= 400000",
                      "attributes": {
                        "maximum": 300
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$basic.clock_timing_configuration.speed_frequency_custom> 400000",
                      "attributes": {
                        "maximum": 120
                      }
                    }
                  ]
                },
                "fall_time": {
                  "type": "integer",
                  "title": "Fall time",
                  "maximum": 300,
                  "default": 0,
                  "unit": "ns",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    },
                    {
                      "type": "set",
                      "condition": "$basic.clock_timing_configuration.speed_frequency_custom <= 400000",
                      "attributes": {
                        "maximum": 300
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$basic.clock_timing_configuration.speed_frequency_custom > 400000",
                      "attributes": {
                        "maximum": 120
                      }
                    }
                  ]
                },
                "enable_analog_filter": {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    }
                  ],
                  "type": "boolean",
                  "title": "Analog noise filter",
                  "default": true
                },
                "digital_noise_filter": {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    }
                  ],
                  "type": "integer",
                  "title": "Coefficient of digital noise filter ",
                  "minimum": 0,
                  "maximum": 15,
                  "default": 0
                },
                "timing": {
                  "type": "integer",
                  "title": "Timing register",
                  "description": "This timing is directly calculated by CubeMX2.",
                  "display_format": [
                    "hex"
                  ],
                  "maximum": 4043309055,
                  "default": 0,
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.advanced_timing_configuration"
                    },
                    {
                      "type": "set",
                      "computed": {
                        "const": "$common.helper_compute_timing_advanced($get('clock.frequency',$resource.id), $basic.clock_timing_configuration.speed_frequency_custom, $basic.clock_timing_configuration.rise_time, $basic.clock_timing_configuration.fall_time, $basic.clock_timing_configuration.digital_noise_filter, $basic.clock_timing_configuration.enable_analog_filter).timing_reg"
                      }
                    }
                  ]
                }
              }
            },
            "own_address1": {
              "type": "integer",
              "title": "Own primary 7-bit address",
              "minimum": 0,
              "maximum": 127,
              "display_format": [
                "hex",
                "dec"
              ],
              "default": 0
            },
            "device_mode": {
              "type": "string",
              "title": "Peripheral mode",
              "default": "HOST",
              "oneOf": [
                {
                  "title": "Host",
                  "const": "HOST"
                },
                {
                  "title": "Slave",
                  "const": "SLAVE"
                },
                {
                  "title": "Slave ARP",
                  "const": "SLAVE_ARP"
                }
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "enable_timeout_a": {
              "type": "boolean",
              "title": "Timeout A",
              "default": false
            },
            "timeout_a_configuration": {
              "type": "object",
              "title": "Timeout A",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_timeout_a"
                }
              ],
              "properties": {
                "timeout_a": {
                  "type": "integer",
                  "title": "Duration",
                  "default": 0,
                  "unit": "ns",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$additional.timeout_a_configuration.timeout_a_mode === 'SCL_LOW'",
                      "attributes": {
                        "maximum": 35000000,
                        "minimum": 25000000
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$additional.timeout_a_configuration.timeout_a_mode === 'SDA_SCL_HIGH'",
                      "attributes": {
                        "maximum": 16383999,
                        "minimum": 0
                      }
                    }
                  ]
                },
                "timeout_a_mode": {
                  "type": "string",
                  "title": "Mode",
                  "default": "SCL_LOW",
                  "oneOf": [
                    {
                      "title": "Increase on SCL low",
                      "const": "SCL_LOW"
                    },
                    {
                      "title": "Increase on SCL/SDA High",
                      "const": "SDA_SCL_HIGH"
                    }
                  ],
                  "actions": [
                    {
                      "type": "enable"
                    }
                  ]
                },
                "timeout_a_register": {
                  "type": "integer",
                  "title": "Register",
                  "description": "This timeout register is directly calculated by CubeMX2.",
                  "display_format": [
                    "hex"
                  ],
                  "maximum": 4043309055,
                  "default": 0,
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.timeout_a_configuration"
                    },
                    {
                      "type": "set",
                      "computed": {
                        "const": "$common.helper_compute_timeouta($get('clock.frequency',$resource.id), $additional.timeout_a_configuration.timeout_a_mode, $additional.timeout_a_configuration.timeout_a)"
                      }
                    }
                  ]
                }
              }
            },
            "enable_timeout_b": {
              "type": "boolean",
              "title": "Timeout B",
              "default": false
            },
            "timeout_b_configuration": {
              "type": "object",
              "title": "Timeout B",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_timeout_b"
                }
              ],
              "properties": {
                "timeout_b": {
                  "type": "integer",
                  "title": "Duration",
                  "default": 0,
                  "unit": "ns",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$basic.device_mode !== 'HOST'",
                      "attributes": {
                        "maximum": 25000000
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$basic.device_mode === 'HOST'",
                      "attributes": {
                        "maximum": 10000000
                      }
                    }
                  ]
                },
                "timeout_b_register": {
                  "type": "integer",
                  "title": "Register",
                  "description": "This timeout register is directly calculated by CubeMX2.",
                  "display_format": [
                    "hex"
                  ],
                  "maximum": 4043309055,
                  "default": 0,
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.timeout_b_configuration"
                    },
                    {
                      "type": "set",
                      "computed": {
                        "const": "$common.helper_compute_timeoutb($get('clock.frequency',$resource.id), $basic.device_mode, $additional.timeout_b_configuration.timeout_b)"
                      }
                    }
                  ]
                }
              }
            },
            "enable_autonomous_mode": {
              "type": "boolean",
              "title": "Autonomous mode",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.auton > 0"
                }
              ]
            },
            "autonomous_configuration": {
              "type": "object",
              "title": "Autonomous",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_autonomous_mode"
                }
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "title": "Trigger source",
                  "actions": [
                    {
                      "type": "info",
                      "condition": "true",
                      "message": "The selected interconnect must be configured manually."
                    }
                  ],
                  "objectType": "query",
                  "query": {
                    "entity": "peripheral.interconnect.input trigger",
                    "parent": "$resource.id",
                    "title": "{{source}}"
                  }
                },
                "polarity": {
                  "type": "string",
                  "title": "Trigger polarity",
                  "oneOf": [
                    {
                      "title": "Rising",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "const": "FALLING"
                    }
                  ],
                  "default": "RISING"
                }
              }
            },
            "enable_fast_mode_plus": {
              "type": "boolean",
              "title": "IO 20 mA fast mode plus",
              "default": false
            },
            "enable_wake_up": {
              "type": "boolean",
              "title": "Slave wakeup from stop mode",
              "default": false
            },
            "enable_ack_general_call": {
              "type": "boolean",
              "title": "Slave acknowledge general call",
              "default": false
            },
            "enable_own_address2": {
              "type": "boolean",
              "title": "Slave secondary address",
              "default": false
            },
            "own_address2_configuration": {
              "type": "object",
              "title": "Slave secondary address",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_own_address2"
                }
              ],
              "properties": {
                "own_address2": {
                  "type": "integer",
                  "title": "Own secondary 7-bit address",
                  "display_format": [
                    "hex",
                    "dec"
                  ],
                  "minimum": 0,
                  "maximum": 127,
                  "default": 0
                },
                "mask_address2": {
                  "type": "string",
                  "title": "Mask",
                  "oneOf": [
                    {
                      "title": "No mask",
                      "const": "NOMASK"
                    },
                    {
                      "title": "Mask 01",
                      "const": "MASK01"
                    },
                    {
                      "title": "Mask 02",
                      "const": "MASK02"
                    },
                    {
                      "title": "Mask 03",
                      "const": "MASK03"
                    },
                    {
                      "title": "Mask 04",
                      "const": "MASK04"
                    },
                    {
                      "title": "Mask 05",
                      "const": "MASK05"
                    },
                    {
                      "title": "Mask 06",
                      "const": "MASK06"
                    },
                    {
                      "title": "Mask 07",
                      "const": "MASK07"
                    }
                  ],
                  "default": "NOMASK"
                }
              }
            },
            "enable_packet_error_check": {
              "type": "boolean",
              "title": "Packet error check",
              "default": false
            },
            "enable_host_alert_detection": {
              "type": "boolean",
              "title": "Host alert detection",
              "default": false
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_scl": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected SMBUS peripheral cannot be mapped to a SMBUS_SCL pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'SCL')"
                    }
                  ],
                  "title": "GPIO SCL",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SCL",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "OPENDRAIN"
                        }
                      }
                    }
                  ]
                },
                "gpio_sda": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected SMBUS peripheral cannot be mapped to a SMBUS_SDA pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'SDA')"
                    }
                  ],
                  "title": "GPIO SDA",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SDA",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "OPENDRAIN"
                        }
                      }
                    }
                  ]
                },
                "gpio_smba": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected SMBUS peripheral cannot be mapped to a SMBUS_SMBA pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'SMBA')"
                    },
                    {
                      "type": "include",
                      "condition": "$additional.enable_host_alert_detection"
                    }
                  ],
                  "title": "GPIO SMBA",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SMBA",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "OPENDRAIN"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_event_interruption": {
                  "type": "boolean",
                  "title": "Event interrupt",
                  "default": false
                },
                "event_irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_event_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config_event": {
                  "title": "Event",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_event_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "EV"
                    }
                  ]
                },
                "enable_error_interruption": {
                  "type": "boolean",
                  "title": "Error interrupt",
                  "default": false
                },
                "error_irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_error_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config_error": {
                  "title": "Error",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_error_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "ERR"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}