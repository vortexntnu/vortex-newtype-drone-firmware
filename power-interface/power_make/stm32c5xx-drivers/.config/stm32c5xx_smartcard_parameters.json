{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32u5 hal Code Gen:SMARTCARD Init",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_SMARTCARD_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "SMARTCARD"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "baud_rate": {
              "type": "integer",
              "title": "Baud rate",
              "description": "Communication baud rate. The baud rate register is computed using the following formula: baud rate register = usart_ker_ckpres /BaudRate where usart_ker_ckpres is the USART input clock divided by a prescaler.",
              "minimum": 0,
              "default": 10752
            },
            "stop_bit": {
              "type": "string",
              "title": "Stop bits",
              "default": "0_5",
              "oneOf": [
                {
                  "title": "0.5 stop bit",
                  "const": "0_5"
                },
                {
                  "title": "1.5 stop bits",
                  "const": "1_5"
                }
              ]
            },
            "first_bit": {
              "type": "string",
              "title": "Bit order",
              "default": "LSB_FIRST",
              "oneOf": [
                {
                  "title": "LSB first",
                  "const": "LSB_FIRST"
                },
                {
                  "title": "MSB first",
                  "const": "MSB_FIRST"
                }
              ]
            },
            "parity": {
              "title": "Parity control",
              "type": "string",
              "default": "ODD",
              "oneOf": [
                {
                  "title": "Even",
                  "const": "EVEN"
                },
                {
                  "title": "Odd",
                  "const": "ODD"
                }
              ]
            },
            "nack": {
              "title": "NACK management",
              "type": "boolean",
              "default": false
            },
            "clock_source_frequency": {
              "type": "string",
              "title": "Clock source frequency",
              "description": "Input clock frequency can be modified in clock tree.",
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                  }
                }
              ],
              "default": ""
            },
            "clock_prescaler": {
              "title": "USART input clock prescaller",
              "type": "integer",
              "default": 1,
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                },
                {
                  "title": "DIV256",
                  "const": 256
                }
              ]
            },
            "sclk_prescaler": {
              "title": "SMARTCARD output clock prescaller",
              "type": "integer",
              "default": 2,
              "oneOf": [
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV14",
                  "const": 14
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV18",
                  "const": 18
                },
                {
                  "title": "DIV20",
                  "const": 20
                },
                {
                  "title": "DIV22",
                  "const": 22
                },
                {
                  "title": "DIV24",
                  "const": 24
                },
                {
                  "title": "DIV26",
                  "const": 26
                },
                {
                  "title": "DIV28",
                  "const": 28
                },
                {
                  "title": "DIV30",
                  "const": 30
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV34",
                  "const": 34
                },
                {
                  "title": "DIV36",
                  "const": 36
                },
                {
                  "title": "DIV38",
                  "const": 38
                },
                {
                  "title": "DIV40",
                  "const": 40
                },
                {
                  "title": "DIV42",
                  "const": 42
                },
                {
                  "title": "DIV44",
                  "const": 44
                },
                {
                  "title": "DIV46",
                  "const": 46
                },
                {
                  "title": "DIV48",
                  "const": 48
                },
                {
                  "title": "DIV50",
                  "const": 50
                },
                {
                  "title": "DIV52",
                  "const": 52
                },
                {
                  "title": "DIV54",
                  "const": 54
                },
                {
                  "title": "DIV56",
                  "const": 56
                },
                {
                  "title": "DIV58",
                  "const": 58
                },
                {
                  "title": "DIV60",
                  "const": 60
                },
                {
                  "title": "DIV62",
                  "const": 62
                }
              ]
            },
            "clock_output": {
              "title": "Clock signal output on CK pin",
              "type": "boolean",
              "default": false
            },
            "clock_polarity": {
              "type": "string",
              "title": "Clock polarity",
              "default": "LOW",
              "oneOf": [
                {
                  "title": "Low",
                  "const": "LOW"
                },
                {
                  "title": "High",
                  "const": "HIGH"
                }
              ]
            },
            "clock_phase": {
              "type": "integer",
              "title": "Clock phase",
              "default": 1,
              "oneOf": [
                {
                  "title": "First edge",
                  "const": 1
                },
                {
                  "title": "Second edge",
                  "const": 2
                }
              ]
            },
            "guard_time_etu": {
              "type": "integer",
              "title": "Guard time (ETU)",
              "description": "Guard time applied after stop bits.",
              "minimum": 0,
              "maximum": 255,
              "default": 0
            },
            "auto_retry_count": {
              "type": "integer",
              "title": "Auto-retry count",
              "description": "Number of retries in receive and transmit mode. When set to 0, retransmission is disabled. Otherwise, its maximum value is 7 (before signalling an error).",
              "minimum": 0,
              "maximum": 7,
              "default": 0
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "enable_fifo_mode": {
              "type": "boolean",
              "title": "FIFO mode",
              "default": false,
              "variables": [
                {
                  "on": "update-value",
                  "name": "USART_CORE_USE_HAL_SMARTCARD_FIFO",
                  "condition": "$value",
                  "value": true
                }
              ]
            },
            "set_tx_fifo_threshold": {
              "type": "string",
              "title": "Tx FIFO threshold",
              "oneOf": [
                {
                  "title": "1/8 empty",
                  "const": "1_8"
                },
                {
                  "title": "1/4 empty",
                  "const": "1_4"
                },
                {
                  "title": "1/2 empty",
                  "const": "1_2"
                },
                {
                  "title": "3/4 empty",
                  "const": "3_4"
                },
                {
                  "title": "7/8 empty",
                  "const": "7_8"
                },
                {
                  "title": "8/8 empty (empty)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            },
            "set_rx_fifo_threshold": {
              "type": "string",
              "title": "Rx FIFO threshold",
              "oneOf": [
                {
                  "title": "1/8 full",
                  "const": "1_8"
                },
                {
                  "title": "1/4 full",
                  "const": "1_4"
                },
                {
                  "title": "1/2 full",
                  "const": "1_2"
                },
                {
                  "title": "3/4 full",
                  "const": "3_4"
                },
                {
                  "title": "7/8 full",
                  "const": "7_8"
                },
                {
                  "title": "8/8 full (full)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            },
            "enable_io_invert": {
              "title": "IO inversion",
              "type": "boolean",
              "description": "Pin active level logic inversion into the handler instance registers.",
              "default": false
            },
            "enable_data_invert": {
              "title": "Data inversion",
              "type": "boolean",
              "description": "Binary Data Inversion into the handler instance registers, (1=L, 0=H).",
              "default": false
            },
            "enable_tx_rx_swap": {
              "title": "Tx/Rx swap",
              "type": "boolean",
              "description": "Swap between Tx and Rx Pin into the handler instance registers.",
              "default": false
            },
            "disable_rx_over_run_detection": {
              "title": "Rx overrun detection",
              "type": "boolean",
              "description": "Rx overrun detection into the handler instance registers.",
              "default": false
            },
            "enable_dma_stop_on_rx_error": {
              "title": "DMA stop on Rx error",
              "type": "boolean",
              "description": "DMA stop on Rx error into the handler instance registers.",
              "default": false
            },
            "enable_receiver_timeout": {
              "title": "Receiver timeout",
              "type": "boolean",
              "description": "Receiver timeout feature into the handler instance registers.",
              "default": false
            },
            "set_receiver_timeout": {
              "title": "Receiver timeout value",
              "type": "integer",
              "description": "Receiver timeout value passed in parameters into the handler instance registers.",
              "default": 0,
              "actions": [
                {
                  "type": "include",
                  "condition": "($additional.enable_receiver_timeout)"
                }
              ],
              "minimum": 0,
              "maximum": 16777215
            },
            "set_tx_cplt_indication": {
              "title": "Tx complete indication",
              "type": "string",
              "description": "Pre guard time Tx complete indication.",
              "default": "AFTER",
              "oneOf": [
                {
                  "title": "Transmission complete after guard time",
                  "const": "AFTER"
                },
                {
                  "title": "Transmission complete before guard time",
                  "const": "BEFORE"
                }
              ]
            },
            "set_block_length": {
              "title": "Block length",
              "type": "integer",
              "description": "Block length for T=1 smartcard protocol passed in parameters into the handler instance registers.",
              "minimum": 0,
              "maximum": 255,
              "default": 0
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_clk": {
                  "title": "GPIO CLK",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CK')"
                    }
                  ]
                },
                "gpio_tx": {
                  "title": "GPIO Tx",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') || $additional.enable_tx_rx_swap"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rx": {
                  "title": "GPIO Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'RX') && $additional.enable_tx_rx_swap"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "title": "DMA Tx",
                  "type": "boolean",
                  "default": false
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "src_data_width": {
                          "forbid": [
                            "WORD"
                          ]
                        },
                        "dest_data_width": {
                          "forbid": [
                            "WORD"
                          ]
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rx": {
                  "title": "DMA Rx",
                  "type": "boolean",
                  "default": false
                },
                "dma_config_rx": {
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "src_data_width": {
                          "forbid": [
                            "WORD"
                          ]
                        },
                        "dest_data_width": {
                          "forbid": [
                            "WORD"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "message": "Interrupt is mandatory when DMA is enabled.",
                      "type": "disable",
                      "condition": "$system.dma.enable_dma_tx"
                    },
                    {
                      "type": "set",
                      "condition": "$system.dma.enable_dma_tx",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ Handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC SMARTCARD",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}