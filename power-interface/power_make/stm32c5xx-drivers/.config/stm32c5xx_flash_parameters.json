{
  "$schema": "http://json-schema.org/draft-07/schema",
  "componentid": "::Device:STM32CubeMX2 Config:FLASH",
  "grammarVersion": "3.5",
  "version": "1.0.0",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/flash_helpers.js",
      "accessor": "flash_helpers"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "title": "Add a label",
              "type": "array",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_FLASH_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "latency_display": {
              "title": "Latency",
              "description": "Synchronize with RCC panel : number of wait states required for the chosen system clock frequency. This ensures reliable FLASH memory access at different speeds.",
              "type": "integer",
              "synchronize": true,
              "synchronizeOn": {
                "path": "flash_latency",
                "component": "HAL-FLASH"
              },
              "oneOf": [
                { "title": "0 WS", "const": 0 },
                { "title": "1 WS", "const": 1 },
                { "title": "2 WS", "const": 2 },
                { "title": "3 WS", "const": 3 },
                { "title": "4 WS", "const": 4 },
                { "title": "5 WS", "const": 5 },
                { "title": "6 WS", "const": 6 },
                { "title": "7 WS", "const": 7 },
                { "title": "8 WS", "const": 8 },
                { "title": "9 WS", "const": 9 },
                { "title": "10 WS", "const": 10 },
                { "title": "11 WS", "const": 11 },
                { "title": "12 WS", "const": 12 },
                { "title": "13 WS", "const": 13 },
                { "title": "14 WS", "const": 14 },
                { "title": "15 WS", "const": 15 }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is read-only because latency settings are configured in the RCC panel. The FLASH panel only displays live synchronized values from RCC."
                }
              ],
              "default": 7
            },
            "programming_delay_display": {
              "title": "Programming delay",
              "description": "Synchronize with RCC panel : programming delay value required for the chosen system clock frequency. This ensures reliable FLASH memory operations at different speeds.",
              "type": "integer",
              "synchronize": true,
              "synchronizeOn": {
                "path": "flash_programming_delay",
                "component": "HAL-FLASH"
              },
              "oneOf": [
                { "title": "0", "const": 0 },
                { "title": "1", "const": 1 },
                { "title": "2", "const": 2 },
                { "title": "3", "const": 3 }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is read-only because programming delay settings are configured in the RCC panel. The FLASH panel only displays live synchronized values from RCC."
                }
              ],
              "default": 2
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "use_flash_programming": {
              "title": "Programming Mode",
              "type": "boolean",
              "default": false,
              "description": "When disabled, the programming mode selection is forced to 'Quad-word' and cannot be modified. This option is only available when using the HAL layer (not available for LL).",
              "variables": [
                {
                  "on": "update-value",
                  "name": "FLASH_USE_PROGRAM_BY_ADDR",
                  "condition": "$value",
                  "semaphore": true
                }
              ],
              "actions":[
                {
                  "type": "set",
                  "condition": "$info.layer === 'LL'",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "programming_mode": {
              "title": "Mode",
              "type": "string",
              "description": "Select the FLASH programming granularity used by the HAL APIs for this instance. This setting is editable only when 'Use flash programming' is enabled. If programming is disabled, the granularity is automatically set and locked to 'Quad-word'.",
              "actions":[
                {
                  "type": "set",
                  "condition": "!($additional.use_flash_programming)",
                  "attributes": {
                    "const": "QUADWORD"
                  }
                }
              ],
              "oneOf": [
                {
                  "title": "Byte",
                  "const": "BYTE",
                  "actions":[
                    {
                      "type": "include",
                      "condition": "$resource.features.program_by_byte"
                    }
                  ]
                },
                {
                  "title": "Half-word",
                  "const": "HALFWORD",
                  "actions":[
                    {
                      "type": "include",
                      "condition": "$resource.features.program_by_halfword"
                    }
                  ]
                },
                {
                  "title": "Word",
                  "const": "WORD",
                  "actions":[
                    {
                      "type": "include",
                      "condition": "$resource.features.program_by_word"
                    }
                  ]
                },
                {
                 "title": "Double-word",
                  "const": "DOUBLEWORD",
                  "actions":[
                    {
                      "type": "include",
                      "condition": "$resource.features.program_by_doubleword"
                    }
                  ]
                },
                {
                  "title": "Quad-word",
                  "const": "QUADWORD",
                  "actions":[
                    {
                      "type": "include",
                      "condition": "$resource.features.program_by_quadword"
                    }
                  ]
                }
              ],
              "default": "QUADWORD",
              "message": "By default the programming mode is set to the smallest granularity."
            },
            "enable_single_ecc_interrupt": {
              "title": "Single ECC error interrupt",
              "type": "boolean",
              "description": "Enable generation of an interrupt on single ECC error and generate the corresponding ECC IRQ handler. This option is only available when 'Use error Code Correction (ECC)' is enabled; otherwise it is automatically cleared and disabled.",
              "default": false,
              "variables": [
                {
                  "on": "update-value",
                  "name": "FLASH_USE_ECC",
                  "condition": "$value",
                  "semaphore": true
                }
              ]
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($info.layer === 'HAL') && ($system.nvic.enable_interruption)"
                    }
                  ]
                },
                "itf_irq_handler_generation": {
                  "title": "Interface IRQ handler generation",
                  "type": "boolean",
                  "description": "This handler processes FLASH interface interrupt requests for option-bytes programming and error handling.",
                  "default": false,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($info.layer === 'HAL') && ($system.nvic.enable_interruption)"
                    }
                  ]
                },
                "use_unitary_irq_handlers": {
                  "title": "Unitary IRQ",
                  "type": "boolean",
                  "description": "These handlers manage interrupt requests for FLASH programming Address and ECC error handling.",
                  "default": false,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($info.layer === 'HAL') && ($system.nvic.enable_interruption)"
                    }
                  ]
                },
                "unitary_apis": {
                  "title": "List of unitary IRQ handlers",
                  "type": "array",
                  "source": "$flash_helpers.helper_flash_get_unitary_irq_handler($additional, $system.nvic)",
                  "rendering": "horizontal-list",
                  "itemId": "name",
                  "itemVar": "irq_name",
                  "allowRanking": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.use_unitary_irq_handlers == true)"
                    }
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "use_unitary_irq_handler": {
                        "title": "Use this unitary IRQ handler API",
                        "type": "boolean",
                        "description": "Generate the specific process IRQ handler API. ECC single IT or double IT must be enabled to be able to generate the ECC IRQ handler.",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": "$flash_helpers.helper_flash_check_unitary_irq_handler($additional, $system.nvic, $item)",
                            "message": "To disable this unitary IRQHandler, disable the related FLASH configuration."
                          },
                          {
                            "type": "set",
                            "condition": "$flash_helpers.helper_flash_check_unitary_irq_handler($additional, $system.nvic, $item)",
                            "attributes": {
                              "const": true
                            }
                          }
                        ],
                        "variables": [
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_PROGRAM_BY_ADDR",
                            "condition": "($item._foreignKey === 'HAL_FLASH_ProgramByAddr_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          },
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_ERASE_BY_ADDR",
                            "condition": "($item._foreignKey === 'HAL_FLASH_EraseByAddr_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          },
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_ERASE_PAGE",
                            "condition": "($item._foreignKey === 'HAL_FLASH_ErasePage_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          },
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_ERASE_BANK",
                            "condition": "($item._foreignKey === 'HAL_FLASH_EraseBank_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          },
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_MASS_ERASE",
                            "condition": "($item._foreignKey === 'HAL_FLASH_MassErase_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          },
                          {
                            "on": "update-value",
                            "name": "FLASH_USE_ECC",
                            "condition": "($item._foreignKey === 'HAL_FLASH_ECC_IRQHandler') && ($item.use_unitary_irq_handler)",
                            "semaphore": true
                          }
                        ]
                      },
                      "name": {
                        "type": "string",
                        "default": "",
                        "title": "Instance",
                        "actions": [
                          {
                            "type": "disable",
                            "condition": "true",
                            "message": "Instance is auto-filled from available IRQ handlers and is read-only."
                          },
                          {
                            "type": "set",
                            "condition": "true",
                            "computed": {
                              "const": "$irq_name.name"
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "irq_config1": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_CORTEX_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                },
                "enable_interruption_nmi": {
                  "title": "NMI FLASH exception management",
                  "description": "This handler processes the NMI exception that occurs when a double ECC error is detected in the FLASH.",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation_nmi": {
                  "title": "NMI IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption_nmi && ($info.layer === 'HAL')"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "FLASH_USE_ECC",
                      "condition": "$value",
                      "semaphore": true
                    }
                  ]
                },
                "nmi_config1": {
                  "title": "NMI priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption_nmi"
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "system:NMI"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}


