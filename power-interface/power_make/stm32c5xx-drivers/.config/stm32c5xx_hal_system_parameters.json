{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:System",
  "grammarVersion": "3.8",
  "license": "LICENSE.md",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "warning": {
          "title": "Warning",
          "type": "string",
          "default": "Add NVIC to the project to enable interrupt handling.",
          "actions": [
            {
              "type": "exclude",
              "condition": "$get('peripheral.isBound', 'NVIC')"
            },
            {
              "type": "disable",
              "condition": "!$get('peripheral.isBound', 'NVIC')",
              "message": "NVIC must be bound to the project."
            },
            {
              "type": "warning",
              "condition": "!$get('peripheral.isBound', 'NVIC')",
              "message": "Add NVIC to the project to enable interrupt handling."
            }
          ]
        },
        "system_configuration": {
          "type": "object",
          "title": "System",
          "properties": {
            "icache_enable": {
              "type": "boolean",
              "title": "ICACHE activation at startup",
              "actions": [
                {
                  "type": "disable",
                  "condition": "!$get('peripheral.isBound', 'ICACHE')",
                  "message": "Add ICACHE to the project to activate it at startup."
                }
              ],
              "default": true
            },
            "use_vdd_value": {
              "type": "boolean",
              "title": "Use VDD",
              "default": false,
              "description": "Add the definition of VDD_VALUE in generated code inside stm32_external_env.h and activate compile-time option (USE_EXTERNAL_ENV). Turn on when ADC/DAC is used so voltage-dependent calculations use the correct supply voltage.",
              "actions": [
                {
                  "type": "set",
                  "condition": "$get('envVar.value', 'HAL_USE_VDD_VALUE')",
                  "attributes": {
                    "const": true
                  }
                }
              ]
            },
            "rcc_rst": {
              "type": "boolean",
              "title": "Reset RCC at system initialization",
              "default": false,
              "description": "Perform a reset of the RCC peripheral at system initialization. This may be necessary in case the system starts with an unknown state of the RCC. Enabling this option ensures that the RCC is in its default state."
            },
            "vdd_value": {
              "type": "number",
              "title": "VDD",
              "unit": "mV",
              "minimum": 1710,
              "maximum": 3600,
              "default": 3300,
              "actions": [
                {
                  "type": "include",
                  "condition": "$system_configuration.use_vdd_value"
                },
                {
                  "type": "set",
                  "condition": "($get('hwPlatform.vdd').value !== undefined) && ($get('hwPlatform.vdd').value != 0) && ($get('hwPlatform.vdd').unit === 'mV')",
                  "attributes": {
                    "title": "VDD value set on the board"
                  },
                  "computed": {
                    "const": "$get('hwPlatform.vdd').value"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('hwPlatform.vdd').value !== undefined) && ($get('hwPlatform.vdd').value != 0) && ($get('hwPlatform.vdd').unit === 'V')",
                  "attributes": {
                    "title": "VDD value set on the board"
                  },
                  "computed": {
                    "const": "$get('hwPlatform.vdd').value * 1000"
                  }
                },
                {
                  "type": "disable",
                  "condition": "($get('hwPlatform.vdd').value !== undefined) && ($get('hwPlatform.vdd').value != 0) && (($get('hwPlatform.vdd').unit === 'mV') || ($get('hwPlatform.vdd').unit === 'V'))",
                  "message": "This value comes from the board supply voltage and can't be edited here."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_SYSTEM_PROJECT_USE_VDD_VALUE",
                  "condition": "$value !== undefined",
                  "computed_value": "$value"
                }
              ]
            }
          }
        },
        "generated_function_calls_not_ranked": {
          "type": "array",
          "title": "Initialization function calls (not ranked)",
          "rendering": "horizontal-list",
          "source": "$common.helper_common_get_generated_function_calls_not_ranked($get('sw-config.list-configurations', '{ \"init\": \"init_type\", \"layer\": \"layer\", \"function_type\": \"function_type\" }'))",
          "itemId": "index",
          "itemVar": "functions_calls",
          "itemTitle": "_rank",
          "items": {
            "type": "object",
            "properties": {
              "hw_instance": {
                "type": "string",
                "default": "",
                "title": "Instance",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.index"
                    }
                  }
                ]
              },
              "peripheral": {
                "type": "string",
                "default": "",
                "title": "Component",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.sw_instance"
                    }
                  }
                ]
              },
              "layer": {
                "type": "string",
                "title": "Layer",
                "default": "HAL",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.layer"
                    }
                  }
                ]
              },
              "generated": {
                "type": "boolean",
                "default": true,
                "title": "Generated",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.init !== 'disabled'"
                    }
                  }
                ]
              },
              "callable": {
                "type": "boolean",
                "title": "Callable",
                "default": true,
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.init === 'called'"
                    }
                  }
                ]
              },
              "mode": {
                "type": "string",
                "default": "",
                "title": "Mode",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.function_type"
                    }
                  }
                ]
              },
              "name": {
                "type": "string",
                "default": "",
                "title": "Function",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.name"
                    }
                  }
                ]
              }
            }
          }
        },
        "generated_function_calls": {
          "type": "array",
          "title": "Ranking of generated initialization function calls",
          "rendering": "horizontal-list",
          "source": "$common.helper_common_get_generated_function_calls($get('sw-config.list-configurations', '{ \"init\": \"init_type\", \"layer\": \"layer\", \"function_type\": \"function_type\" }'))",
          "itemId": "index",
          "itemVar": "functions_calls",
          "itemTitle": "_rank",
          "allowRanking": true,
          "items": {
            "type": "object",
            "properties": {
              "hw_instance": {
                "type": "string",
                "default": "",
                "title": "Instance",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.index"
                    }
                  }
                ]
              },
              "peripheral": {
                "type": "string",
                "default": "",
                "title": "Component",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.sw_instance"
                    }
                  }
                ]
              },
              "layer": {
                "type": "string",
                "title": "Layer",
                "default": "HAL",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.layer"
                    }
                  }
                ]
              },
              "generated": {
                "type": "boolean",
                "default": true,
                "title": "Generated",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.init !== 'disabled'"
                    }
                  }
                ]
              },
              "callable": {
                "type": "boolean",
                "title": "Callable",
                "default": true,
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.init === 'called'"
                    }
                  }
                ]
              },
              "mode": {
                "type": "string",
                "default": "",
                "title": "Mode",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.function_type"
                    }
                  }
                ]
              },
              "name": {
                "type": "string",
                "default": "",
                "title": "Function",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true",
                    "message": "This field is read-only and cannot be edited here."
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.name"
                    }
                  }
                ]
              }
            }
          }
        },
        "code_generation": {
          "type": "object",
          "title": "Code generation model",
          "properties": {
            "isr_handler": {
              "type": "boolean",
              "default": false,
              "title": "Single file for all interrupt handlers",
              "description": "Put all interrupt handlers (ISR) in mx_cortex_nvic.c and mx_cortex_nvic.h.",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "true"
                }
              ]
            },
            "optim_enable": {
              "type": "boolean",
              "default": true,
              "title": "Low-layer code optimization",
              "description": "Reduce generated Low-layer (LL) code by relying on peripheral reset defaults."
            },
            "strategy": {
              "type": "string",
              "oneOf": [
                {
                  "description": "Generate one mx_ppp.c/mx_ppp.h pair per peripheral type.",
                  "const": "SW",
                  "title": "Per peripheral type",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "true"
                    }
                  ]
                },
                {
                  "const": "HW",
                  "title": "Per peripheral instance",
                  "description": "Generate one mx_pppi.c/mx_pppi.h pair per peripheral instance."
                }
              ],
              "title": "Code generation strategy",
              "description": "Code generation is based on software or hardware instance.",
              "variables": [
                {
                  "on": "update-value",
                  "name": "SYSTEM_PROJECT_CODEGEN_STRATEGY",
                  "computed_value": "$value"
                }
              ],
              "default": "HW"
            },
            "exti_callback_user_data": {
              "actions": [
                {
                  "type": "set",
                  "condition": "$get('envVar.value', 'HAL_EXTI_SYSTEM_GPIO_STANDARD_EXTI')",
                  "attributes": {
                    "const": true
                  }
                },
                {
                  "type": "disable",
                  "condition": "$get('envVar.value', 'HAL_EXTI_SYSTEM_GPIO_STANDARD_EXTI')",
                  "message": "This option is forced to be enabled as HAL EXTI is enabled inside GPIO configuration panel."
                }
              ],
              "type": "boolean",
              "title": "EXTI callback and user data upon activation",
              "description": "Enable EXTI callback registration with user data so generated code can connect driver callbacks to EXTI events and pass application-specific context.",
              "default": false,
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_SYSTEM_CORE_EXTI_CALLBACK_USER_DATA",
                  "computed_value": "$value"
                }
              ]
            }
          }
        },
        "debug": {
          "type": "object",
          "title": "Debug",
          "properties": {
            "assert_dbg_param": {
              "type": "boolean",
              "title": "Assert checks on function parameters",
              "description": "Enable parameter checks for HAL and LL (USE_ASSERT_DBG_PARAM defined at build time).",
              "default": false,
              "synchronize": true,
              "synchronizeOn": {
                "path": "assert_dbg_param",
                "component": "HAL-CORE"
              }
            },
            "assert_dbg_param_function": {
              "type": "boolean",
              "title": "Generate default assert parameter handler",
              "description": "Generate in mx_system.c the definition of 'assert_dbg_param_failed' function. Otherwise, function must be defined in the application.",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$debug.assert_dbg_param"
                }
              ]
            },
            "assert_dbg_state": {
              "type": "boolean",
              "title": "Assert checks on module state",
              "description": "Enable software driver state checks for HAL (USE_ASSERT_DBG_STATE defined at build time).",
              "default": false,
              "synchronize": true,
              "synchronizeOn": {
                "path": "assert_dbg_state",
                "component": "HAL-CORE"
              }
            },
            "assert_dbg_state_function": {
              "type": "boolean",
              "title": "Use default assert state function",
              "description": "Generate in mx_system.c the definition of 'assert_dbg_state_failed' function. Otherwise, function must be defined in the application.",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$debug.assert_dbg_state"
                }
              ]
            }
          }
        }
      }
    }
  }
}
