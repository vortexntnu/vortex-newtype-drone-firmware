{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:IWDG",
  "grammarVersion": "3.7",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/iwdg_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL",
                  "title": "HAL"
                },
                {
                  "const": "LL",
                  "title": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_IWDG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "Interrupt handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "title": "Applicative services",
          "properties": {
            "start_function": {
              "type": "boolean",
              "title": "Start function generation",
              "description": "If the box is checked, a function to start the IWDG using the values inputted in the interface is generated.",
              "default": true
            },
            "iwdg_calculator": {
              "type": "object",
              "title": "Calculator",
              "properties": {
                "iwdg_clock_frequency": {
                  "description": "LSI frequency.",
                  "title": "IWDG clock frequency",
                  "unit": "Hz",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "IWDG_FREQ",
                      "condition": "true",
                      "computed_value": "$get('clock.frequency', 'LSI')"
                    }
                  ],
                  "type": "integer",
                  "default": 1000,
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$get('clock.frequency', 'LSI')"
                      }
                    }
                  ]
                },
                "unit": {
                  "type": "string",
                  "title": "Time unit",
                  "description": "Time unit used by IWDG driver. The selection of a smaller unit provides higher resolution.",
                  "oneOf": [
                    {
                      "title": "Microseconds",
                      "const": "microseconds"
                    },
                    {
                      "title": "Milliseconds",
                      "const": "milliseconds"
                    },
                    {
                      "title": "Seconds",
                      "const": "seconds"
                    }
                  ],
                  "default": "milliseconds"
                },
                "allowed_min_time": {
                  "type": "integer",
                  "title": "Inputs lower limit",
                  "description": "Minimum possible value that can be entered for minimum and maximum time.",
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_iwdg_get_min_allowed_time($get('envVar.value', 'IWDG_FREQ'), $runtime.iwdg_calculator.unit)"
                      }
                    }
                  ]
                },
                "allowed_max_time": {
                  "type": "integer",
                  "title": "Inputs upper limit",
                  "description": "Maximum possible value that can be entered for minimum and maximum time.",
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_iwdg_get_max_allowed_time($get('envVar.value', 'IWDG_FREQ'), $runtime.iwdg_calculator.unit)"
                      }
                    }
                  ]
                },
                "max_time": {
                  "type": "object",
                  "title": "Maximum time",
                  "description": "Maximum time duration before reset is triggered by the IWDG if the counter is not refreshed.",
                  "properties": {
                    "user_max_time": {
                      "type": "integer",
                      "title": "Input",
                      "description": "User maximum time value input.",
                      "actions": [
                        {
                          "type": "error",
                          "message": "Value is not within the IWDG capabilities boundaries.",
                          "condition": "(($runtime.iwdg_calculator.max_time.user_max_time < $runtime.iwdg_calculator.allowed_min_time) || ($runtime.iwdg_calculator.max_time.user_max_time > $runtime.iwdg_calculator.allowed_max_time))"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "default": "$common.helper_iwdg_get_max_allowed_time($get('envVar.value', 'IWDG_FREQ'), $runtime.iwdg_calculator.unit)"
                          }
                        }
                      ],
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "IWDG_PRESCALER",
                          "condition": "$value !== undefined",
                          "computed_value": "$common.helper_iwdg_compute_prescaler($get('envVar.value', 'IWDG_FREQ'), $runtime.iwdg_calculator.max_time.user_max_time, $runtime.iwdg_calculator.unit)"
                        },
                        {
                          "on": "update-value",
                          "name": "IWDG_STEP",
                          "condition": "$value !== undefined",
                          "computed_value": "$common.helper_iwdg_compute_step($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $runtime.iwdg_calculator.unit)"
                        },
                        {
                          "on": "update-value",
                          "name": "IWDG_RELOAD",
                          "condition": "$value !== undefined",
                          "computed_value": "$common.helper_iwdg_compute_reload($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $runtime.iwdg_calculator.max_time.user_max_time, $runtime.iwdg_calculator.unit)"
                        }
                      ],
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "actual_max_time": {
                      "type": "number",
                      "title": "Actual",
                      "description": "Actual maximum time before reset.",
                      "readOnly": true,
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($runtime.iwdg_calculator.max_time.user_max_time <= $runtime.iwdg_calculator.allowed_max_time)"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $runtime.iwdg_calculator.max_time.user_max_time, $runtime.iwdg_calculator.unit)"
                          }
                        }
                      ]
                    }
                  }
                },
                "min_time": {
                  "type": "object",
                  "title": "Minimum time (window time)",
                  "description": "Minimum time duration before IWDG refresh is allowed (window).",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.window"
                    }
                  ],
                  "properties": {
                    "window_enable": {
                      "type": "boolean",
                      "description": "If the box is checked, the IWDG window is enabled and a minimum time before IWDG refresh is required.",
                      "default": false,
                      "title": "Window"
                    },
                    "user_min_time": {
                      "type": "integer",
                      "title": "Input",
                      "description": "User minimum time value input.",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$runtime.iwdg_calculator.min_time.window_enable == true"
                        },
                        {
                          "type": "error",
                          "message": "Value is not within the IWDG capabilities boundaries.",
                          "condition": "(($runtime.iwdg_calculator.min_time.user_min_time < $runtime.iwdg_calculator.allowed_min_time) || ($runtime.iwdg_calculator.min_time.user_min_time > $runtime.iwdg_calculator.max_time.user_max_time))"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "default": "$common.helper_iwdg_get_min_allowed_time($get('envVar.value', 'IWDG_FREQ'), $runtime.iwdg_calculator.unit)"
                          }
                        }
                      ],
                      "minimum": 0
                    },
                    "actual_min_time": {
                      "type": "number",
                      "title": "Actual",
                      "description": "Actual Minimum time before refresh is allowed.",
                      "readOnly": true,
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($runtime.iwdg_calculator.min_time.window_enable == true) && ($runtime.iwdg_calculator.min_time.user_min_time < $runtime.iwdg_calculator.max_time.user_max_time)"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $runtime.iwdg_calculator.min_time.user_min_time, $runtime.iwdg_calculator.unit)"
                          }
                        }
                      ],
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "IWDG_WINDOW",
                          "condition": "$value !== undefined",
                          "computed_value": "$common.helper_iwdg_compute_param($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $get('envVar.value', 'IWDG_RELOAD'), $runtime.iwdg_calculator.min_time.user_min_time, $runtime.iwdg_calculator.unit)"
                        }
                      ]
                    }
                  }
                },
                "early_wakeup": {
                  "type": "object",
                  "description": "Time of early wakeup interrupt generation.",
                  "title": "Early wakeup",
                  "properties": {
                    "ewi_enable": {
                      "type": "boolean",
                      "title": "Early wakeup interrupt",
                      "default": false
                    },
                    "user_ewi_time": {
                      "type": "integer",
                      "title": "Input",
                      "description": "User early wakeup time value input.",
                      "default": 0,
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$runtime.iwdg_calculator.early_wakeup.ewi_enable == true"
                        },
                        {
                          "type": "error",
                          "message": "Value is not within the IWDG capabilities boundaries.",
                          "condition": "$runtime.iwdg_calculator.early_wakeup.user_ewi_time >= $runtime.iwdg_calculator.max_time.user_max_time"
                        }
                      ],
                      "minimum": 0
                    },
                    "actual_ewi_time": {
                      "type": "number",
                      "title": "Actual ",
                      "description": "Actual early wakeup Interrupt time value.",
                      "readOnly": true,
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($runtime.iwdg_calculator.early_wakeup.ewi_enable == true) && ($runtime.iwdg_calculator.early_wakeup.user_ewi_time < $runtime.iwdg_calculator.max_time.user_max_time)"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $runtime.iwdg_calculator.early_wakeup.user_ewi_time, $runtime.iwdg_calculator.unit)"
                          }
                        }
                      ],
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "IWDG_EWI",
                          "condition": "($value !== undefined) && ($value >= $get('envVar.value', 'IWDG_STEP'))",
                          "computed_value": "$common.helper_iwdg_compute_param($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $get('envVar.value', 'IWDG_RELOAD'), $runtime.iwdg_calculator.early_wakeup.user_ewi_time, $runtime.iwdg_calculator.unit)"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}