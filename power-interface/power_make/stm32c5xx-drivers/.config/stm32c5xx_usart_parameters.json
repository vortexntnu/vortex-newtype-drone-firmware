{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:USART",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/usart_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_USART_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "USART"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "clock_source": {
              "type": "string",
              "title": "Clock source",
              "description": "Clock source can be modified in clock tree.",
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$get('clock.input', $resource.id)"
                  }
                }
              ],
              "default": ""
            },
            "clock_source_frequency": {
              "type": "string",
              "title": "Clock source frequency",
              "description": "Input clock frequency can be modified in clock tree.",
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                  }
                }
              ],
              "default": ""
            },
            "clock_prescaler": {
              "type": "integer",
              "title": "Clock prescaler",
              "description": "Prescaler value used to divide the USART clock source.",
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                },
                {
                  "title": "DIV256",
                  "const": 256
                }
              ],
              "default": 1
            },
            "baud_rate": {
              "type": "integer",
              "title": "Baud rate",
              "description": "Baudrate to be used on Tx and Rx lines.",
              "minimum": 0,
              "maximum": 20000000,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "minimum": "$common.helper_usart_get_min_baudrate($get('clock.frequency', $resource.id), 2)",
                    "maximum": "$common.helper_usart_get_max_baudrate($get('clock.frequency', $resource.id), 2)"
                  }
                }
              ],
              "default": 115200
            },
            "word_length": {
              "type": "string",
              "title": "Word length",
              "description": "Number of data bits transmitted or received in a frame.",
              "oneOf": [
                {
                  "title": "7-bit long frame",
                  "const": "7"
                },
                {
                  "title": "8-bit long frame",
                  "const": "8"
                },
                {
                  "title": "9-bit long frame",
                  "const": "9"
                }
              ],
              "default": "7"
            },
            "stop_bit": {
              "type": "string",
              "title": "Stop bit",
              "description": "Number of stop bits transmitted.",
              "oneOf": [
                {
                  "title": "0_5 stop bit frame",
                  "const": "0_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.smartcard_sel==true"
                    }
                  ]
                },
                {
                  "title": "1 stop bit frame",
                  "const": "1"
                },
                {
                  "title": "1_5 stop bit frame",
                  "const": "1_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.smartcard_sel==true"
                    }
                  ]
                },
                {
                  "title": "2 stop bit frame",
                  "const": "2"
                }
              ],
              "default": "1"
            },
            "parity": {
              "type": "string",
              "title": "Parity",
              "description": "Parity mode. When parity is enabled, the computed parity is inserted at the MSB position of the transmitted data (9th bit when the word length is set to 9 data bits; 8th bit when the word length is set to 8 data bits).",
              "oneOf": [
                {
                  "title": "None",
                  "const": "NONE"
                },
                {
                  "title": "Even",
                  "const": "EVEN"
                },
                {
                  "title": "Odd",
                  "const": "ODD"
                }
              ],
              "default": "NONE"
            },
            "mode": {
              "title": "Mode",
              "type": "string",
              "oneOf": [
                {
                  "title": "Master",
                  "const": "MASTER"
                },
                {
                  "title": "Slave",
                  "const": "SLAVE"
                }
              ],
              "default": "MASTER"
            },
            "direction": {
              "title": "Data direction",
              "type": "string",
              "description": "Receive and/or transmit mode selection.",
              "oneOf": [
                {
                  "title": "Receive",
                  "const": "RX"
                },
                {
                  "title": "Transmit",
                  "const": "TX"
                },
                {
                  "title": "Transmit and receive",
                  "const": "TX_RX",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') && $get('pinout.peripheralCanBeMapped', $resource.id, 'RX')"
                    }
                  ]
                }
              ],
              "default": "TX_RX"
            },
            "clock_polarity": {
              "type": "string",
              "title": "Clock polarity",
              "description": "USART Clock Polarity.",
              "oneOf": [
                {
                  "title": "Low",
                  "const": "LOW"
                },
                {
                  "title": "High",
                  "const": "HIGH"
                }
              ],
              "default": "LOW"
            },
            "clock_phase": {
              "type": "string",
              "title": "Clock phase",
              "oneOf": [
                {
                  "title": "First edge",
                  "const": "1"
                },
                {
                  "title": "Second edge",
                  "const": "2"
                }
              ],
              "default": "1"
            },
            "clock_last_bit": {
              "type": "boolean",
              "title": "Last bit clock pulse output",
              "description": "Last bit clock pulse output.",
              "default": false
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "autonomous_mode": {
              "title": "Autonomous mode",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.features.auton)"
                },
                {
                  "type": "disable",
                  "message": "Autonomous mode not available in slave mode.",
                  "condition": "($basic.mode != 'MASTER')"
                },
                {
                  "type": "info",
                  "condition": "true",
                  "message": "The selected interconnect must be configured manually."
                }
              ],
              "properties": {
                "am_enable_packet_trigger": {
                  "type": "boolean",
                  "title": "Autonomous mode",
                  "description": "Autonomous mode available in master mode only.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($resource.features.auton)"
                    },
                    {
                      "type": "set",
                      "condition": "($basic.mode != 'MASTER')",
                      "attributes": {
                        "const": false
                      }
                    }
                  ],
                  "default": false
                },
                "trigger_polarity": {
                  "type": "string",
                  "title": "Trigger polarity",
                  "oneOf": [
                    {
                      "title": "Rising",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "const": "FALLING"
                    }
                  ],
                  "default": "RISING",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.autonomous_mode.am_enable_packet_trigger"
                    }
                  ]
                },
                "packet_size_byte": {
                  "type": "integer",
                  "title": "Data size (bytes)",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.autonomous_mode.am_enable_packet_trigger"
                    }
                  ],
                  "minimum": 0,
                  "maximum": 65535,
                  "default": 0
                },
                "source": {
                  "type": "object",
                  "title": "Trigger source selection",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.autonomous_mode.am_enable_packet_trigger"
                    },
                    {
                      "type": "info",
                      "condition": "true",
                      "message": "The selected interconnect must be configured manually"
                    }
                  ],
                  "objectType": "query",
                  "query": {
                    "entity": "peripheral.interconnect.input trigger",
                    "parent": "$resource.id",
                    "title": "{{source}} ({{id}})"
                  }
                },
                "am_enable_idle": {
                  "type": "boolean",
                  "title": "Idle frame",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.autonomous_mode.am_enable_packet_trigger"
                    }
                  ],
                  "default": false
                }
              }
            },
            "slave_select": {
              "type": "boolean",
              "title": "Slave selection method ",
              "description": "SPI slave selection depends on NSS input pin if enabled or NSS pin is ignored if disabled.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.features.spi_slave == 1) && ($basic.mode == 'SLAVE')"
                },
                {
                  "type": "set",
                  "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CTS')",
                  "attributes": {
                    "const": false
                  }
                },
                {
                  "type": "disable",
                  "message": "Slave select not available when NSS/CTS pin cannot be mapped.",
                  "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CTS')"
                }
              ],
              "default": false
            },
            "enable_fifo_mode": {
              "type": "boolean",
              "title": "FIFO mode",
              "default": false,
              "variables": [
                {
                  "on": "update-value",
                  "name": "USART_CORE_USE_HAL_USART_FIFO",
                  "value": true
                }
              ]
            },
            "set_tx_fifo_threshold": {
              "type": "string",
              "title": "Tx FIFO threshold",
              "oneOf": [
                {
                  "title": "1/8 empty",
                  "const": "1_8"
                },
                {
                  "title": "1/4 empty",
                  "const": "1_4"
                },
                {
                  "title": "1/2 empty",
                  "const": "1_2"
                },
                {
                  "title": "3/4 empty",
                  "const": "3_4"
                },
                {
                  "title": "7/8 empty",
                  "const": "7_8"
                },
                {
                  "title": "8/8 empty (empty)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            },
            "set_rx_fifo_threshold": {
              "type": "string",
              "title": "Rx FIFO threshold",
              "oneOf": [
                {
                  "title": "1/8 full",
                  "const": "1_8"
                },
                {
                  "title": "1/4 full",
                  "const": "1_4"
                },
                {
                  "title": "1/2 full",
                  "const": "1_2"
                },
                {
                  "title": "3/4 full",
                  "const": "3_4"
                },
                {
                  "title": "7/8 full",
                  "const": "7_8"
                },
                {
                  "title": "8/8 full (full)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_clk": {
                  "title": "GPIO CLK",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CK')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_tx": {
                  "title": "GPIO Tx",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') || ($basic.direction == 'RX')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rx": {
                  "title": "GPIO Rx",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'RX') || ($basic.direction == 'TX')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_cts": {
                  "title": "GPIO NSS/CTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'CTS') && ($additional.slave_select)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CTS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "title": "DMA Tx",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'TX' || $basic.direction === 'TX_RX'"
                    }
                  ],
                  "default": false
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "dest_data_width": {
                          "const": "BYTE"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rx": {
                  "title": "DMA Rx",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'RX' || $basic.direction === 'TX_RX'"
                    }
                  ],
                  "default": false
                },
                "dma_config_rx": {
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_data_width": {
                          "const": "BYTE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "message": "Interrupt is mandatory when DMA is enabled.",
                      "type": "disable",
                      "condition": "$system.dma.enable_dma_tx"
                    },
                    {
                      "type": "set",
                      "condition": "$system.dma.enable_dma_tx",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC USART global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}