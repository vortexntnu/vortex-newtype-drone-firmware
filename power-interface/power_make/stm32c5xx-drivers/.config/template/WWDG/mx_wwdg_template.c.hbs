~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_wwdg_handle_t *{{@root.fct_name}}_init(void)
{

  if (HAL_WWDG_Init(&h{{@root.current_resource}}, HAL_{{@root.current_resource}}{{@root.current_index}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}


{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}

  /* Enable the interruption for WWDG */
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}

  return &h{{@root.current_resource}};
}

{{#if runtime.start_function}}
hal_status_t {{@root.fct_name}}_start(void)
{

  return HAL_WWDG_Start(&h{{@root.current_resource}}, {{runtime.wwdg_calculator.min_time.user_min_time}}UL, {{runtime.wwdg_calculator.max_time.user_max_time}}UL, {{#if system.nvic.enable_interruption}}1UL{{else}}0UL{{/if}});
}
{{/if}} {{!runtime.start_function~}}

{{else}}
{{!
    Generation of initialization function used in LL
~}}
WWDG_TypeDef *{{@root.fct_name}}_init(void)
{

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{#if system.nvic.enable_interruption}}
  /* Enable the interuption for WWDG */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context system.nvic.irq_config.needs @root.nvic_context)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}

{{/if}}
  return {{@root.current_resource}};
}

{{#if runtime.start_function}}
system_status_t {{@root.fct_name}}_start(void)
{
  /* These values are calculated from the ones inputted by the user in the WWDG panel. */
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER') 0))}}
{{#if runtime.wwdg_calculator.min_time.user_min_time}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'WWDG_WINDOW') 127)}}
  /* uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER'}}UL; */
{{else}}
  uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER'}}UL;
{{/if}}
{{else}}
  /* uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER'}}UL; */
{{/if}}
{{else}}
  uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER'}}UL;
{{/if}}
  uint32_t reload = {{@root.EnvVarAPI.getVariableValue 'WWDG_RELOAD'}}UL;
{{#if runtime.wwdg_calculator.min_time.user_min_time}}
{{#if (and (eq @root.optim_enable true) (and (eq (@root.EnvVarAPI.getVariableValue 'WWDG_WINDOW') 127) (eq (@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER') 0)))}}
  /* uint32_t window = {{@root.EnvVarAPI.getVariableValue 'WWDG_WINDOW'}}UL; */
{{else}}
  uint32_t window = {{@root.EnvVarAPI.getVariableValue 'WWDG_WINDOW'}}UL;
{{/if}}
{{else}}
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER') 0))}}
  /* uint32_t window = 127UL; */
{{else}}
  uint32_t window = 127UL;
{{/if}}
{{/if}}
{{#if system.nvic.enable_interruption}}
  uint32_t early_wakeup = 1U;
{{else}}
  uint32_t early_wakeup = 0U;
{{/if}}

  if (early_wakeup != 0U)
  {
    LL_WWDG_EnableIT_EWKUP({{@root.current_resource}});
  }

  /* Enable the WWDG driver and set the reload value to work with */
  LL_WWDG_SetControl({{@root.current_resource}}, reload);

  /* Write to WWDG CFR register the Prescaler and Window values to work with */
{{#if @root.optim_enable}}
{{#if runtime.wwdg_calculator.min_time.user_min_time}}
{{#if (and (eq (@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER') 0) (eq (@root.EnvVarAPI.getVariableValue 'WWDG_WINDOW') 127))}}
  /* LL_WWDG_SetConfig({{@root.current_resource}}, prescaler << WWDG_CFR_WDGTB_Pos, window); */
{{else}}
  LL_WWDG_SetConfig({{@root.current_resource}}, prescaler << WWDG_CFR_WDGTB_Pos, window);
{{/if}}
{{else}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'WWDG_PRESCALER') 0)}}
  /* LL_WWDG_SetConfig({{@root.current_resource}}, prescaler << WWDG_CFR_WDGTB_Pos, window); */
{{else}}
  LL_WWDG_SetConfig({{@root.current_resource}}, prescaler << WWDG_CFR_WDGTB_Pos, window);
{{/if}}
{{/if}}
{{else}}
  LL_WWDG_SetConfig({{@root.current_resource}}, prescaler << WWDG_CFR_WDGTB_Pos, window);
{{/if}}

  return SYSTEM_OK;
}
{{/if}} {{!runtime.start_function~}}
{{/if}}

