{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'WWDG' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "WWDG template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{assign 'include_mx_def' false~}}
{{#each @root.instances~}}
{{assign 'wwdg_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.wwdg_cxt.info.layer~}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
#include "mx_def.h"
{{else}}
#include "stm32_hal.h"
  {{#with @root.wwdg_cxt.security_privilege}}
    {{#unless @root.include_mx_def}}
      {{~assign 'include_mx_def' true~}}
#include "mx_def.h"
    {{/unless}}
  {{/with}}
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{assign 'wwdg_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.wwdg_cxt.info.layer~}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
{{assign 'wwdg_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.wwdg_cxt.info.layer~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for WWDG in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
  {{#with @root.wwdg_cxt}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_wwdg_handle_t *{{@root.fct_name}}_init(void);
{{else}}
WWDG_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

{{#if runtime.start_function}}
{{#if (eq @root.current_layer 'HAL')}}
/**
  * @brief   Start the WWDG. Before exiting the function, the watchdog is refreshed to have a correct time base.
  * @param   None
  * @retval  HAL_OK  Operation completed successfully.
  * @retval  HAL_ERROR Operation completed with error.
  */
hal_status_t {{@root.fct_name}}_start(void);
{{else}}
/**
  * @brief   Start the WWDG. Before exiting the function, the watchdog is refreshed to have a correct time base.
  * @param   None
  * @retval  SYSTEM_OK  Operation completed successfully.
  * @retval  SYSTEM_PERIPHERAL_ERROR Operation completed with error.
  */
system_status_t {{@root.fct_name}}_start(void);
{{/if}}
{{/if}} {{!Start~}}

{{#with security_privilege}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
{{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
{{/if}}

{{/with}}

{{#if (eq @root.current_layer 'HAL')}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_wwdg_handle_t *{{@root.fct_name}}_gethandle(void);

{{/if}}
  {{/with}}
{{/each}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void);

