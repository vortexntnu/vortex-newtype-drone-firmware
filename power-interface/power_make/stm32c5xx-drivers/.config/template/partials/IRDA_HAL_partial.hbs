{{!
  Partial used for HAL UART:
  how to use
  > IRDA_HAL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
    * exported_functions_gethandle
    * exported_functions_gethandle_prototype
~}}

{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
/* Handle for UART */
static hal_uart_handle_t h{{@root.current_resource}};

{{> GPIO_HAL fct='gpio_exti_get_variables' resource=@root.current_resource~}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
hal_uart_handle_t *{{@root.fct_name}}_init(void)
{
  hal_uart_irda_config_t irda_config;

  /* Basic configuration */
  if (HAL_UART_Init(&h{{@root.current_resource}}, HAL_{{replace (uppercase @root.current_resource) "USART" "UART"}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}

  irda_config.baud_rate = {{basic.baud_rate}};
  irda_config.clock_prescaler = HAL_UART_PRESCALER_DIV{{basic.clock_prescaler}};
  irda_config.word_length = HAL_UART_WORD_LENGTH_{{basic.word_length}}_BIT;
  irda_config.irda_power_mode = HAL_UART_IRDA_POWER_MODE_{{basic.irda_power_mode}};
  irda_config.direction = HAL_UART_DIRECTION_{{basic.direction}};
  irda_config.irda_prescaler = {{basic.irda_prescaler}};
  irda_config.parity = HAL_UART_PARITY_{{basic.parity}};
  {{#if basic.one_bit_sampling}}
  irda_config.one_bit_sampling = HAL_UART_ONE_BIT_SAMPLE_ENABLE;
  {{else}}
  irda_config.one_bit_sampling = HAL_UART_ONE_BIT_SAMPLE_DISABLE;
  {{/if}}

  if (HAL_UART_IRDA_SetConfig(&h{{@root.current_resource}}, &irda_config) != HAL_OK)
  {
    return NULL;
  }

{{#with additional}}
{{#if enable_tx_pin_level_invert}}
  /* Tx pin level inversion configuration */
  if (HAL_UART_EnableTxPinLevelInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if enable_rx_pin_level_invert}}
  /* Rx pin level inversion configuration */
  if (HAL_UART_EnableRxPinLevelInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if enable_data_invert}}
  /* Data inversion configuration */
  if (HAL_UART_EnableDataInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if enable_tx_rx_swap}}
  /* Tx and Rx pins swapping configuration */
  if (HAL_UART_EnableTxRxSwap(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if enable_stop_mode}}
  /* Wake up from low power mode configuration */
  if (HAL_UART_EnableStopMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{/with}}

{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL'~}}

{{#with system}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/if~}}
{{/with}} {{!nvic}}
{{#with dma}}
{{#if enable_dma_tx}}
  /* Configure the DMA TX */
{{> DMA_HAL fct='init' layer=@root.current_layer needs=dma_config_tx.needs arg3=@root.system_cxt.Clock_activation.dma_clk_enable_model}}
  /* Link the Transmit DMA handle to the UART handle */
  if (HAL_UART_SetTxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if enable_dma_rx}}
  /* Configure the DMA RX */
{{> DMA_HAL fct='init' layer=@root.current_layer needs=dma_config_rx.needs arg3=@root.system_cxt.Clock_activation.dma_clk_enable_model}}
  /* Link the Receive DMA handle to the UART handle */
  if (HAL_UART_SetRxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{/with}}
{{/with}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.nvic.enable_interruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if~}}
  (void)HAL_UART_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{> GPIO_HAL fct='deinit_resource' resource=@root.current_resource~}}

{{#with system}}
{{#if dma.enable_dma_tx}}
{{> DMA_HAL fct='deinit' needs=dma.dma_config_tx.needs~}}
{{/if~}}
{{#if dma.enable_dma_rx}}
{{> DMA_HAL fct='deinit' needs=dma.dma_config_rx.needs~}}
{{/if~}}
{{/with}}
}
{{!
################################
##  exported_functions_gethandle
################################
~}}
{{else if (eq fct 'exported_functions_gethandle')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined @root.current_function)~}}
hal_uart_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='implementation'}}
{{!
################################
##  exported_functions_gethandle_prototype
################################
~}}
{{else if (eq fct 'exported_functions_gethandle_prototype')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined @root.current_function)~}}
/**
  * @brief  Get the {{@root.fct_name}} object.
  * @retval Pointer on the {{@root.fct_name}}Handle
  */
hal_uart_handle_t *{{@root.fct_name}}_gethandle(void);

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}
{{else}}
#warning "step {{fct}} in partial IRDA_HAL not managed"
{{/if~}}
