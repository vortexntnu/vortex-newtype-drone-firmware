  how to use
  > IRDA_LL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
    * exported_functions_gethandle
    * exported_functions_gethandle_prototype
~}}

{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
{{#startsWith 'UART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}
{{#startsWith 'USART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}

{{> DMA_LL fct='get_dma_lli_variables' resource=@root.dma_resource strategy=@root.strategy}}

USART_TypeDef *{{@root.fct_name}}_init(void)
{
  uint32_t reg_temp;

  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}
  LL_USART_ConfigAsyncMode({{@root.current_resource}});

  reg_temp = (LL_USART_DATAWIDTH_{{basic.word_length}}_BIT | LL_USART_PARITY_{{basic.parity}}
              | LL_USART_DIRECTION_{{basic.direction}} | LL_USART_OVERSAMPLING_16);
  LL_{{@root.prefix}}_ConfigXfer({{@root.current_resource}}, reg_temp, LL_USART_STOP_BIT_1);

  {{helper_common_gen_ll_code 'LL_USART_SetPrescaler'(concat 'LL_USART_PRESCALER_DIV' basic.clock_prescaler)}}

  LL_USART_SetIrdaPrescaler({{@root.current_resource}}, {{basic.irda_prescaler}});

  {{helper_common_gen_ll_code 'LL_USART_SetIrdaPowerMode'(concat 'LL_USART_IRDA_POWER_MODE_' basic.irda_power_mode)}}

  LL_USART_ConfigIrdaMode({{@root.current_resource}});

{{#if basic.one_bit_sampling}}
  LL_USART_EnableOneBitSample({{@root.current_resource}});

{{/if}}
{{assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)}}
  LL_USART_SetBaudRate({{@root.current_resource}}, {{round @root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{basic.clock_prescaler}}, LL_USART_OVERSAMPLING_16,
                       {{basic.baud_rate}});
{{#with additional}}
{{#if enable_tx_pin_level_invert}}
  /* Tx pin level inversion configuration */
  LL_USART_SetTXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if enable_rx_pin_level_invert}}
  /* Rx pin level inversion configuration */
  LL_USART_SetRXPinLevel({{@root.current_resource}}, LL_USART_RXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if enable_data_invert}}
  /* Data inversion configuration */
  LL_USART_SetBinaryDataLogic({{@root.current_resource}}, LL_USART_BINARY_LOGIC_NEGATIVE);

{{/if~}}
{{#if enable_tx_rx_swap}}
  /* Tx and Rx pins swapping configuration */
  LL_USART_SetTXRXSwap({{@root.current_resource}}, LL_USART_TXRX_SWAPPED);

{{/if~}}
{{#if enable_stop_mode}}
  /* Wake up from low power mode configuration */
  LL_USART_EnableInStopMode({{@root.current_resource}});
{{/if~}}
{{/with}}

{{> GPIO_LL fct='init_resource' resource=@root.current_resource return_if_failed='0'~}}

{{#with system}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/if~}}
{{/with}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='init' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='init' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}
{{/with}}

  LL_USART_Enable({{@root.current_resource}});
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{#if system.nvic.enable_interruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
  LL_USART_Disable({{@root.current_resource}});

{{> GPIO_LL fct='deinit_resource' resource=@root.current_resource~}}

{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='deinit' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='deinit' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}
{{/with}}
}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='implementation'}}

{{else}}
#warning "step {{fct}} in partial IRDA_HAL not managed"
{{/if~}}
