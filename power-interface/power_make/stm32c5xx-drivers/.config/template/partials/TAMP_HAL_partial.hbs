{{!
  Partial used for HAL TAMP:
  how to use
  > TAMP_HAL fct='xxxx' with xxxx:
    * exported_functions_init
~}}

{{!
############################
##  exported_functions_init
############################
~}}
{{#with basic}}
{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if (eq mode "Passive")}}
{{#unless @root.found_passive_tamper}}
{{assign 'found_passive_tamper' true~}}
{{/unless}}
{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
{{#unless @root.found_active_tamper}}
{{assign 'found_active_tamper' true~}}
{{/unless}}
{{/if}}{{!Active~}}
{{/if}}{{!use_channel~}}
{{/each}}{{!tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#if (eq fct 'exported_functions_init')}}
system_status_t {{@root.fct_name}}_init(void)
{
{{#with basic}}
{{#with tamper_global_config}}
{{#with passive}}
  {{#if (eq @root.found_passive_tamper true)}}
  hal_tamp_passive_config_t             p_passive_global_config;
  {{/if}}
{{/with}}{{!passive~}}
{{#with active}}
  {{#if (eq @root.found_active_tamper true)}}
  hal_tamp_active_config_t              p_active_global_config;
  {{/if}}
{{/with}}{{!active~}}
{{/with}}{{!tamper_global_config~}}
{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if (eq mode "Passive")}}
{{#unless @root.found_passive_indiv_tamper}}
  {{assign 'found_passive_indiv_tamper' true~}}
  hal_tamp_passive_individual_config_t  p_passive_indiv_config;
{{/unless}}
{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
{{#unless @root.found_active_indiv_tamper}}
  {{assign 'found_active_indiv_tamper' true~}}
  hal_tamp_active_individual_config_t   p_active_indiv_config;
{{/unless}}
{{/if}}{{!Active~}}
{{/if}}{{!use_channel~}}
{{/each}}{{!tampers~}}
{{#each internal_tampers}}
{{#if use_channel}}
{{#unless @root.found_internal_tamper}}
  {{assign 'found_internal_tamper' true~}}
  hal_tamp_internal_individual_config_t p_internal_tamper_config;
{{/unless}}
{{/if}}{{!use_channel~}}
{{/each}}{{!internal_tampers~}}
{{/with}}{{!tamper_indiv_config~}}

{{/with}}{{!basic~}}

{{> PWR_HAL fct='generate_write_protection_disable'}}

{{#if (eq @root.found_active_tamper true)}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource~}}
{{/if}}

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource sw_resource='TAMP'}}

{{#with basic}}
{{#with tamper_global_config}}
{{#with passive}}
{{#if (eq @root.found_passive_tamper true)}}
  p_passive_global_config.precharge = HAL_TAMP_PASSIVE_PULL_UP_PRECHARGE_{{#if precharge}}ENABLE{{else}}DISABLE{{/if}};
  p_passive_global_config.precharge_duration = HAL_TAMP_PASSIVE_PULL_UP_PRECHARGE_{{precharge_duration}}_RTCCLK;
  p_passive_global_config.type_activation = HAL_TAMP_PASSIVE_FILTER_{{#if passive_filter}}{{filter_type_activation}}_SAMPLES{{else}}DISABLE{{/if}};
  p_passive_global_config.sample_frequency = HAL_TAMP_PASSIVE_SAMPLE_FREQ_DIV_{{sample_frequency_div}};
  if (HAL_TAMP_PASSIVE_SetConfig(&p_passive_global_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}
{{/with}}{{!passive~}}

{{#with active}}
{{#if (eq @root.found_active_tamper true)}}
  p_active_global_config.output_period = {{output_periode}};
  p_active_global_config.filter = HAL_TAMP_ACTIVE_FILTER_{{#if active_filter}}ENABLE{{else}}DISABLE{{/if}};
  p_active_global_config.asynchronous_prescaler = HAL_TAMP_ACTIVE_PRESCALER_RTCCLK{{#if (eq asynchronous_prescaler 1)}}{{else}}_DIV_{{asynchronous_prescaler}}{{/if}};
  p_active_global_config.shared_output = HAL_TAMP_ACTIVE_TAMPER_OUTPUT_{{#if output_shared}}SHARED{{else}}NOT_SHARED{{/if}};
  if (HAL_TAMP_ACTIVE_SetConfig(&p_active_global_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}
{{/with}}{{!active~}}
{{/with}}{{!tamper_global_config~}}

{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if (eq mode "Passive")}}
  p_passive_indiv_config.trigger = HAL_TAMP_PASSIVE_TRIGGER_{{trigger}};
  p_passive_indiv_config.erase_secrets = HAL_TAMP_PASSIVE_SECRETS_{{erase}};
  p_passive_indiv_config.masked = HAL_TAMP_PASSIVE_{{#if mask}}{{mask}}{{else}}UNMASKED{{/if}};
  if (HAL_TAMP_PASSIVE_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}HAL_TAMP_{{_foreignKey}}{{/if}}, &p_passive_indiv_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
  p_active_indiv_config.tamper_output = HAL_TAMP_ACTIVE_TAMPER_OUTPUT_{{tamper_output}};
  p_active_indiv_config.erase_secrets = HAL_TAMP_ACTIVE_SECRETS_{{erase}};
  if (HAL_TAMP_ACTIVE_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}HAL_TAMP_{{_foreignKey}}{{/if}}, &p_active_indiv_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}{{!Active~}}

{{assign 'gpio_in_resolved' (helper_tamp_get_gpio_need @root.pinoutAPI ../../../system.gpio _foreignKey)~}}
{{assign 'gpio_in_remap_define' (helper_tamp_get_remap_define @root.gpio_in_resolved "TAMP_IN2,PC1,HAL_TAMP_REMAP_TAMP_IN2_PA0_TO_PC1|TAMP_IN3,PA2,HAL_TAMP_REMAP_TAMP_IN3_PA1_TO_PA2")~}}
{{#if @root.gpio_in_remap_define}}
  HAL_TAMP_EnableRemap({{@root.gpio_in_remap_define}});
{{/if}}
{{#if (eq mode "Active")}}
{{assign 'gpio_out_resolved' (helper_tamp_get_gpio_need @root.pinoutAPI ../../../system.gpio tamper_output "out")~}}
#error "Missing TAMP output remap table for this STM32 series"
{{/if}}

{{/if}}{{!use_channel~}}
{{/each}}{{!tampers~}}

{{#each internal_tampers}}
{{#if use_channel}}
  p_internal_tamper_config.erase_secrets = HAL_TAMP_INTERNAL_SECRETS_{{erase}};
  if (HAL_TAMP_INTERNAL_SetConfigTampers({{#if int_tamper_label_name}}{{int_tamper_label_name}}{{else}}HAL_TAMP_{{_foreignKey}}{{/if}}, &p_internal_tamper_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}{{!use_channel~}}
{{/each}}{{!internal_tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#with additional}}
{{#if boot_hw_key_lock}}
  if (HAL_TAMP_LockBHK() != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}{{!boot_hw_key_lock~}}
{{#with backup_register_protection}}
{{#if (or (not (eq backup_registers_protection_zone1 0)) (not (eq backup_registers_protection_zone2 0)))}}
  if (HAL_TAMP_SetBackupRegisterZones({{backup_registers_protection_zone1}}, {{backup_registers_protection_zone2}}) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{/if}}{{!backup_registers_protection_zone1 ~}}
{{/with}}{{!backup_register_protection~}}

{{#if (not (helper_tamp_default_resources resource))}}
{{#if (helper_tamp_is_resource_enabled resource)}}
  /* Resources: {{helper_tamp_format_resource_names resource}} */
  if (HAL_TAMP_EnableResourceProtection({{helper_tamp_format_resources resource "HAL_TAMP_RESOURCE"}}) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }

{{/if}}{{!helper_tamp_is_resource_enabled~}}
{{#if (helper_tamp_is_resource_disabled resource "_31")}}
  /* Resources: Backup registers */
  if (HAL_TAMP_DisableResourceProtection(HAL_TAMP_RESOURCE_31) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{/if}}{{!helper_tamp_is_resource_disabled~}}
{{/if}}{{!not helper_tamp_default_resources~}}
{{/with}}{{!additional~}}

{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for TAMP */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}

  return SYSTEM_OK;
}

void {{@root.fct_name}}_deinit(void)
{
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Disable the interuption for TAMP */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
}

{{#with security_privilege}}
  {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
   * Full access security path:
   * Configure TAMP resources security/privilege attributes
   */

 {{> PWR_HAL fct='generate_write_protection_disable'}}

 {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
 {{/RCC}}

{{#with security}}
{{assign "access_levels_all_states" (helper_tamp_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure security attributes for TAMP peripheral */
  if (HAL_TAMP_SetSecAttr(HAL_TAMP_SEC_ITEM_TAMP | HAL_TAMP_SEC_ITEM_CNT1, HAL_TAMP_SEC) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{else}}
{{assign "security_items" (helper_tamp_get_attribute_items @root.current_layer 'SEC' access_levels)}}
{{#unless (eq security_items '')}}
  /* Configure security attributes for TAMP peripheral */
  if (HAL_TAMP_SetSecAttr({{@root.security_items}}, HAL_TAMP_SEC) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{else}}
{{log "No specific security attributes require configuration for this TAMP instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No security attributes (all) require configuration for this TAMP instance."}}
{{/unless}}
{{/with}}

{{#with privilege}}
{{assign "access_levels_all_states" (helper_tamp_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure privilege attributes for TAMP peripheral */
  if (HAL_TAMP_SetPrivAttr(HAL_TAMP_PRIV_ITEM_TAMP | HAL_TAMP_PRIV_ITEM_BACKUP_ZONE_1 | HAL_TAMP_PRIV_ITEM_BACKUP_ZONE_2 | HAL_TAMP_PRIV_ITEM_CNT1, HAL_TAMP_PRIV) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{else}}
{{assign "privilege_items" (helper_tamp_get_attribute_items @root.current_layer 'PRIV' access_levels)}}
{{#unless (eq privilege_items '')}}
  /* Configure privilege attributes for TAMP peripheral */
  if (HAL_TAMP_SetPrivAttr({{@root.privilege_items}}, HAL_TAMP_PRIV) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
{{else}}
{{log "No specific privilege attributes require configuration for this TAMP instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No privilege attributes (all) require configuration for this TAMP instance."}}
{{/unless}}
{{/with}}

{{#> GPIO_HAL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_HAL}}

{{#if illegal_access}}
  /* Enable HSEM IAC interrupt */
  HAL_RIF_IAC_EnableIT(HAL_RIF_IAC_TAMP);
{{/if}}

  return SYSTEM_OK;
}
{{/with}}

{{else}}
{{!
 Default case which should not occur
~}}
#warning "Function {{fct}} not present in partial TAMP_partial.hbs"
{{/if}}
