{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'TIM' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "TIM template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{assign 'dma_resource' @root.codegen_ctxt.dma_resource~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.current_resource}}_H
#define MX_{{@root.current_resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{assign "_define_" "#define"~}}
{{assign 'include_mx_def' false~}}
{{#each @root.instances~}}
  {{~assign 'tim_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.tim_cxt.info.layer~}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{~assign 'only_ll' false~}}
  {{/if}}
  {{#with @root.tim_cxt.security_privilege}}
    {{#unless @root.include_mx_def}}
      {{~assign 'include_mx_def' true~}}
#include "mx_def.h"
    {{/unless}}
  {{/with}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{~assign 'tim_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.tim_cxt.info.layer}}
  {{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
  {{/if}}

  {{#with @root.tim_cxt}}
    {{~assign 'desc_labels' 0~}}
    {{#each channels as |channel|}}
      {{#with output_configuration}}
        {{#with ocx_channel_configuration}}
          {{#each labels}}
            {{#if (length this)}}
              {{#if (eq @root.desc_labels 0)}}
                {{~assign 'desc_labels' 1~}}
/* Aliases of channels labels */
              {{/if}}
              {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL  HAL_TIM_CHANNEL_{{helper_tim_convert_channel channel._foreignKey}}
              {{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL  LL_TIM_CHANNEL_CH{{helper_tim_convert_channel channel._foreignKey}}
              {{/if}}
            {{/if}}
          {{/each}}
        {{/with}}
        {{#with ocxn_channel_configuration}}
          {{#each labels}}
            {{#if (length this)}}
              {{#if (eq @root.desc_labels 0)}}
                {{~assign 'desc_labels' 1~}}
/* Aliases of channels labels */
              {{/if}}
              {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL  HAL_TIM_CHANNEL_{{helper_tim_convert_channel channel._foreignKey}}N
              {{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL  LL_TIM_CHANNEL_CH{{helper_tim_convert_channel channel._foreignKey}}N
              {{/if}}
            {{/if}}
          {{/each}}
        {{/with}}
      {{/with}}
      {{#with input_configuration}}
        {{#with icx_channel_configuration}}
          {{#each labels}}
            {{#if (length this)}}
            {{#if (eq @root.desc_labels 0)}}
            {{~assign 'desc_labels' 1~}}
/* Aliases of channels labels */
            {{/if}}
            {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_CHANNEL  HAL_TIM_CHANNEL_{{helper_tim_convert_channel channel._foreignKey}}
            {{else}}
{{@root._define_}} {{uppercase this}}_CHANNEL  LL_TIM_CHANNEL_CH{{helper_tim_convert_channel channel._foreignKey}}
            {{/if}}
            {{/if}}
          {{/each}}
        {{/with}}
      {{/with}}

    {{/each}}
    {{~assign 'desc_labels' 0~}}
    {{#each additional.output_stage.break_configuration.breaks as |break_line|}}

      {{#each labels}}
        {{#if (length this)}}
          {{#if (eq @root.desc_labels 0)}}
          {{~assign 'desc_labels' 1~}}
/* Aliases of break line labels */
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{uppercase this}}_BREAK  HAL_TIM_BREAK_INPUT_{{break_line._foreignKey}}
          {{else}}
{{@root._define_}} {{uppercase this}}_BREAK  LL_TIM_BREAK_INPUT_{{break_line._foreignKey}}
          {{/if}}
        {{/if}}
      {{/each}}
    {{/each}}

{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
  {{/with}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
  {{~assign 'tim_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.tim_cxt.info.layer~}}
  {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}

/******************************************************************************/
/* Exported functions for TIM in {{@root.current_layer}} layer */
/******************************************************************************/
{{#with @root.tim_cxt}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index undefined 'tim_h_exp_proto')~}}
{{assign 'current_index' (add @root.current_index 1)~}}
/**
  * @brief  {{@root.fct_name}} init function.
  *         This function configures the hardware resources used in this example.
  * @retval Pointer to handle
  * @retval NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_tim_handle_t *{{@root.fct_name}}_init(void);
{{else}}
TIM_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{@root.fct_name}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#with security_privilege}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
{{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
{{/if}}

{{/with}}{{!security_privilege~}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined undefined 'tim_h_exp_handle')~}}
/**
  * @brief  Get the {{@root.fct_name}} object.
  * @return Pointer on the {{@root.fct_name}} Handle
  */
hal_tim_handle_t *{{@root.fct_name}}_gethandle(void);

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}

{{/if}}{{!current_layer HAL~}}
{{#if (eq @root.current_layer 'LL')}}

{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='prototype'}}
{{/if}}
{{/with}}{{!tim_cxt~}}
{{/each}}{{!instances~}}

{{> CORTEX fct='generate_irqhandler' type='definition' component='TIM'}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.current_resource}}_H */
{{/helper_common_beautifier}}
