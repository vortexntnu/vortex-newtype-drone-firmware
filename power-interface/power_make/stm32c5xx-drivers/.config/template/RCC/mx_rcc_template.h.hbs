{{#helper_common_beautifier}}
{{~assign 'current_resource' 'RCC'~}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'RCC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "RCC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'rcc_ctx' @root.codegen_ctxt.instances.[0].config~}}
{{~helper_rcc_init_codegen @root}}
{{~assign 'current_layer' @root.rcc_ctx.info.layer ~}}
{{~assign 'all_resources' (helper_rcc_get_all_resources) ~}}
{{~assign 'all_ppp_clock_configs' (helper_rcc_get_all_perifs_clock_config @root.all_resources) ~}}
