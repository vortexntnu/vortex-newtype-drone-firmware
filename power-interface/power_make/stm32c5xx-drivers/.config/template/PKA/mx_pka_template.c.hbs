{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_pka_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_PKA_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}1) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='PKA'}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource= 'PKA'}}
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for PKA */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.nvic.enable_interruption}}
  /* Disable the interruption for PKA */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}

{{/if}}
{{#if (eq @root.rcc_cxt.Clock_Tree.Peripher_clocks_init 1)}}
  (void)rcc_{{lowercase @root.current_resource}}_clock_deactivate();

{{/if}}
  (void)HAL_PKA_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
}

{{else}}
{{assign 'nvic_generate_handler' false~}}
{{!
    Generation of initialization function used in LL
~}}
PKA_TypeDef *{{@root.fct_name}}_init(void)
{
{{#> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='PKA'}}
{{/RCC}}
{{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{/RCC}}

{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for PKA */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{#if system.nvic.enable_interruption}}
  /* Disable the interruption for PKA */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}
}
{{/if}}
