{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'ADC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "ADC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{assign 'dma_resource' @root.codegen_ctxt.dma_resource~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'~}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{#each @root.instances~}}
  {{~assign 'adc_cxt' config~}}
  {{~log "ADC template adc_cxt:" (toJSON @root.adc_cxt)~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.adc_cxt.info.layer~}}
  {{~log "ADC template current_resource:" @root.current_resource~}}
  {{#if (eq @root.current_layer 'HAL')}}
static hal_adc_handle_t h{{@root.current_resource}};
{{> DMA_HAL fct='get_dma_handles' resource=@root.dma_resource strategy=@root.codegen_ctxt.strategy}}
  {{else}}
{{> DMA_LL fct='get_dma_lli_variables' resource=@root.dma_resource strategy=@root.codegen_ctxt.strategy}}
  {{/if}}
{{/each}}

{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{assign 'nvic_context' 'undefined'~}}
{{assign 'nvic_generate_handler' true~}}
{{#each @root.instances}}
  {{~assign 'adc_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'name' @root.adc_cxt.name~}}
  {{~assign 'current_layer' @root.adc_cxt.info.layer~}}
  {{~assign 'sbs_input_pin_remap' (eq (get 'peripheral.hardwareIpDescription.SBS.features.input_pin_remap') true)~}}
  {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{~log "ADC template instance:" (toJSON this)~}}
{{! Initialize the context for LL code optimization ~}}
{{assign 'lut_table'   (helper_adc_get_lut_table 'ADCV1')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#with @root.adc_cxt}}
{{#if (eq @root.current_layer 'HAL')}}
hal_adc_handle_t *{{@root.fct_name}}_init(void)
{

  if (HAL_ADC_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{assign 'adc_clock_activation_mode' (helper_common_if_rcc_clock_activated @root.core_ctxt.[0] @root.component)~}}
{{#if (not (eq @root.adc_clock_activation_mode 2))}}
{{> PWR_HAL fct='generate_peripheral_supply_activation' hw_resource=@root.current_resource ~}}
{{/if}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='ADC'}}

{{> ADC_HAL fct='init'}}

{{#with system}}
{{!==================== GPIO ====================}}
{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL'}}
{{assign 'did_sbs_remap_hal' false}}
  {{#if @root.sbs_input_pin_remap}}
{{assign 'adc_gpio_configs' (helper_gpio_get_allocated_resource_needs @root.pinoutAPI @root.current_resource)}}
{{!-- Configure SBS remap only for present pins (PB1, PB0, PC5, PC4) --}}
{{assign 'sbs_flags' ''}}
{{assign 'has_sbs' false}}
{{assign 'not_first_flag' false}}
{{assign 'remap_pc4' false}}
{{assign 'remap_pc5' false}}
{{assign 'remap_pb0' false}}
{{assign 'remap_pb1' false}}
    {{#each @root.adc_gpio_configs.list_config_pins}}
      {{#if (eq port 'C')}}
        {{#each pin}}
          {{#if (or (eq this 5) (eq this '5'))}}
            {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
            {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'HAL_SBS_REMAP_ADC_IN5_TO_PC5')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pc5' true}}
          {{/if}}
          {{#if (or (eq this 4) (eq this '4'))}}
            {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
            {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'HAL_SBS_REMAP_ADC_IN2_TO_PC4')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pc4' true}}
          {{/if}}
        {{/each}}
      {{/if}}
      {{#if (eq port 'B')}}
        {{#each pin}}
          {{#if (or (eq this 1) (eq this '1'))}}
            {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
            {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'HAL_SBS_REMAP_ADC_IN7_TO_PB1')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pb1' true}}
          {{/if}}
          {{#if (or (eq this 0) (eq this '0'))}}
            {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
            {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'HAL_SBS_REMAP_ADC_IN6_TO_PB0')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pb0' true}}
          {{/if}}
        {{/each}}
      {{/if}}
    {{/each}}
    {{#if @root.remap_pc4}}
      {{#if @root.remap_pc5}}
        {{#if @root.remap_pb0}}
          {{#if @root.remap_pb1}}
        {{assign 'sbs_flags' 'HAL_SBS_REMAP_ADC_IN_ALL'}}
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
    {{#if @root.has_sbs}}
  /* Enable channel pin remap */
  HAL_SBS_EnableADCChannelPinRemap({{@root.sbs_flags}});
    {{assign 'did_sbs_remap_hal' true}}
    {{/if}}
  {{/if}}
{{!==================== NVIC for ADC ====================}}
{{#with nvic}}
{{#if enable_interruption}}
  {{assign 'found_adc_interrupt' true~}}
  /* Enable the interruption for ADC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}{{! enable_interruption~}}
{{/with}}{{! nvic ~}}
{{!==================== DMA ====================}}
{{#with dma}}
{{#if dma_enable}}
  /* Configure DMA */
{{> DMA_HAL fct='init' needs=dma_config.needs}}
  /* Link DMA handle to ADC handle */
  HAL_ADC_REG_SetDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}});

{{/if}}
{{/with}}{{! dma ~}}
{{/with}}{{! system}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> ADC_HAL fct='deinit'}}

{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}

{{#with system}}
  {{#if @root.sbs_input_pin_remap}}
    {{#if @root.did_sbs_remap_hal}}
  /* Disable all ADC channel pin remaps */
  HAL_SBS_DisableADCChannelPinRemap(HAL_SBS_REMAP_ADC_IN_ALL);
    {{/if}}
  {{/if}}
{{!==================== NVIC for ADC ====================}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Disable the interruption for ADC */
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/with}}{{! nvic ~}}
{{!==================== GPIO ====================}}
{{#with gpio}}
{{#> GPIO_HAL fct='deinit_resource' resource=@root.current_resource}}
{{/GPIO_HAL}}
{{/with}}
{{!==================== DMA ====================}}
{{#with dma}}
{{#if dma_enable}}
{{> DMA_HAL fct='deinit' needs=dma_config.needs}}
{{/if}}
{{/with}}{{! dma ~}}
{{/with}}{{! system ~}}
}
{{else}}{{! eq @root.current_layer 'LL' ~}}
ADC_TypeDef *{{@root.fct_name}}_init(void)
{
{{> PWR_LL fct='generate_peripheral_supply_activation' hw_resource=@root.current_resource ~}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='ADC'}}

{{> ADC_LL fct='init'}}

{{#with system}}
{{!==================== GPIO ====================}}
{{> GPIO_LL fct='init_resource' resource=@root.current_resource}}
{{assign 'did_sbs_remap_ll' false}}
  {{#if @root.sbs_input_pin_remap}}
{{assign 'adc_gpio_configs' (helper_gpio_get_allocated_resource_needs @root.pinoutAPI @root.current_resource)}}
{{!-- Configure SBS remap only for present pins (PB1, PB0, PC5, PC4) --}}
{{assign 'sbs_flags' ''}}
{{assign 'has_sbs' false}}
{{assign 'not_first_flag' false}}
{{assign 'remap_pc4' false}}
{{assign 'remap_pc5' false}}
{{assign 'remap_pb0' false}}
{{assign 'remap_pb1' false}}
{{#each @root.adc_gpio_configs.list_config_pins}}
  {{#if (eq port 'C')}}
    {{#each pin}}
      {{#if (or (eq this 5) (eq this '5'))}}
        {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
        {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'LL_SBS_REMAP_ADC_IN5_TO_PC5')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pc5' true}}
      {{/if}}
      {{#if (or (eq this 4) (eq this '4'))}}
        {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
        {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'LL_SBS_REMAP_ADC_IN2_TO_PC4')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pc4' true}}
      {{/if}}
    {{/each}}
  {{/if}}
  {{#if (eq port 'B')}}
    {{#each pin}}
      {{#if (or (eq this 1) (eq this '1'))}}
        {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
        {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'LL_SBS_REMAP_ADC_IN7_TO_PB1')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pb1' true}}
      {{/if}}
      {{#if (or (eq this 0) (eq this '0'))}}
        {{#if @root.not_first_flag}}
          {{assign 'sbs_flags' (concat @root.sbs_flags ' | ')}}
        {{/if}}
        {{assign 'sbs_flags' (concat @root.sbs_flags 'LL_SBS_REMAP_ADC_IN6_TO_PB0')}}
        {{assign 'not_first_flag' true}}
        {{assign 'has_sbs' true}}
        {{assign 'remap_pb0' true}}
      {{/if}}
    {{/each}}
  {{/if}}
{{/each}}
{{#if @root.remap_pc4}}
  {{#if @root.remap_pc5}}
    {{#if @root.remap_pb0}}
      {{#if @root.remap_pb1}}
        {{assign 'sbs_flags' 'LL_SBS_REMAP_ADC_IN_ALL'}}
      {{/if}}
    {{/if}}
  {{/if}}
{{/if}}
{{#if @root.has_sbs}}
  /* Enable channel pin remap */
  LL_SBS_EnableADCChannelPinRemap({{@root.sbs_flags}});
  {{assign 'did_sbs_remap_ll' true}}
{{/if}}
{{/if}}
{{!==================== NVIC for ADC ====================}}
{{#with nvic}}
{{#if enable_interruption}}
  {{assign 'found_adc_interrupt' true~}}
  /* Enable the interruption for ADC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial LL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/with}}{{! nvic ~}}
{{!==================== DMA ====================}}
{{#with dma}}
{{#if dma_enable}}
  /* Configure DMA */
{{> DMA_LL fct='init' needs=dma_config.needs}}

{{/if}}
{{log '========== dma_enable: 'dma_enable~}}
{{log '========== dma_config: 'dma_config~}}
{{/with}}{{! dma ~}}
{{/with}}{{! system ~}}

  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> ADC_LL fct='deinit'}}

{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}

{{#with system}}
  {{#if @root.sbs_input_pin_remap}}
  {{#if @root.did_sbs_remap_ll}}
  /* Disable all ADC channel pin remaps */
  LL_SBS_DisableADCChannelPinRemap(LL_SBS_REMAP_ADC_IN_ALL);
  {{/if}}
  {{/if}}
{{!==================== NVIC for ADC ====================}}
{{#with nvic}}
{{#if enable_interruption}}
{{assign 'found_adc_interrupt' true~}}
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=nvic_config.needs}}
#warning "Partial LL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/with}}{{! nvic ~}}
{{!==================== GPIO ====================}}
{{#with gpio}}
{{#unless (eq @root.gpio_needs 'undefined')}}
{{#> GPIO_LL fct='deinit_resource' resource=@root.current_resource}}
{{/GPIO_LL}}
{{/unless}}
{{/with}}{{! gpio ~}}
{{!==================== DMA ====================}}
{{#with dma}}
{{#if dma_enable}}
  /* Configure DMA */
{{> DMA_LL fct='deinit' needs=dma_config.needs}}

{{/if}}
{{/with}}{{! dma ~}}
{{/with}}{{! system ~}}
}

{{/if}}{{! eq @root.current_layer 'HAL'}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_adc_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}

{{/if}}
{{#with security_privilege}}
  {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
    Full access security path:
    - Enable clock for RIF/RCC peripherals
    - Configure the security/privilege items for ADC peripheral
    - other ADC systems security/privilege configuration if any (DMA/GPIO/EXTI)
    */

{{> RCC fct='generate_kernel_clock' hw_resource='RIF or GTZC'}}

{{#> RIF fct='rif_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/RIF}}
{{#> GTZC fct='gtzc_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/GTZC}}

  {{#if (eq @root.current_layer 'HAL')}}
{{#> DMA_HAL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_HAL}}
{{#> GPIO_HAL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_HAL}}
  {{else}}
{{#> DMA_LL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_LL}}
{{#> GPIO_LL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_LL}}
  {{/if}}

  return SYSTEM_OK;
}

{{/with}}

{{#if (eq @root.current_layer 'LL')}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.codegen_ctxt.strategy type='implementation'}}
{{/if}}

{{/with}}
{{/each}}
{{> CORTEX fct='generate_irqhandler' type='implementation' component='ADC'}}
{{/helper_common_beautifier}}
