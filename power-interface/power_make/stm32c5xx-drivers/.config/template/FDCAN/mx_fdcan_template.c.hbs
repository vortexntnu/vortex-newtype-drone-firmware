{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource=@root.current_resource}}
{{#with basic}}

  /* FDCAN configuration */

{{#if (or (eq timings.clock_route 'BYPASS') (eq @root.hw_version 'c7amba_fdcan2'))}}
  /* FDCAN clock Divider                      = {{timings.clock_divider}} */
  /* FDCAN clock frequency after prescaler    = {{timings.fdcan_clk}} */

  /* Nominal bitrate                          = {{timings.bit_timing.nominal_bit_timing.nominal_bitrate}} */
  /* Nominal time quanta                      = {{timings.bit_timing.nominal_bit_timing.nominal_time_quantum}} */
{{else}}
  /* FDCAN clock frequency routed to the CCU  = {{fdcan_kernel_clock}} */

{{/if}}
  /* Nominal sample point                     = {{timings.bit_timing.nominal_bit_timing.nominal_sample_point}} */

  hal_fdcan_nominal_bit_timing_t fdcan_nominal_bit_timing;
  fdcan_nominal_bit_timing.nominal_prescaler  = {{timings.bit_timing.nominal_bit_timing.nominal_prescaler}};
  fdcan_nominal_bit_timing.nominal_time_seg1  = {{timings.bit_timing.nominal_bit_timing.nominal_time_seg1}};
  fdcan_nominal_bit_timing.nominal_time_seg2  = {{timings.bit_timing.nominal_bit_timing.nominal_time_seg2}};
  fdcan_nominal_bit_timing.nominal_jump_width = {{timings.bit_timing.nominal_bit_timing.nominal_jump_width}};

{{#if (eq frame_format "FD_BRS")}}
{{#if (or (eq timings.clock_route 'BYPASS') (eq @root.hw_version 'c7amba_fdcan2'))}}
  /* Data bitrate                             = {{timings.bit_timing.data_bit_timing.data_bitrate}} */
  /* Data time quanta                         = {{timings.bit_timing.data_bit_timing.data_time_quantum}} */
{{/if}}
  /* Data sample point                        = {{timings.bit_timing.data_bit_timing.data_sample_point}} */

  hal_fdcan_data_bit_timing_t fdcan_data_bit_timing;
  fdcan_data_bit_timing.data_prescaler        = {{timings.bit_timing.data_bit_timing.data_prescaler}};
  fdcan_data_bit_timing.data_time_seg1        = {{timings.bit_timing.data_bit_timing.data_time_seg1}};
  fdcan_data_bit_timing.data_time_seg2        = {{timings.bit_timing.data_bit_timing.data_time_seg2}};
  fdcan_data_bit_timing.data_jump_width       = {{timings.bit_timing.data_bit_timing.data_jump_width}};

{{else}}

  /* Data bit timing parameters are not used in Classic CAN or non-BRS modes */
  /* hal_fdcan_data_bit_timing_t fdcan_data_bit_timing;                      */
  /* fdcan_data_bit_timing.data_prescaler     = 1U;                          */
  /* fdcan_data_bit_timing.data_time_seg1     = 1U;                          */
  /* fdcan_data_bit_timing.data_time_seg2     = 1U;                          */
  /* fdcan_data_bit_timing.data_jump_width    = 1U;                          */
{{/if}}

  fdcan_config.nominal_bit_timing   = fdcan_nominal_bit_timing;
{{#if (eq frame_format "FD_BRS")}}
  fdcan_config.data_bit_timing      = fdcan_data_bit_timing;
{{/if}}

