  /* filter_cfg.filter_type     = HAL_FDCAN_FILTER_TYPE_DUAL; Ignored when configured to Rx buffer */
{{else}}
  filter_cfg.filter_type     = HAL_FDCAN_FILTER_TYPE_{{filter_type}};
{{/if}}
  filter_cfg.filter_config   = HAL_FDCAN_FILTER_{{filter_config}};
  filter_cfg.filter_id1      = 0x{{#if filter_id1}}{{uppercase (dec2hex filter_id1)}}{{else}}00{{/if}};
{{#if (eq filter_config "TO_RX_BUFFER")}}
  /* filter_cfg.filter_id2      = 0x0U; Ignored when configured to Rx buffer                       */
  filter_cfg.rx_buffer_index = HAL_FDCAN_RX_BUFFER_{{rx_buffer_index}};
