  {
    return NULL;
  }

{{/each}}
{{!-- Enable interrupts if any --}}
{{#each @root.interrupts_to_lines.all_interrupts as |intr|}}
  {{#if intr.value}}
  /* Enable {{intr.commentLabel}} interrupts */
  if (HAL_FDCAN{{intr.ccuLabel}}_Enable{{intr.funcLabel}}Interrupts(&h{{@root.current_resource}}, {{intr.value}}) != HAL_OK)
  {
    return NULL;
  }

  {{/if}}
{{/each}}
{{#each @root.interrupts_to_lines.interrupts_by_line as |interrupts idx|}}
  {{#if interrupts}}
  /* Connect {{@root.interrupts_to_lines.interrupts_or_group.commentLabel}} to interrupt {{idx}} */
  if (HAL_FDCAN_Set{{@root.interrupts_to_lines.interrupts_or_group.funcLabel}}ToLine(&h{{@root.current_resource}},
                                         {{interrupts}},
                                         HAL_FDCAN_IT_{{uppercase idx}}) != HAL_OK)
  {
    return NULL;
  }

  {{/if}}
{{/each}}
{{!-- Enable interrupt lines --}}
{{#if (lookup @root.interrupts_to_lines "lines")}}
