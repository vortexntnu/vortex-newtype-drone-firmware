  fdcan_config.protocol_exception   = HAL_FDCAN_PROTOCOL_EXCEPTION_{{#if protocol_exception}}ENABLE{{else}}DISABLE{{/if}};
{{#with frame_filters}}
  fdcan_config.std_filters_nbr      = {{std_filters_nbr}}U;
  fdcan_config.ext_filters_nbr      = {{ext_filters_nbr}}U;
{{/with}}
  fdcan_config.tx_fifo_queue_mode   = HAL_FDCAN_TX_MODE_{{tx_fifo_queue_mode}};
{{#if (eq @root.hw_version 'c7amba_fdcan1')}}

  /** The following diagram illustrates the message RAM allocation for {{@root.current_resource}}:

{{#each message_ram_config.message_ram_start_offset}}
{{#if (eq _foreignKey @root.current_resource)}}
{{assign 'start_offset' start_offset~}}
{{/if}}
{{/each}}
    +--------------------------+ Start Address: FDCAN RAM Base + ({{@root.start_offset}} x 4 Bytes)
{{#if frame_filters.std_filters_nbr}}
    | 11-bit (Standard) filter | {{frame_filters.std_filters_nbr}} x 4 Bytes
    +--------------------------+
{{/if}}
{{#if frame_filters.ext_filters_nbr}}
    | 29-bit (Extended) filter | {{frame_filters.ext_filters_nbr}} x 8 Bytes
    +--------------------------+
{{/if}}
{{#if message_ram_config.rx_fifo_0.rx_fifo0_elem_nbr}}
    |        Rx FIFO 0         | {{message_ram_config.rx_fifo_0.rx_fifo0_elem_nbr}} x {{message_ram_config.rx_fifo_0.rx_fifo0_elem_size}} Bytes
    +--------------------------+
{{/if}}
{{#if message_ram_config.rx_fifo_1.rx_fifo1_elem_nbr}}
    |        Rx FIFO 1         | {{message_ram_config.rx_fifo_1.rx_fifo1_elem_nbr}} x {{message_ram_config.rx_fifo_1.rx_fifo1_elem_size}} Bytes
    +--------------------------+
{{/if}}
{{#if message_ram_config.rx_buffers.rx_buffer_nbr}}
    |        Rx buffer         | {{message_ram_config.rx_buffers.rx_buffer_nbr}} x {{message_ram_config.rx_buffers.rx_buffer_size}} Bytes
    +--------------------------+
{{/if}}
{{#if message_ram_config.tx_event.tx_event_nbr}}
    |      Tx event FIFO       | {{message_ram_config.tx_event.tx_event_nbr}} x 8 Bytes
    +--------------------------+
{{/if}}
{{#if (or message_ram_config.tx_fifo_queue.tx_buffer_nbr message_ram_config.tx_fifo_queue.tx_fifo_queue_elem_nbr)}}
    |        Tx buffers        | ({{message_ram_config.tx_fifo_queue.tx_buffer_nbr}} + {{message_ram_config.tx_fifo_queue.tx_fifo_queue_elem_nbr}}) x {{message_ram_config.tx_fifo_queue.tx_fifo_queue_elem_size}} Bytes
{{/if}}
    +--------------------------+
    <----------32 bits--------->
  */
{{#with message_ram_config}}
  fdcan_config.message_ram_offset      = {{@root.start_offset}}U;
  fdcan_config.rx_fifo0_elem_nbr       = {{rx_fifo_0.rx_fifo0_elem_nbr}}U;
  fdcan_config.rx_fifo0_elem_size      = HAL_FDCAN_DATA_{{rx_fifo_0.rx_fifo0_elem_size}}_BYTE;
  fdcan_config.rx_fifo1_elem_nbr       = {{rx_fifo_1.rx_fifo1_elem_nbr}}U;
  fdcan_config.rx_fifo1_elem_size      = HAL_FDCAN_DATA_{{rx_fifo_1.rx_fifo1_elem_size}}_BYTE;
  fdcan_config.rx_buffer_nbr           = {{rx_buffers.rx_buffer_nbr}}U;
  fdcan_config.rx_buffer_size          = HAL_FDCAN_DATA_{{rx_buffers.rx_buffer_size}}_BYTE;
  fdcan_config.tx_buffer_nbr           = {{tx_fifo_queue.tx_buffer_nbr}}U;
  fdcan_config.tx_fifo_queue_elem_nbr  = {{tx_fifo_queue.tx_fifo_queue_elem_nbr}}U;
  fdcan_config.tx_fifo_queue_elem_size = HAL_FDCAN_DATA_{{tx_fifo_queue.tx_fifo_queue_elem_size}}_BYTE;
  fdcan_config.tx_event_nbr            = {{tx_event.tx_event_nbr}}U;
{{/with}}
{{/if}} {{!c7amba_fdcan1}}
  {{assign 'found_FDCAN_SetConfig' true~}}

  if (HAL_FDCAN_SetConfig(&h{{@root.current_resource}}, &fdcan_config) != HAL_OK)
