{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' false~}}
{{#each @root.instances~}}
{{assign 'i2s_cxt' config~}}
{{log "I2S template i2s_cxt:" (toJSON @root.i2s_cxt)~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.i2s_cxt.info.layer~}}
{{log "I2S template current_resource:" @root.current_resource~}}
{{#if (eq @root.current_layer 'HAL')}}
{{#unless @root.hal_handle_exist}}
{{assign 'hal_handle_exist' 1~}}
static hal_i2s_handle_t h{{@root.current_resource}};
{{> GPIO_HAL fct='gpio_exti_get_variables' resource=@root.current_resource~}}
{{/unless}}
{{/if}}
{{/each}}
{{#if (eq @root.current_layer 'HAL')}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.dma_resource strategy=@root.strategy}}
{{else}}
{{> DMA_LL fct='get_dma_lli_variables' resource=@root.dma_resource strategy=@root.strategy}}
{{/if}}
{{assign 'nvic_context' 'undefined'~}}
{{assign 'nvic_generate_handler' true~}}

{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
{{assign 'i2s_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.i2s_cxt.info.layer~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{~! Initialize the context for LL code optimization ~}}
{{~assign 'lut_table'   (helper_spi_get_lut_table 'V1')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for I2S in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index 'i2s')~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#with @root.i2s_cxt}}
{{#if (eq @root.current_layer 'HAL')}}
hal_i2s_handle_t *{{@root.fct_name}}_init(void)
{
{{#with basic}}
{{#if (eq (helper_mode_master mode) 1)}}
  hal_i2s_master_config_t i2s_config;
{{else}}
  hal_i2s_slave_config_t i2s_config;
{{/if}}
{{/with}}

  if (HAL_I2S_Init(&h{{@root.current_resource}}, HAL_I2S{{removeFirst @root.current_resource 'SPI'}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource}}
{{assign 'found_i2s_rcc_kernel' true~}}

{{#with basic}}
  i2s_config.mode = HAL_I2S_MODE_{{mode}};
  i2s_config.standard = HAL_I2S_STANDARD_{{standard}};
  i2s_config.data_format = HAL_I2S_DATA_FORMAT_{{data_format}};
{{#if (eq (helper_mode_master mode) 1)}}
  i2s_config.audio_frequency = HAL_I2S_MASTER_AUDIO_FREQ_{{helper_format_frequency audio_frequency}}_KHZ;
{{/if}}
  i2s_config.clock_polarity = HAL_I2S_CLOCK_POLARITY_{{clock_polarity}};
  i2s_config.bit_order = HAL_I2S_{{bit_order}};

{{#if (eq (helper_mode_master mode) 1)}}
  if (HAL_I2S_MASTER_SetConfig(&h{{@root.current_resource}}, &i2s_config) != HAL_OK)
{{else}}
  if (HAL_I2S_SLAVE_SetConfig(&h{{@root.current_resource}}, &i2s_config) != HAL_OK)
{{/if}}
  {
    return NULL;
  }
{{#if (eq data_format "24_BIT")}}

  if (HAL_I2S_SetData24BitsAligned{{../additional.data_alignment}}(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{/with}}

{{#with additional}}
{{#if enable_mclk_output}}
  {{assign 'found_i2s_mclk_output_enable' true~}}
  HAL_I2S_MASTER_EnableClockOutput(&h{{@root.current_resource}});

{{/if}}
{{#if enable_ws_inversion}}
  {{assign 'found_i2s_ws_inversation_enable' true~}}
  HAL_I2S_EnableWSInversion(&h{{@root.current_resource}});

{{/if}}
{{#if enable_channel_detection_err}}
  {{assign 'found_i2s_channel_detection_err_enable' true~}}
  HAL_I2S_SLAVE_EnableLengthDetectionError(&h{{@root.current_resource}});

{{/if}}
{{#if (not (eq set_fifo_threshold "00"))}}
  {{assign 'found_i2s_fifo_threshold' true~}}
  if (HAL_I2S_SetFifoThreshold(&h{{@root.current_resource}}, HAL_I2S_FIFO_THRESHOLD_{{set_fifo_threshold}}_DATA) != HAL_OK)
  {
    return NULL;
  }

{{/if}}
{{#if i2s_io_configuration.enable_master_keep_io_state}}
  {{assign 'found_i2s_master_keep_io' true~}}
  if (HAL_I2S_MASTER_EnableKeepIOState(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! I2S_IO_configuration.EnableMasterKeepIOState~}}
{{#if i2s_io_configuration.enable_io_swap}}
  {{assign 'found_i2s_io_swap' true~}}
  if (HAL_I2S_EnableIOSwap(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! I2S_IO_configuration.EnableIOSwap~}}
{{#if i2s_io_configuration.lock_io_config}}
  {{assign 'found_i2s_io_lock' true~}}
  if (HAL_I2S_LockIOConfig(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! I2S_IO_configuration.LockIOConfig~}}
{{/with}}{{! additional~}}
{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL'~}}
{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
  /* Configure the DMA TX */
{{assign 'found_i2s_dma_tx' true~}}
{{> DMA_HAL fct='init' needs=dma_config_tx.needs}}

  /* Link the Transmit DMA handle to the I2S handle */
  if (HAL_I2S_SetTxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}
{{#if enable_dma_rx}}
  /* Configure the DMA RX */
{{assign 'found_i2s_dma_rx' true~}}
{{> DMA_HAL fct='init' needs=dma_config_rx.needs}}

  /* Link the Receive DMA handle to the I2S handle */
  if (HAL_I2S_SetRxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}
{{/with}} {{! dma~}}
{{/with}} {{! system~}}

{{#if system.nvic.enable_interrupt}}
  {{assign 'found_i2s_nvic' true~}}
  /* Enable the interrupt for I2S */
  {{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context system.nvic.nvic_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
  {{#> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
#warning "Partial CORTEX is not present"
  {{/CORTEX}}

{{/if}}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.nvic.enable_interrupt}}
  /* Disable the interrupt for I2S */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}

{{/if}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}
  (void)HAL_I2S_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{> GPIO_HAL fct='deinit_resource' resource=@root.current_resource~}}
{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_HAL fct='deinit' needs=dma_config_tx.needs~}}
{{/if}}
{{#if enable_dma_rx}}
{{> DMA_HAL fct='deinit' needs=dma_config_rx.needs~}}
{{/if}}
{{/with}} {{! dma~}}

{{/with}}
}

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined 'i2s')~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_i2s_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='implementation'}}
{{else}}
{{!
    Generation of initialization function used in LL
~}}

SPI_TypeDef *{{@root.fct_name}}_init(void)
{
  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource}}

{{#if system.nvic.enable_interrupt}}
  /* Enable the interrupt for I2S */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.nvic_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
{{/if~}}
{{~assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)~}}
{{~assign 'i2s_prescaler' (helper_i2s_getprescalers @root.clock_config_object.frequency basic.standard basic.data_format additional.enable_mclk_output basic.audio_frequency)~}}
{{#with basic}}
  LL_I2S_EnableI2SMode({{@root.current_resource}});
  {{helper_common_gen_ll_code 'LL_I2S_SetTransferMode' (concat 'LL_I2S_MODE_' mode)}}
  {{helper_common_gen_ll_code 'LL_I2S_SetStandard' (concat 'LL_I2S_STANDARD_' standard)}}
  {{helper_common_gen_ll_code 'LL_I2S_SetDataFormat' (concat 'LL_I2S_DATA_FORMAT_' data_format)}}
{{#if (eq data_format "24_BIT")}}
  {{helper_common_gen_ll_code (concat 'LL_I2S_SetDataAlignment' ../additional.data_alignment)}}
{{/if}}
  {{helper_common_gen_ll_code 'LL_I2S_SetClockPolarity' (concat 'LL_I2S_CLOCK_POLARITY_' clock_polarity)}}
  {{helper_common_gen_ll_code 'LL_I2S_SetTransferBitOrder' (concat 'LL_I2S_' bit_order)}}
{{#if (eq (helper_mode_master mode) 1)}}
  {{helper_common_gen_ll_code 'LL_I2S_SetPrescalerLinear' @root.i2s_prescaler.i2s_div}}
{{#if (eq @root.i2s_prescaler.i2s_odd 1)}}
  {{helper_common_gen_ll_code 'LL_I2S_SetPrescalerParity' 'LL_I2S_PRESCALER_PARITY_ODD'}}
{{else}}
  {{helper_common_gen_ll_code 'LL_I2S_SetPrescalerParity' 'LL_I2S_PRESCALER_PARITY_EVEN'}}
{{/if}}
{{/if}}
{{/with}}{{! basic~}}
{{#with additional~}}
{{#if enable_mclk_output~}}
  {{~assign 'found_i2s_mclk_output_enable' true}}
  LL_I2S_EnableMasterClock({{@root.current_resource}});
{{/if~}}
{{#if enable_ws_inversion~}}
  {{~assign 'found_i2s_ws_inversation_enable' true}}
  LL_I2S_EnableWordSelectInversion({{@root.current_resource}});

{{/if}}
{{#if enable_channel_detection_err~}}
  {{~assign 'found_i2s_channel_detection_err_enable' true}}
  LL_I2S_SLAVE_EnableLengthDetectionError({{@root.current_resource}});

{{/if~}}
{{#if (not (eq set_fifo_threshold "00"))~}}
  {{~assign 'found_i2s_fifo_threshold' true}}
  {{helper_common_gen_ll_code 'LL_I2S_SetFIFOThreshold' (concat 'LL_I2S_FIFO_THRESHOLD_' set_fifo_threshold '_DATA')}}

{{/if~}}
{{#if i2s_io_configuration.enable_master_keep_io_state~}}
  {{~assign 'found_i2s_master_keep_io' true}}
  LL_I2S_EnableGPIOControl({{@root.current_resource}});

{{/if}}{{! I2S_IO_configuration.EnableMasterKeepIOState~}}
{{#if i2s_io_configuration.enable_io_swap~}}
  {{~assign 'found_i2s_io_swap' true}}
  LL_I2S_EnableIOSwap({{@root.current_resource}});

{{/if}}{{! I2S_IO_configuration.EnableIOSwap~}}
{{#if i2s_io_configuration.lock_io_config~}}
  {{~assign 'found_i2s_io_lock' true}}
  LL_I2S_EnableIOLock({{@root.current_resource}});

{{/if}}{{! SPI_IO_configuration.LockIOConfig~}}
{{/with}}{{! additional~}}
{{> GPIO_LL fct='init_resource' resource=@root.current_resource~}}
{{#with system~}}
{{#with dma}}
{{#if enable_dma_tx}}
  /* Configure the DMA TX */
{{assign 'found_i2s_dma_tx' true~}}
{{> DMA_LL fct='init' needs=dma_config_tx.needs}}
{{/if}}
{{#if enable_dma_rx}}
  /* Configure the DMA RX */
{{assign 'found_i2s_dma_rx' true~}}
{{> DMA_LL fct='init' needs=dma_config_rx.needs}}
{{/if}}
{{/with}}{{! dma~}}
{{/with}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
  LL_I2S_Disable({{@root.current_resource}});

{{#if system.nvic.enable_interrupt}}
  /* Disable interrupt */
  {{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
{{> GPIO_LL fct='deinit_resource' resource=@root.current_resource~}}
{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='deinit' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='deinit' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}{{! dma~}}
{{/with}}{{! system~}}
}
{{/if}}
{{/with}}

{{#with @root.i2s_cxt.security_privilege}}
  {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
    Full access security path:
    - Enable clock for RIF/RCC peripherals
    - Configure the security/privilege items for I2S peripheral
    - other I2S systems security/privilege configuration if any (DMA/GPIO/EXTI)
    */

{{#> RIF fct='rif_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/RIF}}
{{#> GTZC fct='gtzc_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/GTZC}}

  {{#if (eq @root.current_layer 'HAL')~}}
{{#> DMA_HAL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_HAL}}
{{#> GPIO_HAL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_HAL}}
  {{else}}
{{#> DMA_LL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_LL}}
{{#> GPIO_LL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_LL}}
  {{/if}}

  return SYSTEM_OK;
}

{{/with}}

{{#if (eq @root.current_layer 'LL')}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='implementation'}}
{{/if}}

{{/each}}
{{> CORTEX fct='generate_irqhandler' type='implementation' component='I2S'}}
{{/helper_common_beautifier}}
