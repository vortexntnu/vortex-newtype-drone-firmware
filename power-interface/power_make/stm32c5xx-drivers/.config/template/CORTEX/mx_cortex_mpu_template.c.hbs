system_status_t mx_cortex_mpu_init(void)
{
  /* Disables the MPU */
  HAL_CORTEX_MPU_Disable();
      {{~#if basic.mpu_enabled}}
        {{~#with additional}}
          {{~assign 'found_region' false}}
          {{~assign 'usedAttr' (helper_cortex_mpu_get_used_attributes regions attributes)}}
          {{~#each @root.usedAttr}}
            {{~#unless @root.found_region}}
              {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU attributes
  */
            {{~/unless}}
            {{~#if (eq memory_type 'DEVICE')}}

  HAL_CORTEX_MPU_SetDeviceMemAttr(HAL_CORTEX_MPU_MEM_{{_foreignKey}}, HAL_CORTEX_MPU_DEVICE_MEM_{{device_attribute}});
            {{~else}}

  HAL_CORTEX_MPU_SetCacheMemAttr(HAL_CORTEX_MPU_MEM_{{_foreignKey}}, HAL_CORTEX_MPU_NORMAL_MEM_{{write_policy}}{{allocation_policy}});
            {{~/if}}
          {{~/each}}
          {{~assign 'found_region' false}}
          {{~#each regions}}
            {{~#if use_region}}
              {{~#unless @root.found_region}}
                {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU Region
  */
  hal_cortex_mpu_region_config_t p_region_config = {0};
              {{~/unless}}


  p_region_config.base_addr = 0x{{#if (eq base_address 0)}}00000000{{else}}{{uppercase (dec2hex base_address)}}{{/if}};
  p_region_config.limit_addr = 0x{{#if (eq limit_address 0)}}00000000{{else}}{{uppercase (dec2hex limit_address)}}{{/if}};
  p_region_config.access_attr = HAL_CORTEX_MPU_REGION_{{access_permission}};
  p_region_config.exec_attr = HAL_CORTEX_MPU_EXECUTION_ATTR_{{#if instruction_access}}ENABLE{{else}}DISABLE{{/if}};
  p_region_config.attr_idx = HAL_CORTEX_MPU_MEM_ATTR_{{attribute_number}};
  HAL_CORTEX_MPU_SetConfigRegion(HAL_CORTEX_MPU_{{_foreignKey}}, &p_region_config);

  HAL_CORTEX_MPU_EnableRegion(HAL_CORTEX_MPU_{{_foreignKey}});
            {{~/if}}
          {{~/each}}
        {{~/with}}{{! additional}}


  /* Enables the MPU */
  HAL_CORTEX_MPU_Enable(HAL_CORTEX_MPU_HARDFAULT_NMI_{{#if basic.during_hardfault}}ENABLE{{else}}DISABLE{{/if}}, HAL_CORTEX_MPU_ACCESS_FAULT_{{#if basic.default_map_enabled}}ONLY_PRIV{{else}}ALL{{/if}});
      {{~/if}}


  return SYSTEM_OK;
}

void mx_cortex_mpu_deinit(void)
{
  /* Disables the MPU and MPU regions*/
  HAL_CORTEX_MPU_Disable();

{{~assign 'attrs' (JSONparse '[{"idx": 0}, {"idx": 1}, {"idx": 2}, {"idx": 3},
                               {"idx": 4}, {"idx": 5}, {"idx": 6}, {"idx": 7}]')}}

{{~assign 'regs' (JSONparse '[{"idx": 0}, {"idx": 1}, {"idx": 2}, {"idx": 3},
                               {"idx": 4}, {"idx": 5}, {"idx": 6}, {"idx": 7}]')}}
{{#each @root.regs}}

  HAL_CORTEX_MPU_DisableRegion(HAL_CORTEX_MPU_REGION_{{idx}});
{{~/each}}

  /*
