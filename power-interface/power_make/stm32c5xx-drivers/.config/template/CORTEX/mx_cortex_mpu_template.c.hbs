system_status_t mx_cortex_mpu_init(void)
{
  /* Disables the MPU */
  ARM_MPU_Disable();
      {{~#if basic.mpu_enabled}}
        {{~#with additional}}
          {{~assign 'found_region' false}}
          {{~assign 'usedAttr' (helper_cortex_mpu_get_used_attributes regions attributes)}}
          {{~#each @root.usedAttr}}
            {{~#unless @root.found_region}}
              {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU attributes
  */
            {{~/unless}}
            {{~#if (eq memory_type 'DEVICE')}}

  ARM_MPU_SetMemAttr({{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}}, ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_DEVICE_MEM_' device_attribute)}} << 2U));
            {{~else}}

  ARM_MPU_SetMemAttr({{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}}, ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_NORMAL_MEM_' (concat write_policy allocation_policy))}} << 4U));
            {{~/if}}
          {{~/each}}
          {{~assign 'found_region' false}}
          {{~#each regions}}
            {{~#if use_region}}
              {{~#unless @root.found_region}}
                {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU Region
  */
              {{~/unless}}
              {{~#if instruction_access}}
                {{~assign 'instr_access_value' 'HAL_CORTEX_MPU_EXECUTION_ATTR_ENABLE'}}
              {{~else}}
                {{~assign 'instr_access_value' 'HAL_CORTEX_MPU_EXECUTION_ATTR_DISABLE'}}
              {{~/if}}


  ARM_MPU_SetRegion({{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}}, (0x{{#if (eq base_address 0)}}00000000{{else}}{{uppercase (dec2hex base_address)}}{{/if}}
                    | (ARM_MPU_AP_({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_REGION_' access_permission)}}) << MPU_RBAR_AP_Pos)
                    | ({{helper_cortex_mpu_get_arm_cmsis_value @root.instr_access_value}} << MPU_RBAR_XN_Pos)),
                    ((0x{{#if (eq limit_address 0)}}00000000{{else}}{{uppercase (dec2hex limit_address)}}{{/if}} & 0xFFFFFFE0U)
                    | ({{attribute_number}} << MPU_RLAR_AttrIndx_Pos)));


  STM32_WRITE_REG(MPU->RNR, {{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}});
  STM32_SET_BIT(MPU->RLAR, MPU_RLAR_EN_Msk);
            {{~/if}}
          {{~/each}}
        {{~/with}}{{! additional}}


  /* Enables the MPU */
        {{~#if basic.during_hardfault}}
          {{~assign 'mpu_hardfault' "HAL_CORTEX_MPU_HARDFAULT_NMI_ENABLE"}}
        {{~else}}
          {{~assign 'mpu_hardfault' "HAL_CORTEX_MPU_HARDFAULT_NMI_DISABLE"}}
        {{~/if}}
        {{~#if basic.default_map_enabled}}
          {{~assign 'default_map' "HAL_CORTEX_MPU_ACCESS_FAULT_ONLY_PRIV"}}
        {{~else}}
          {{~assign 'default_map' "HAL_CORTEX_MPU_ACCESS_FAULT_ALL"}}
        {{~/if}}

  ARM_MPU_Enable({{helper_cortex_mpu_get_arm_cmsis_value @root.mpu_hardfault}} | {{helper_cortex_mpu_get_arm_cmsis_value @root.default_map}});
      {{~/if}}


  return SYSTEM_OK;
}

void mx_cortex_mpu_deinit(void)
{
  /* Disables the MPU */
  ARM_MPU_Disable();
{{~assign 'attrs' (JSONparse '[{"idx": 0}, {"idx": 1}, {"idx": 2}, {"idx": 3},
                               {"idx": 4}, {"idx": 5}, {"idx": 6}, {"idx": 7}]')}}

{{~assign 'regs' (JSONparse '[{"idx": 0}, {"idx": 1}, {"idx": 2}, {"idx": 3},
                               {"idx": 4}, {"idx": 5}, {"idx": 6}, {"idx": 7}]')}}
{{#each @root.regs}}

  STM32_WRITE_REG(MPU->RNR, {{idx}});
  STM32_CLEAR_BIT(MPU->RLAR, MPU_RLAR_EN_Msk);
{{~/each}}


  /*
     Deinitializes and configures the MPU attributes to default
  */
{{~#each @root.attrs}}

  ARM_MPU_SetMemAttr({{helper_cortex_mpu_get_arm_cmsis_value (concat 'ATTR_' idx)}}, ARM_MPU_ATTR_DEVICE_nGnRnE << 2U);
{{~/each}}


  /*
     Deinitializes and configures the MPU Region to default
  */
{{~#each @root.regs}}

  ARM_MPU_SetRegion({{idx}}, (0x00000000
                    | ((ARM_MPU_AP_RW | ARM_MPU_AP_PO) << MPU_RBAR_AP_Pos)
                    | (0x00 << MPU_RBAR_XN_Pos)),
                    ((0x00000000 & 0xFFFFFFE0U)
                    | (0 << MPU_RLAR_AttrIndx_Pos)));
{{~/each}}

}
    {{~/if}}
  {{~/with}}
{{/each}}
