  p_region_config.attr_idx = HAL_CORTEX_MPU_MEM_ATTR_0;
{{#each @root.regs}}

  HAL_CORTEX_MPU_SetConfigRegion(HAL_CORTEX_MPU_REGION_{{idx}}, &p_region_config);
{{~/each}}

}
