  */
{{~#each @root.attrs}}

  HAL_CORTEX_MPU_SetDeviceMemAttr(HAL_CORTEX_MPU_MEM_ATTR_{{idx}}, HAL_CORTEX_MPU_DEVICE_MEM_NGNRNE);
{{~/each}}


  /*
