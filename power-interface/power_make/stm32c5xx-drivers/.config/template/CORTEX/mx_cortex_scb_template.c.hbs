{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'CORTEX_SCB' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "CORTEX_SCB template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{uppercase @root.current_resource}} Peripheral initialization
{{> LICENSE}}


/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{#each @root.instances~}}
  {{~assign 'cortex_scb_cxt' config~}}
    {{~log "CORTEX SCB template cortex_scb_cxt:" (toJSON @root.cortex_scb_cxt)~}}
    {{~assign 'current_resource' current_resource~}}
    {{~assign 'current_layer' @root.cortex_scb_cxt.info.layer~}}
    {{~log "CORTEX SCB template current_resource:" @root.current_resource~}}
{{/each}}
{{helper_common_initialize_index~}}
{{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{~assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
  {{~assign 'cortex_scb_cxt' config~}}
    {{~assign 'current_resource' current_resource~}}
    {{~assign 'current_layer' @root.cortex_scb_cxt.info.layer~}}
    {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{! Initialize the context for LL code optimization ~}}
  {{!~assign 'lut_table' (helper_cortex_scb_get_lut_table 'CORTEX SCBV1')~}}
  {{!~helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
  {{~log "CORTEX SCB template instance:" (toJSON this)}}

/******************************************************************************/
/* Exported functions for {{uppercase @root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
  {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
  {{~assign 'current_index' (helper_common_inc_index @root.current_resource)}}
  {{#with @root.cortex_scb_cxt}}
system_status_t mx_cortex_scb_init(void)
{
    {{~#if (@root.peripheralsResourceManagerAPI.getSoftwareInstancesBoundToPeripheral "MPU")}}
      {{~assign 'is_mpu_enabled' true~}}
    {{~else}}
      {{~assign 'is_mpu_enabled' false~}}
    {{~/if}}
    {{~assign 'enable_fault' (helper_cortex_scb_get_enable_fault basic.fault_management @root.current_layer @root.is_mpu_enabled)}}
    {{#if @root.is_mpu_enabled}}
      {{#if basic.fault_management.enable_mem_management_fault}}

  /* MemManagement fault is enabled by MPU */
      {{~else}}

  /* MemManagement fault is enabled by MPU, need disable */
        {{~#if (eq @root.current_layer 'HAL')}}

  HAL_CORTEX_SCB_EnableHardFaultEscalation(HAL_CORTEX_SCB_MEM_MANAGEMENT_FAULT);
        {{~else}}

  SCB_DisableFault(SCB_SHCSR_MEMFAULTENA_Msk);
        {{~/if}}{{! layer = 'HAL'}}
      {{~/if}}{{! enable_mem_management_fault}}
    {{~/if}}{{! is_mpu_enabled}}
    {{#if (not (eq @root.enable_fault "NONE"))}}
      {{~#if (eq @root.current_layer 'HAL')}}
  HAL_CORTEX_SCB_DisableHardFaultEscalation({{@root.enable_fault}});
      {{~else}}
  SCB_EnableFault({{@root.enable_fault}});
      {{~/if}}
    {{~else}}
      {{~#if (not @root.is_mpu_enabled)}}
  /* No fault to enable - No hardfault escalation to disable */
      {{~/if}}
    {{/if}}{{! enable_fault != "NONE" }}

{{> CORTEX fct='cortex_system_lines' system_line='SCB'}}
    {{~#with system.nvic}}
      {{#if irq_config1.needs}}
        {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource false)}}
      {{~/if}}
      {{#if irq_config2.needs}}
        {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config2.needs @root.current_resource false)}}
      {{~/if}}
      {{#if irq_config3.needs}}
        {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config3.needs @root.current_resource false)}}
      {{~/if}}
    {{~/with}}{{! system.nvic}}

  return SYSTEM_OK;
}

void mx_cortex_scb_deinit(void)
{
    {{~assign 'enable_fault' (helper_cortex_scb_get_enable_fault basic.fault_management @root.current_layer false)}}
    {{#if (not (eq @root.enable_fault "NONE"))}}
      {{#if (eq @root.current_layer 'HAL')}}
  HAL_CORTEX_SCB_EnableHardFaultEscalation({{@root.enable_fault}});
      {{else}}
  SCB_DisableFault({{@root.enable_fault}});
      {{/if}}
    {{/if}}
}

  {{/with}}
{{/each}}

{{> CORTEX fct='generate_handler' type='implementation' component='CORTEX_SCB'}}
{{/helper_common_beautifier}}
