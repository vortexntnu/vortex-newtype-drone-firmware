  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{~assign 'nvic_context' 'undefined'}}
{{#each @root.instances}}
  {{~assign 'PWR_ctx' config~}}
  {{~log "PWR template PWR_ctx:" (toJSON @root.PWR_ctx)~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.PWR_ctx.info.layer~}}
  {{~log "PWR template current_resource:" @root.current_resource~}}
  {{#with @root.PWR_ctx}}
  {{~assign "modules_activated" (@root.peripheralsResourceManagerAPI.getPeripheralsBoundToSoftwareInstances)~}}
  {{#if (and runtime.enable runtime.lp_exit (inArray @root.modules_activated 'RCC'))}}
#include "mx_rcc.h"
  {{else}}
    {{#> RCC fct='include_rcc'}}
    {{/RCC}}
  {{/if}}
/* Private typedef -----------------------------------------------------------*/
