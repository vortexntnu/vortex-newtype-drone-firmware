  * @file    stm32_external_env.h
  * @brief   External environments values (external oscillators values).
{{> LICENSE}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef STM32_EXTERNAL_ENV_H
#define STM32_EXTERNAL_ENV_H

#ifdef __cplusplus
extern "C" {
#endif

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/

{{#if (@root.EnvVarAPI.getVariableValue 'HAL_SYSTEM_PROJECT_USE_VDD_VALUE')}}
/* ########################## VDD Value #######################################*/
/**
  * @brief VDD Value.
  */
#if !defined  (VDD_VALUE)
#define  VDD_VALUE             {{@root.EnvVarAPI.getVariableValue 'HAL_SYSTEM_PROJECT_USE_VDD_VALUE'}}UL /*!< Value of VDD in mV */
#endif /* VDD_VALUE */
{{/if}}

/* ########################## Oscillator Values adaptation ####################*/
{{#if (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_HSE')}}
/**
  * @brief Adjust the value of External High Speed oscillator (HSE) used in your application.
  *        This value is used by the RCC HAL module to compute the system frequency
  *        (when HSE is used as system clock source, directly or through the PLL).
  */
#if !defined  (HSE_VALUE)
#define HSE_VALUE              {{@root.clockAPI.getClockFrequency "HSE"}}UL /*!< Value of the External oscillator in Hz */
#endif /* HSE_VALUE */

#if !defined  (HSE_STARTUP_TIMEOUT)
#define HSE_STARTUP_TIMEOUT    {{@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_HSE_STARTUP_TIME'}}UL   /*!< Time out for HSE start up, in ms */
#endif /* HSE_STARTUP_TIMEOUT */

{{/if}}
{{#if (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_LSE')}}
/**
  * @brief External Low Speed oscillator (LSE) value.
  *        This value is used by the UART, RTC HAL module to compute the system frequency
  */
#if !defined  (LSE_VALUE)
#define LSE_VALUE              {{@root.clockAPI.getClockFrequency "LSE"}}UL   /*!< Value of the External oscillator in Hz*/
#endif /* LSE_VALUE */

#if !defined  (LSE_STARTUP_TIMEOUT)
#define LSE_STARTUP_TIMEOUT    {{@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_LSE_STARTUP_TIME'}}UL     /*!< Time out for LSE start up, in ms */
#endif /* LSE_STARTUP_TIMEOUT */

{{/if}}

{{#if (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_AUDIO')}}
/**
  * @brief External AUDIO oscillator (AUDIO_CLK) value.
  */
#if !defined  (AUDIO_CLOCK_VALUE)
#define AUDIO_CLOCK_VALUE    {{@root.clockAPI.getClockFrequency "AUDIO_Source"}}UL   /*!< Value of the AUDIO_CLK external oscillator in Hz */
#endif /* AUDIO_CLOCK_VALUE */

{{/if}}
{{assign 'audio_clock_freq' (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_AUDIO_CLOCK')~}}
{{#unless (eq @root.audio_clock_freq undefined)}}
{{#if (@root.peripheralsResourceManagerAPI.getSoftwareInstancesBoundToPeripheral "SAI1")}}
/**
  * @brief External clock source for SAI1 peripheral
  *        This value is used by the RCC HAL module to compute the SAI1 clock source
  *        frequency.
  */
#if !defined  (EXTERNAL_SAI1_CLOCK_VALUE)
#define EXTERNAL_SAI1_CLOCK_VALUE  {{@root.audio_clock_freq}}UL /*!< Value of the SAI1 External clock source in Hz*/
#endif /* EXTERNAL_SAI1_CLOCK_VALUE */

{{/if}}
{{#if (@root.peripheralsResourceManagerAPI.getSoftwareInstancesBoundToPeripheral "SAI2")}}
/**
  * @brief External clock source for SAI2 peripheral
  *        This value is used by the RCC HAL module to compute the SAI2 clock source
  *        frequency.
  */
#if !defined  (EXTERNAL_SAI2_CLOCK_VALUE)
#define EXTERNAL_SAI2_CLOCK_VALUE   {{@root.audio_clock_freq}}U /*!< Value of the SAI2 External clock source in Hz*/
#endif /* EXTERNAL_SAI2_CLOCK_VALUE */

{{/if}}
{{/unless}}

/* Tip: To avoid modifying this file each time you need to use different HSE,
   ===  you can define the HSE value in your toolchain compiler preprocessor. */

#ifdef __cplusplus
}
#endif

#endif /* STM32_EXTERNAL_ENV_H */
{{/helper_common_beautifier}}
