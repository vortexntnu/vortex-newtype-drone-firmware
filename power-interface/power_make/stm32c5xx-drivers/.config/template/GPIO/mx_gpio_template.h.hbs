{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context_gpio 'GPIO' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.pinoutAPI)~}}
{{log "GPIO template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{uppercase @root.file_name}}_H
#define MX_{{uppercase @root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "stm32_{{lowercase @root.current_layer}}.h"
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{!log "GPIO template - instance:" (toJSON this)~}}
  {{assign 'gpio_cxt' config~}}
  {{assign 'current_resource' current_resource~}}
  {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
  {{assign 'configs' @root.gpio_cxt~}}
/******************************************************************************/
/* Exported defines for {{@root.current_resource}} in {{@root.current_layer}} layer                             */
/******************************************************************************/
{{assign 'define' "#define"}}
  {{#with @root.configs}}
    {{#each pins}}
      {{assign 'pin_cfg' (@root.pinoutAPI.getPinData _foreignKey)~}}
      {{assign 'aliases' (helper_gpio_create_aliases @root.pin_cfg.labels label_name)}}
      {{#with basic}}
        {{#if @root.aliases.master_label}}
/* Primary aliases for GPIO {{../_foreignKey}} pin */
          {{#if (eq @root.current_layer 'HAL')}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_PORT") 47}} HAL_GPIO{{@root.pin_cfg.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_PIN") 47}} HAL_GPIO_PIN_{{@root.pin_cfg.index}}
              {{#if (not (eq output_init_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INIT_STATE") 47}} HAL_GPIO_PIN_{{output_init_state}}
                {{#if (not (eq output_active_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_ACTIVE_STATE") 47}} HAL_GPIO_PIN_{{output_active_state}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq output_active_state 'RESET')}}SET{{else}}RESET{{/if}}
                {{/if}}
              {{/if}}

          {{else}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_PORT") 47}} GPIO{{@root.pin_cfg.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_PIN") 47}} LL_GPIO_PIN_{{@root.pin_cfg.index}}
              {{#if (not (eq output_init_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INIT_STATE") 47}} LL_GPIO_PIN_{{output_init_state}}
                {{#if (not (eq output_active_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_ACTIVE_STATE") 47}} LL_GPIO_PIN_{{output_active_state}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq output_active_state 'RESET')}}SET{{else}}RESET{{/if}}
                {{/if}}
              {{/if}}
          {{/if}}

          {{~assign 'found_other_labels' false}}
          {{#each @root.aliases.other_labels}}
            {{#if (not @root.found_other_labels)}}
/* Secondary aliases for GPIO {{../../_foreignKey}} pin */
              {{~assign 'found_other_labels' true}}
            {{/if}}
            {{#if (eq @root.current_layer 'HAL')}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_PORT") 47}} HAL_GPIO{{@root.pin_cfg.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_PIN") 47}} HAL_GPIO_PIN_{{@root.pin_cfg.index}}
                {{#if (not (eq ../output_init_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_INIT_STATE") 47}} HAL_GPIO_PIN_{{../output_init_state}}
                  {{#if (not (eq ../output_active_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_ACTIVE_STATE") 47}} HAL_GPIO_PIN_{{../output_active_state}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_INACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq ../output_active_state 'RESET')}}SET{{else}}RESET{{/if}}
                  {{/if}}
                {{/if}}

            {{else}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_PORT") 47}} GPIO{{@root.pin_cfg.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_PIN") 47}} LL_GPIO_PIN_{{@root.pin_cfg.index}}
              {{#if (not (eq ../output_init_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_INIT_STATE") 47}} LL_GPIO_PIN_{{../output_init_state}}
                {{#if (not (eq ../output_active_state undefined))}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_ACTIVE_STATE") 47}} LL_GPIO_PIN_{{../output_active_state}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase this) "_INACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq ../output_active_state 'RESET')}}SET{{else}}RESET{{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
          {{/each}}
        {{/if}}

        {{!-- EXTI aliases per pin if enabled --}}
        {{#if enable_exti}}
{{> EXTI fct='exti_gpio_generate_aliases' layer=@root.current_layer needs=exti_config.needs}}
        {{/if}}

      {{/with}}
    {{/each}}
  {{/with}}

{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{#each @root.instances}}
  {{~assign 'gpio_cxt' config~}}
  {{assign 'current_resource' current_resource~}}
  {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
  {{assign 'configs' @root.gpio_cxt~}}
  {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer                           */
/******************************************************************************/
    {{! ~}}
    {{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
    {{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval 0  GPIO group correctly initialized
  * @retval -1 Issue detected during GPIO group initialization
  */
    {{#if (eq @root.current_layer 'HAL')}}
system_status_t {{@root.fct_name}}_init(void);
    {{else}}
system_status_t {{@root.fct_name}}_init(void);
    {{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance.
  */
system_status_t {{@root.fct_name}}_deinit(void);

{{/each}}
{{> EXTI fct='exti_gpio_gethandle' resource=@root.current_resource exti_list=@root.exti_object.list_exti type='prototype' called_by_pppi_gpio=false}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='EXTI'}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{uppercase @root.file_name}}_H */
{{/helper_common_beautifier}}
