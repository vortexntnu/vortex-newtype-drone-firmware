{{#if (eq @root.current_layer 'HAL')}}
hal_iwdg_handle_t *{{@root.fct_name}}_init(void)
{

  if (HAL_IWDG_Init(&h{{@root.current_resource}}, HAL_{{@root.current_resource}}{{@root.current_index}}) != HAL_OK)
  {
    return NULL;
  }

{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for IWDG */
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}

{{/if}}
  return &h{{@root.current_resource}};
}

{{#if runtime.start_function}}
/*
  Start the Independent Watchdog (IWDG) with the following parameters:
  - Maximum time before watchdog reset   : {{runtime.iwdg_calculator.max_time.user_max_time}} {{runtime.iwdg_calculator.unit}}
  - Minimum time before refresh (window) : {{#if runtime.iwdg_calculator.min_time.window_enable}}{{runtime.iwdg_calculator.min_time.user_min_time}} {{runtime.iwdg_calculator.unit}}{{else}} 0 {{runtime.iwdg_calculator.unit}}{{/if}}
  - Early Wakeup Interrupt (EWI) time    : {{#if runtime.iwdg_calculator.early_wakeup.ewi_enable}}{{runtime.iwdg_calculator.early_wakeup.user_ewi_time}} {{runtime.iwdg_calculator.unit}}{{else}} 0 {{runtime.iwdg_calculator.unit}}{{/if}}
*/
hal_status_t {{@root.fct_name}}_start(void)
{

  return HAL_IWDG_Start(&h{{@root.current_resource}}, {{#if runtime.iwdg_calculator.min_time.window_enable}}{{runtime.iwdg_calculator.min_time.user_min_time}}UL{{else}}0UL{{/if}}, {{runtime.iwdg_calculator.max_time.user_max_time}}UL, {{#if runtime.iwdg_calculator.early_wakeup.ewi_enable}}{{runtime.iwdg_calculator.early_wakeup.user_ewi_time}}UL{{else}}0UL{{/if}});
}
{{/if}} {{!runtime.start_function~}}

{{else}}
{{!
    Generation of initialization function used in LL
~}}
IWDG_TypeDef *{{@root.fct_name}}_init(void)
{
{{#if system.nvic.enable_interruption}}
  /* Enable the interuption for IWDG */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context system.nvic.irq_config.needs @root.nvic_context)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}

{{/if}}
  return {{@root.current_resource}};
}

{{#if runtime.start_function}}
/*
  Start the Independent Watchdog (IWDG) with the following parameters:
  - Maximum time before watchdog reset   : {{runtime.iwdg_calculator.max_time.user_max_time}} {{runtime.iwdg_calculator.unit}}
  - Minimum time before refresh (window) : {{#if runtime.iwdg_calculator.min_time.window_enable}}{{runtime.iwdg_calculator.min_time.user_min_time}} {{runtime.iwdg_calculator.unit}}{{else}} 0 {{runtime.iwdg_calculator.unit}}{{/if}}
  - Early Wakeup Interrupt (EWI) time    : {{#if runtime.iwdg_calculator.early_wakeup.ewi_enable}}{{runtime.iwdg_calculator.early_wakeup.user_ewi_time}} {{runtime.iwdg_calculator.unit}}{{else}} 0 {{runtime.iwdg_calculator.unit}}{{/if}}
*/
system_status_t {{@root.fct_name}}_start(void)
{
  /* These values are calculated from the ones inputted by the user in the IWDG panel. */
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'IWDG_PRESCALER') 0))}}
  /* uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'IWDG_PRESCALER'}}UL; */
{{else}}
  uint32_t prescaler = {{@root.EnvVarAPI.getVariableValue 'IWDG_PRESCALER'}}UL;
{{/if}}
{{#if (gte (@root.EnvVarAPI.getVariableValue 'IWDG_RELOAD' includeZero=true) 0)}}
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'IWDG_RELOAD') 4095))}}
  /* uint32_t reload = {{@root.EnvVarAPI.getVariableValue 'IWDG_RELOAD'}}UL; */
{{else}}
  uint32_t reload = {{@root.EnvVarAPI.getVariableValue 'IWDG_RELOAD'}}UL;
{{/if}}
{{else}}
{{#if @root.optim_enable}}
  /* uint32_t reload = 4095UL; */
{{else}}
  uint32_t reload = 4095UL;
{{/if}}
{{/if}}
{{#if (and (eq runtime.iwdg_calculator.early_wakeup.ewi_enable true) (@root.EnvVarAPI.getVariableValue 'IWDG_EWI'))}}
  uint32_t early_wakeup = {{@root.EnvVarAPI.getVariableValue 'IWDG_EWI'}}UL;
{{else}}
  uint32_t early_wakeup = 0UL;
{{/if}}
{{#if (and (eq runtime.iwdg_calculator.min_time.window_enable true) (@root.EnvVarAPI.getVariableValue 'IWDG_WINDOW'))}}
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'IWDG_WINDOW') 4095))}}
  /* uint32_t window = {{@root.EnvVarAPI.getVariableValue 'IWDG_WINDOW'}}UL; */
{{else}}
  uint32_t window = {{@root.EnvVarAPI.getVariableValue 'IWDG_WINDOW'}}UL;
{{/if}}
{{else}}
{{#if @root.optim_enable}}
  /* uint32_t window = 4095UL; */
{{else}}
  uint32_t window = 4095UL;
{{/if}}
{{/if}}

  /* Enable the IWDG peripheral */
  LL_IWDG_Enable({{@root.current_resource}});

  /* Enable write access to IWDG registers */
  LL_IWDG_EnableWriteAccess({{@root.current_resource}});

  /* Set prescaler and reload counter */
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'IWDG_PRESCALER') 0))}}
  /* LL_IWDG_SetPrescaler({{@root.current_resource}}, prescaler); */
{{else}}
  LL_IWDG_SetPrescaler({{@root.current_resource}}, prescaler);
{{/if}}
{{#if (and (eq @root.optim_enable true) (eq (@root.EnvVarAPI.getVariableValue 'IWDG_RELOAD') 4095))}}
  /* LL_IWDG_SetReloadCounter({{@root.current_resource}}, reload); */
{{else}}
  LL_IWDG_SetReloadCounter({{@root.current_resource}}, reload);
{{/if}}


  /* Check Reload update flag, before performing any reload of the counter, else previous value will be taken. */
  while (LL_IWDG_IsActiveFlag_RVU({{@root.current_resource}}) != 0UL);

  /* Configure Early Wakeup Interrupt (EWI) */
  if (early_wakeup == 0UL)
{{#if @root.optim_enable}}
  {
    /* LL_IWDG_DisableIT_EWI({{@root.current_resource}}); */
  }
  else
  {
    /* LL_IWDG_ClearFlag_EWIF({{@root.current_resource}}); */
    LL_IWDG_WRITE_REG({{@root.current_resource}}, EWCR, IWDG_EWCR_EWIE | early_wakeup);
  }
{{else}}
  {
    LL_IWDG_DisableIT_EWI({{@root.current_resource}});
  }
  else
  {
    LL_IWDG_ClearFlag_EWIF({{@root.current_resource}});
    LL_IWDG_WRITE_REG({{@root.current_resource}}, EWCR, IWDG_EWCR_EWIE | early_wakeup);
  }
{{/if}}

  /* Set the refresh window value */
{{#if (and (eq @root.optim_enable true) (or (eq (@root.EnvVarAPI.getVariableValue 'IWDG_WINDOW') 4095) (eq runtime.iwdg_calculator.min_time.window_enable false)))}}
  /* LL_IWDG_SetWindow({{@root.current_resource}}, (uint32_t)window); */
{{else}}
  LL_IWDG_SetWindow({{@root.current_resource}}, (uint32_t)window);
{{/if}}

  /* Check if any status flags are set indicating an error */
  while ((LL_IWDG_READ_REG({{@root.current_resource}}, SR) & (IWDG_SR_EWU | IWDG_SR_WVU | IWDG_SR_RVU | IWDG_SR_PVU)) != 0UL);

  /* Disable write access to IWDG registers */
  LL_IWDG_DisableWriteAccess({{@root.current_resource}});

  return SYSTEM_OK;
}
{{/if}} {{!runtime.start_function~}}
{{/if}}

