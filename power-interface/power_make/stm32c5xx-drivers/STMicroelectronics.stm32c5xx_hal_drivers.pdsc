      <require condition="CMSIS Core"/>
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="ICACHE"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="ICACHE"/> -->
    </condition>
