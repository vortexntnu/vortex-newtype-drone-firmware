      <require condition="CMSIS Core"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORTEX"/> -->
    </condition>
    <condition id="HAL CORE Init GPIO and CORTEX">
      <description>STMicroelectronics HAL CORTEX Init dependencies</description>
      <require condition="CMSIS Core"/>
      <require condition="HAL GPIO Init"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORTEX"/> -->
    </condition>
    <condition id="HAL CORE Init GPIO and CRS">
      <description>STMicroelectronics HAL CRS Init dependencies</description>
      <require condition="CMSIS Core"/>
      <!-- <require condition="HAL GPIO Init"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="CRS"/> -->
    </condition>
    <condition id="HAL CORE Init and ICACHE">
