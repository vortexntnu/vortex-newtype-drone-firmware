      <require Cclass="Device" Cgroup="STM32 HAL" Csub="CCB"/>
    </condition>
    <condition id="HAL CORE Init and RAMCFG">
      <description>STMicroelectronics HAL RAMCFG Init dependencies</description>
      <require condition="CMSIS Core"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="RAMCFG"/> -->
    </condition>
    <condition id="HAL CORE GPIO DMA Init and DAC">
      <description>STMicroelectronics HAL DAC Init dependencies</description>
      <require condition="HAL CORE GPIO DMA Init"/>
      <!-- <accept  Cclass="Device" Cgroup="STM32 HAL" Csub="DAC"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="DAC"/> -->
    </condition>
    <condition id="HAL CORE GPIO Init and OPAMP">
      <description>STMicroelectronics HAL OPAMP Init dependencies</description>
      <require condition="HAL GPIO Init"/>
      <require condition="HAL System Init"/>
      <!-- <accept  Cclass="Device" Cgroup="STM32 HAL" Csub="OPAMP"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="OPAMP"/> -->
    </condition>
    <condition id="HAL CORE GPIO Init and TAMP">
      <description>STMicroelectronics HAL TAMP Init dependencies</description>
      <require condition="CMSIS Core"/>
      <require condition="HAL GPIO Init"/>
      <require condition="HAL System Init"/>
      <!-- <accept  Cclass="Device" Cgroup="STM32 HAL" Csub="TAMP"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="TAMP"/> -->
    </condition>
    <condition id="HAL CORE GPIO Init and RTC">
      <description>STMicroelectronics HAL RTC Init dependencies</description>
      <require condition="CMSIS Core"/>
      <require condition="HAL GPIO Init"/>
      <require condition="HAL System Init"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="RTC"/> -->
    </condition>
    <condition id="HAL CORE Init and WWDG">
      <description>STMicroelectronics HAL WWDG Init dependencies</description>
      <require condition="CMSIS Core"/>
      <require condition="HAL System Init"/>
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="WWDG"/>
      <accept Cclass="Device" Cgroup="STM32 LL" Csub="WWDG"/> -->
    </condition>
    <condition id="HAL CORE DMA Init and CORDIC">
      <description>STMicroelectronics HAL CORDIC Init dependencies</description>
      <require condition="HAL CORE DMA Init"/>
      <require condition="HAL System Init"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORDIC"/> -->
    </condition>
    <!-- LL driver Conditions -->
    <condition id="LL">
      <description>STMicroelectronics STM32C5 and LL</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="Common"/>
    </condition>
    <!-- Timebases conditions -->
    <condition id="Timebase NONE">
      <description>HAL timebase NONE</description>
      <require condition="STM32C5"/>
    </condition>
    <condition id="Timebase HAL RTC ALARM or WKUP">
      <description>HAL timebase based on RTC ALARM or WAKEUP</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="RTC"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="RTC timebase template"/>
    </condition>
    <condition id="Timebase HAL TIM">
      <description>HAL timebase based on TIM</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="TIM"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="TIM timebase template"/>
    </condition>
    <!-- HAL OS Conditions -->
    <condition id="NO OS">
      <description>NO MW used for HAL OS</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="template"/>
    </condition>
    <condition id="MW FreeRTOS">
      <description>MW FreeRTOS used for HAL OS</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="template"/>
    </condition>
    <condition id="TEMPLATE OS">
      <description>TEMPLATE OS used for HAL OS</description>
      <require condition="STM32C5"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="template"/>
    </condition>
  </conditions>
  <generators>
    <!-- This generator is launched if any component referencing this generator by 'id' is selected and the specified <gpdsc> file does not exist -->
    <generator id="stm32c5xx_hal_mx2codegen">
      <description>ST Microelectronics: STM32 Cube Code Generator for HAL Drivers Pack</description>
      <exe>
        <command host="win">.config/gen_code.bat</command>
        <command host="linux">.config/gen_code.sh</command>
        <command host="mac">.config/gen_code.sh</command>
        <!-- #name of the gpdsc template contained in this PACK and aligned with GPDSC name-->
        <argument>HAL_Driver_codegen_template.gpdsc.hbs</argument>
        <!-- passing the generator name-->
        <argument>stm32c5xx_hal_mx2codegen</argument>
        <argument>$G</argument>
        <!-- Flag to indicate that this Generator is dry-run capable -->
        <argument mode="dry-run">--dry-run</argument>
      </exe>
      <!-- workingDir></workingDir -->
      <!-- path is specified either absolute or relative to PDSC or GPDSC file. If not specified it is the project directory configured by the environment -->
      <gpdsc name="$P/STM32_HAL_Driver_codegen.gpdsc"/>
    </generator>
  </generators>
  <components>
    <!-- START: STMicroelectronics STM32CubeC5 HAL -->
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="SYSTICK" isDefaultVariant="true" Cversion="2.0.0" condition="Timebase NONE">
      <description>HAL timebases based on Systick</description>
      <files>
        <file category="include" name="timebases/"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="RTC timebase template" Cversion="2.0.0" condition="HAL Common">
      <description>HAL RTC templates used for timebases based on RTC alarm or RTC wakeup</description>
      <files>
        <file category="header" name="templates/timebases/stm32_hal_timebase.h" attr="template" select="timebase" version="2.0.0"/>
        <file category="header" name="templates/timebases/mx_rtc.h" attr="config" version="2.0.0"/>
        <file category="source" name="templates/timebases/mx_rtc.c" attr="config" version="2.0.0"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_ALARM" Cversion="2.0.0" condition="Timebase HAL RTC ALARM or WKUP">
      <description>HAL timebases based on RTC alarm</description>
      <files>
        <file category="source" name="timebases/stm32_hal_timebase_rtc_alarm.c"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_WAKEUP" Cversion="2.0.0" condition="Timebase HAL RTC ALARM or WKUP">
      <description>HAL timebases based on RTC wakeup</description>
      <files>
        <file category="source" name="timebases/stm32_hal_timebase_rtc_wakeup.c"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="TIM timebase template" Cversion="2.0.0" condition="HAL Common">
      <description>HAL templates</description>
      <files>
        <file category="header" name="templates/timebases/stm32_hal_timebase.h" attr="template" select="timebase" version="2.0.0"/>
        <file category="header" name="templates/timebases/mx_timx.h" attr="template" select="timebase" version="2.0.0"/>
        <file category="source" name="templates/timebases/mx_timx.c" attr="template" select="timebase" version="2.0.0"/>
      </files>
    </component>
    <component Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="TIM" Cversion="2.0.0" condition="Timebase HAL TIM">
