      <require condition="HAL CORE GPIO DMA Init"/>
      <require condition="HAL System Init"/>
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="ADC"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="ADC"/> -->
    </condition>
    <condition id="HAL CORE GPIO Init and COMP">
