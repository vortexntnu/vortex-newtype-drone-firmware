<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32C5*">
  <vendor>STMicroelectronics</vendor>
  <name>stm32c5xx_hal_drivers</name>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="HAL" friendlyName="stm32c5xx_drivers" shortDesc="STM32C5xx HAL Drivers">
        <relocation-info parent="" layer="" element=""/>
        <compatibility>
          <release version="2.1.0">
            <applicable-schema schemaType="sw-configuration" schemaVersion="3.8.0" />
            <applicable-api-group apiType="codegen-getters">
              <applicable-api apiType="clockAPI" apiVersion="1.0.0" />
              <applicable-api apiType="DmaAPI" apiVersion="1.0.0" />
              <applicable-api apiType="EnvVarAPI" apiVersion="1.0.0" />
              <applicable-api apiType="ExtiAPI" apiVersion="1.0.0" />
              <applicable-api apiType="hwPlatformAPI" apiVersion="1.0.0" />
              <applicable-api apiType="NvicAPI" apiVersion="1.0.0" />
              <applicable-api apiType="peripheralsResourceManagerAPI" apiVersion="1.0.0" />
              <applicable-api apiType="pinoutAPI" apiVersion="1.0.0" />
              <applicable-api apiType="SWConfigurationAPI" apiVersion="1.0.0" />
              <applicable-api apiType="SWProjectAPI" apiVersion="1.0.0" />
            </applicable-api-group>
          </release>
          <release version="2.0.0">
            <applicable-schema schemaType="sw-configuration" schemaVersion="3.8.0" />
            <applicable-api-group apiType="codegen-getters">
              <applicable-api apiType="clockAPI" apiVersion="1.0.0" />
              <applicable-api apiType="DmaAPI" apiVersion="1.0.0" />
              <applicable-api apiType="EnvVarAPI" apiVersion="1.0.0" />
              <applicable-api apiType="ExtiAPI" apiVersion="1.0.0" />
              <applicable-api apiType="hwPlatformAPI" apiVersion="1.0.0" />
              <applicable-api apiType="NvicAPI" apiVersion="1.0.0" />
              <applicable-api apiType="peripheralsResourceManagerAPI" apiVersion="1.0.0" />
              <applicable-api apiType="pinoutAPI" apiVersion="1.0.0" />
              <applicable-api apiType="SWConfigurationAPI" apiVersion="1.0.0" />
              <applicable-api apiType="SWProjectAPI" apiVersion="1.0.0" />
            </applicable-api-group>
          </release>
        </compatibility>
      </stm32:pack>
    </environment>
  </environments>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>5D992.c</ECCN-US>
  </ECCN>
  <description>STMicroelectronics STM32C5xx HAL Drivers</description>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <license>LICENSE.md</license>
  <changelogs>
    <changelog id="Release Notes" name="Release_Notes.html"/>
  </changelogs>
  <releases>
    <release version="2.1.0" date="2026-05-04">

Second Official release of STM32C5xx HAL Drivers supporting:
- STM32C551xx, STM32C552xx, STM32C562xx devices
- STM32C531xx, STM32C532xx, STM32C542xx devices
- STM32C591xx, STM32C593xx, STM32C5A3xx devices

    </release>
    <release version="2.0.0" date="2026-02-12">

First Official release of STM32C5xx HAL Drivers supporting:
- STM32C551xx, STM32C552xx, STM32C562xx devices
- STM32C531xx, STM32C532xx, STM32C542xx devices
- STM32C591xx, STM32C593xx, STM32C5A3xx devices

    </release>

  </releases>
  <keywords>
    <keyword>ST</keyword>
    <keyword>HAL</keyword>
    <keyword>LL</keyword>
    <keyword>STM32C5</keyword>
    <keyword>STM32C5xx</keyword>
  </keywords>
  <requirements>
    <packages>
      <package vendor="STMicroelectronics" name="stm32c5xx_dfp" version="2.1.0"/>
    </packages>
  </requirements>
  <conditions>
    <condition id="STM32C5">
      <description>STMicroelectronics STM32C5</description>
      <require Dvendor="STMicroelectronics:13" Dname="STM32C5*"/>
    </condition>
    <!-- HAL Conditions -->
    <condition id="CMSIS Core">
      <description>STMicroelectronics STM32C5 and HAL Common</description>
      <require condition="STM32C5"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
    <condition id="HAL Common">
      <description>STMicroelectronics STM32C5 and HAL common</description>
      <require condition="STM32C5"/>
      <require condition="CMSIS Core"/>
    </condition>
    <condition id="HAL CORE">
      <description>STMicroelectronics STM32C5 and HAL system</description>
      <require condition="HAL Common"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="template"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="RCC"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORTEX"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="Core"/> -->
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_ALARM"/> -->
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_WAKEUP"/> -->
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="TIM"/> -->
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="SYSTICK"/> -->
    </condition>
    <condition id="HAL CORE DMA">
      <description>STMicroelectronics STM32C5 and HAL with DMA</description>
      <require condition="HAL CORE"/>
      <require condition="HAL Common"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="DMA"/>
    </condition>
    <condition id="HAL ADC">
      <description>HAL ADC dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="ADC"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="DBGMCU"/>
    </condition>
    <condition id="HAL COMP">
      <description>HAL COMP dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="COMP"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="EXTI"/>
    </condition>
    <condition id="HAL CORDIC">
      <description>HAL CORDIC dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="CORDIC"/>
    </condition>
    <condition id="HAL CORTEX">
      <description>HAL CORTEX dependencies</description>
      <require condition="HAL Common"/>
    </condition>
    <condition id="HAL CRC">
      <description>HAL CRC dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="CRC"/>
    </condition>
    <condition id="HAL CRS">
      <description>HAL CRS dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="CRS"/>
    </condition>
    <condition id="HAL DAC">
      <description>HAL DAC dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="DAC"/>
    </condition>
    <condition id="HAL DBGMCU">
      <description>HAL DBGMCU dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="DBGMCU"/>
    </condition>
    <condition id="HAL DMA">
      <description>HAL DMA dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="DMA"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="Q"/>
    </condition>
    <condition id="HAL EXTI">
      <description>HAL EXTI dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="EXTI"/>
    </condition>
    <condition id="HAL FLASH">
      <description>HAL FLASH dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="FLASH_ITF"/>
    </condition>
    <condition id="HAL FLASH_ITF">
      <description>HAL FLASH_ITF dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="FLASH"/>
    </condition>
    <condition id="HAL GPIO">
      <description>HAL GPIO dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="GPIO"/>
    </condition>
    <condition id="HAL I2C">
      <description>HAL I2C dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="I2C"/>
    </condition>
    <condition id="HAL I3C">
      <description>HAL I3C dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="I3C"/>
    </condition>
    <condition id="HAL I2S">
      <description>HAL I2S dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="SPI"/>
    </condition>
    <condition id="HAL ICACHE">
      <description>HAL ICACHE dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="ICACHE"/>
    </condition>
    <condition id="HAL IWDG">
      <description>HAL IWDG dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="IWDG"/>
    </condition>
    <condition id="HAL LPTIM">
      <description>HAL LPTIM dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="LPTIM"/>
    </condition>
    <condition id="HAL OPAMP">
      <description>HAL OPAMP dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="OPAMP"/>
    </condition>
    <condition id="HAL PKA">
      <description>HAL PKA dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="PKA"/>
    </condition>
    <condition id="HAL PWR">
      <description>HAL PWR dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="PWR"/>
    </condition>
    <condition id="HAL RAMCFG">
      <description>HAL RAMCFG dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="RAMCFG"/>
    </condition>
    <condition id="HAL RCC">
      <description>HAL RCC dependencies</description>
      <require condition="HAL Common"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="RCC"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="BUS"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="PWR"/>
    </condition>
    <condition id="HAL RNG">
      <description>HAL RNG dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="RNG"/>
    </condition>
    <condition id="HAL RTC">
      <description>HAL RTC dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="RTC"/>
    </condition>
    <condition id="HAL SMARTCARD">
