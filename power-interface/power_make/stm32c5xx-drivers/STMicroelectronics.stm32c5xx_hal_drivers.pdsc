    </condition>
    <condition id="HAL SPI">
      <description>HAL SPI dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="SPI"/>
    </condition>
    <condition id="HAL SBS">
      <description>HAL SBS dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="SBS"/>
    </condition>
    <condition id="HAL TAMP">
      <description>HAL TAMP dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="TAMP"/>
    </condition>
    <condition id="HAL TIM">
      <description>HAL TIM dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="TIM"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="SBS"/>
    </condition>
    <condition id="HAL UART">
      <description>HAL UART dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="USART"/>
    </condition>
    <condition id="HAL USART">
      <description>HAL USART dependencies</description>
      <require condition="HAL CORE DMA"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="USART"/>
    </condition>
    <condition id="HAL WWDG">
      <description>HAL WWDG dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="WWDG"/>
    </condition>
    <condition id="HAL CORE XSPI">
      <description>HAL CORE XSPI dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 HAL DRIVERS CORE" Csub="DLYB"/>
    </condition>
    <condition id="HAL CORE USB">
      <description>HAL CORE USB dependencies</description>
      <require condition="HAL CORE"/>
      <require Cclass="Device" Cgroup="STM32 HAL DRIVERS CORE" Csub="USB DRD"/>
      <require Cclass="Device" Cgroup="STM32 HAL DRIVERS CORE" Csub="USB CORE DEF"/>
    </condition>
    <!-- HAL Init Generated Code Conditions -->
    <condition id="Use mutex">
      <description>STMicroelectronics HAL condition to check if USE_HAL_MUTEX is enabled</description>
      <!-- <accept Cclass=="Device" Cgroup="STM32 HAL" Csub="HAL OS" Cvariant="NO_OS"/>
      <accept Cclass=="Device" Cgroup="STM32 HAL" Csub="HAL OS" Cvariant="FreeRTOS"/> -->
    </condition>
    <condition id="HAL Generated code">
      <description>STMicroelectronics HAL components used for code Generation</description>
      <require condition="Use mutex"/>
      <require condition="CMSIS Core"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORTEX"/> -->
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="EXTI"/> -->
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="PWR"/> -->
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="RCC"/> -->
      <require Cclass="Device" Cgroup="STM32 LL" Csub="UTILS"/>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Codegen" Csub="Generated Code"/>
    </condition>
    <condition id="HAL System Init">
      <description>STMicroelectronics HAL Common Init</description>
      <require condition="HAL Generated code"/>
    </condition>
    <condition id="HAL CORE Init GPIO and RCC">
      <description>STMicroelectronics HAL Common Init</description>
      <require condition="HAL Generated code"/>
      <!-- <require condition="HAL GPIO Init"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="PWR"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="FLASH_ITF"/> -->
    </condition>
    <condition id="HAL CORE GPIO Init and PWR">
      <description>STMicroelectronics HAL PWR Init</description>
      <require condition="HAL Generated code"/>
      <!-- <require condition="HAL GPIO Init"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="PWR"/> -->
    </condition>
    <condition id="HAL GPIO Init">
      <description>STMicroelectronics HAL Common Init</description>
      <require condition="HAL Generated code"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="GPIO"/> -->
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="SBS"/> -->
    </condition>
    <condition id="HAL CORE GPIO DMA Init">
      <description>STMicroelectronics HAL CORE, GPIO and DMA Init dependencies</description>
      <require condition="CMSIS Core"/>
      <!-- <require Cclass="Device" Cgroup="STM32 HAL" Csub="GPIO"/> -->
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="DMA"/> -->
    </condition>
    <condition id="HAL CORE DMA Init">
      <description>STMicroelectronics HAL CORE and DMA Init dependencies</description>
      <require condition="CMSIS Core"/>
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="DMA"/> -->
    </condition>
    <condition id="HAL CORE Init and CRC">
      <description>STMicroelectronics HAL CRC Init dependencies</description>
      <require condition="CMSIS Core"/>
      <!-- <accept Cclass="Device" Cgroup="STM32 HAL" Csub="CRC"/>
      <accept  Cclass="Device" Cgroup="STM32 LL" Csub="CRC"/> -->
    </condition>
