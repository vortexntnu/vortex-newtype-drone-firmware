        "folder": "utilities/thread_safe_libc"
      }
    ],
    "overridePackMappingRules": [
      {
        "selectors": [
          {
            "packVendor": "ARM"
          },
          {
            "packName": "*CMSIS*"
          }
        ],
        "path": "arch/{{packName}}"
      },
      {
        "selectors": [
          {
            "packType": "HAL"
          }
        ],
        "path": "{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "DFP"
          }
        ],
        "path": "{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "PARTDRV"
          }
        ],
        "path": "{{parent}}/{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "MW"
          }
        ],
        "path": "{{parent}}/{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "UTILITY"
          }
        ],
        "path": "{{parent}}/{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "EXAMPLE"
          }
        ],
        "path": "{{parent}}/{{layer}}/{{element}}/{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "HWBOARD"
          }
        ],
        "path": ""
      },
      {
        "selectors": [
          {
            "packType": "HWPART"
          }
        ],
        "path": ""
      },
      {
        "selectors": [
          {
            "packType": "TEMPLATE"
          }
        ],
        "path": ""
      },
      {
        "selectors": [],
        "path": "misc/{{packVendor}}.{{packName}}.{{packVersion}}"
      }
    ],
    "overrideGeneratorMappingRules": [
      {
        "selectors": [
          {
            "generator": "HALCodeGen"
          }
        ],
        "path": "{{SWprj}}/generated/hal/"
      },
      {
        "selectors": [
          {
            "generator": "FreeRTOSCodeGen"
          }
        ],
        "path": "{{SWprj}}/generated/middleware"
      },
      {
        "selectors": [
          {
            "generator": "*"
          },
          {
            "packType": "HAL"
          }
        ],
        "path": "{{SWprj}}/generated/hal"
      },
      {
        "selectors": [
          {
            "generator": "*"
          },
          {
            "packType": "MW"
          }
        ],
