      },
      {
        "selectors": [
          {
            "generator": "*"
          },
          {
            "packType": "PARTDRV"
          }
        ],
        "path": "{{SWprj}}/generated/parts"
      },
      {
        "selectors": [
          {
            "generator": "*"
          },
          {
            "packType": "UTILITY"
          }
        ],
        "path": "{{SWprj}}/generated/utilities"
      },
      {
        "selectors": [
          {
