      <require Cclass="Device" Cgroup="STM32 HAL" Csub="Core"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="CORTEX"/>
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="RCC"/>
      {{/unless}}
      <require condition="CMSIS Core"/>
      <require Cclass="Device" Cgroup="STM32 LL" Csub="UTILS"/>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Codegen" Csub="Generated Code"/>
      {{#unless @root.only_ll}}
        {{#if (or (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_PARAM') (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_STATE'))}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="ASSERT"/>
        {{/if}}
        {{~assign 'get_timebase' (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_TIMEBASE')~}}
        {{log '[INFO] GPDSC template: get_timebase=' @root.get_timebase~}}
        {{#if (or (eq @root.get_timebase undefined) (eq @root.get_timebase 'SYSTICK'))}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="SYSTICK"/>
        {{/if}}
        {{#if (eq @root.get_timebase 'RTC_ALARM')}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_ALARM"/>
        {{/if}}
        {{#if (eq @root.get_timebase 'RTC_WAKEUP')}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="RTC_WAKEUP"/>
        {{/if}}
        {{~assign 'get_timebase_tim' (@root.EnvVarAPI.getVariableValue 'CORE_TIM_TIMEBASE')~}}
        {{log '[INFO] GPDSC template: get_timebase=' @root.get_timebase~}}
        {{#unless (eq @root.get_timebase_tim undefined)}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="timebases" Cvariant="TIM"/>
        {{/unless}}
      {{/unless}}
    </condition>
    <condition id="Use mutex">
      <description>STMicroelectronics HAL condition to check if USE_HAL_MUTEX is enabled</description>
      {{~assign 'get_osal_selection' (@root.EnvVarAPI.getVariableValue 'HAL_CORE_PROJECT_OSAL_SELECTION')}}
      {{#unless (eq @root.get_osal_selection undefined)}}
        {{!-- User enables 'USE_HAL_MUTEX' inside CORE panel --}}
        {{#if (eq @root.get_osal_selection 'HAL NO OS')}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="HAL OS" Cvariant="NO_OS"/>
        {{else}}
      <require Cclass="Device" Cgroup="STM32 HAL" Csub="HAL OS" Cvariant="FreeRTOS"/>
        {{/if}}
      {{/unless}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
    {{~assign 'save_files' (arrayify  '')~}}
    {{#each components}}
      {{#if (length files_array)}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="RCC"'))}}
        {{#if (or (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_HSE') (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_LSE') (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_AUDIO_CLOCK') (@root.EnvVarAPI.getVariableValue 'HAL_SYSTEM_PROJECT_USE_VDD_VALUE'))}}
        <Pre_Include_Global_h>
          #define USE_EXTERNAL_ENV
        </Pre_Include_Global_h>
        {{/if}}
      {{/if}}
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="CORE"'))}}
        {{#if (or (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_PARAM') (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_STATE'))}}
        <Pre_Include_Global_h>
          {{#if (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_PARAM')}}
          #define USE_ASSERT_DBG_PARAM
          {{/if}}
          {{#if (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_STATE')}}
          #define USE_ASSERT_DBG_STATE
          {{/if}}
        </Pre_Include_Global_h>
        {{/if}}
      {{/if}}
      <files>
        {{#each files_array}}
        {{#unless (inArray @root.save_files gen_file)}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{~assign 'save_files' (helper_common_concatenate_elt_in_array gen_file @root.save_files)}}
        {{/unless}}
        {{/each}}
      </files>
    </component>
      {{/if}}
    {{/each}}
  </components>
</package>
