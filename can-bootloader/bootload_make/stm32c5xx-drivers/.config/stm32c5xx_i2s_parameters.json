{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:I2S",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/i2s_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_I2S_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "I2S"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "mode": {
              "title": "Mode",
              "type": "string",
              "default": "SLAVE_TX",
              "oneOf": [
                {
                  "title": "Slave transmit",
                  "const": "SLAVE_TX"
                },
                {
                  "title": "Slave receive",
                  "const": "SLAVE_RX"
                },
                {
                  "title": "Master transmit",
                  "const": "MASTER_TX"
                },
                {
                  "title": "Master receive",
                  "const": "MASTER_RX"
                },
                {
                  "title": "Slave full-duplex",
                  "const": "SLAVE_FULL_DUPLEX"
                },
                {
                  "title": "Master full-duplex",
                  "const": "MASTER_FULL_DUPLEX"
                }
              ]
            },
            "standard": {
              "title": "Standard",
              "type": "string",
              "default": "PHILIPS",
              "oneOf": [
                {
                  "title": "PHILIPS",
                  "const": "PHILIPS"
                },
                {
                  "title": "MSB-justified",
                  "const": "MSB"
                },
                {
                  "title": "LSB-justified",
                  "const": "LSB"
                },
                {
                  "title": "PCM with short frame synchronization",
                  "const": "PCM_SHORT"
                },
                {
                  "title": "PCM with long frame synchronization",
                  "const": "PCM_LONG"
                }
              ]
            },
            "data_format": {
              "title": "Data format",
              "type": "string",
              "default": "16_BIT",
              "oneOf": [
                {
                  "title": "16-bit on 16-bit channel",
                  "const": "16_BIT"
                },
                {
                  "title": "16-bit on 32-bit channel",
                  "const": "16_BIT_EXTENDED"
                },
                {
                  "title": "24-bit on 32-bit channel",
                  "const": "24_BIT"
                },
                {
                  "title": "32-bit on 32-bit channel",
                  "const": "32_BIT"
                }
              ]
            },
            "clock_source": {
              "type": "string",
              "title": "Clock source",
              "description": "Clock source can be modified in clock tree.",
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$get('clock.input', $resource.id)"
                  }
                }
              ],
              "default": ""
            },
            "clock_source_frequency": {
              "type": "string",
              "title": "Clock source frequency",
              "description": "Input clock frequency can be modified in clock tree.",
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                  }
                }
              ],
              "default": ""
            },
            "audio_frequency": {
              "title": "Audio frequency",
              "type": "integer",
              "default": 8000,
              "oneOf": [
                {
                  "title": "192 kHz",
                  "const": 192000
                },
                {
                  "title": "96 kHz",
                  "const": 96000
                },
                {
                  "title": "48 kHz",
                  "const": 48000
                },
                {
                  "title": "44 kHz",
                  "const": 44100
                },
                {
                  "title": "32 kHz",
                  "const": 32000
                },
                {
                  "title": "22 kHz",
                  "const": 22050
                },
                {
                  "title": "16 kHz",
                  "const": 16000
                },
                {
                  "title": "11 kHz",
                  "const": 11025
                },
                {
                  "title": "8 kHz",
                  "const": 8000
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.mode === 'SLAVE_FULL_DUPLEX' || $basic.mode === 'SLAVE_TX' || $basic.mode === 'SLAVE_RX'",
                  "message": "Audio frequency is determined by master clock."
                }
              ]
            },
            "real_audio_frequency": {
              "title": "Real audio frequency",
              "unit": "kHz",
              "type": "integer",
              "default": 0,
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "($common.helper_i2s_getrealfrequency($get('clock.frequency',$resource.id), $basic.standard, $basic.data_format, $additional.enable_mclk_output, $basic.audio_frequency))"
                  }
                },
                {
                  "type": "include",
                  "condition": "$basic.mode === 'MASTER_FULL_DUPLEX' || $basic.mode === 'MASTER_TX' || $basic.mode === 'MASTER_RX'"
                }
              ]
            },
            "error_frequency": {
              "title": "Audio frequency error",
              "description": "Relative error between audio frequency and real audio frequency, in %.",
              "unit": "%",
              "type": "integer",
              "default": 0,
              "readOnly": true,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "($common.helper_i2s_error_frequency($basic.audio_frequency, $basic.real_audio_frequency))"
                  }
                },
                {
                  "type": "error",
                  "condition": "$value >= 5",
                  "message": "The input clock frequency must be increased to deliver this frequency."
                },
                {
                  "type": "error",
                  "condition": "$value <= -5",
                  "message": "The input clock frequency must be increased to deliver this frequency."
                },
                {
                  "type": "warning",
                  "condition": "($value > 2) && ($value < 5) ",
                  "message": "Increasing the input clock frequency could allow for more precise delivery of this frequency."
                },
                {
                  "type": "include",
                  "condition": "$basic.mode === 'MASTER_FULL_DUPLEX' || $basic.mode === 'MASTER_TX' || $basic.mode === 'MASTER_RX'"
                }
              ]
            },
            "clock_polarity": {
              "title": "Clock polarity",
              "type": "string",
              "description": "Choose level of clock signal when clock is in IDLE state.",
              "default": "LOW",
              "oneOf": [
                {
                  "title": "Low",
                  "const": "LOW"
                },
                {
                  "title": "High",
                  "const": "HIGH"
                }
              ]
            },
            "bit_order": {
              "title": "Transfer bits order",
              "type": "string",
              "default": "MSB_FIRST",
              "oneOf": [
                {
                  "title": "MSB",
                  "const": "MSB_FIRST"
                },
                {
                  "title": "LSB",
                  "const": "LSB_FIRST"
                }
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "data_alignment": {
              "title": "Data alignment",
              "description": "Data alignment for data format 24-bit.",
              "type": "string",
              "default": "Right",
              "oneOf": [
                {
                  "title": "Right alignment",
                  "const": "Right"
                },
                {
                  "title": "Left alignment",
                  "const": "Left"
                }
              ],
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.data_format === '24_BIT'"
                }
              ]
            },
            "enable_mclk_output": {
              "title": "Master clock output",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.mode === 'SLAVE_FULL_DUPLEX' || $basic.mode === 'SLAVE_TX' || $basic.mode === 'SLAVE_RX'",
                  "message": "Mode must be in master"
                },
                {
                  "type": "set",
                  "condition": "$basic.mode === 'SLAVE_FULL_DUPLEX' || $basic.mode === 'SLAVE_TX' || $basic.mode === 'SLAVE_RX'",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "enable_ws_inversion": {
              "title": "Word select inversion",
              "type": "boolean",
              "default": false
            },
            "enable_channel_detection_err": {
              "title": "Channel length error detection",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.mode === 'MASTER_FULL_DUPLEX' || $basic.mode === 'MASTER_TX' || $basic.mode === 'MASTER_RX'",
                  "message": "Mode must be in slave"
                },
                {
                  "type": "set",
                  "condition": "$basic.mode === 'MASTER_FULL_DUPLEX' || $basic.mode === 'MASTER_TX' || $basic.mode === 'MASTER_RX'",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "set_fifo_threshold": {
              "title": "FIFO threshold",
              "type": "integer",
              "default": 1,
              "actions": [
                {
                  "type": "error",
                  "condition": "(($common.helper_data_format_to_bits($basic.data_format)) * Number($additional.set_fifo_threshold)) > ((2 ** $resource.features.TX_FIFO_SIZE) * 8)",
                  "message": "Data format exceeds FIFO size."
                }
              ],
              "oneOf": [
                {
                  "title": "1-data",
                  "const": 1,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($common.helper_data_format_to_bits($basic.data_format)) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8))"
                    }
                  ]
                },
                {
                  "title": "2-data",
                  "const": 2,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($common.helper_data_format_to_bits($basic.data_format)) * 2) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8))"
                    }
                  ]
                },
                {
                  "title": "3-data",
                  "const": 3,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($common.helper_data_format_to_bits($basic.data_format)) * 3) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8))"
                    }
                  ]
                },
                {
                  "title": "4-data",
                  "const": 4,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($common.helper_data_format_to_bits($basic.data_format)) * 4) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8))"
                    }
                  ]
                },
                {
                  "title": "5-data",
                  "const": 5,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($resource.features.TX_FIFO_SIZE > 2) && ($resource.features.RX_FIFO_SIZE > 2)) && ((($common.helper_data_format_to_bits($basic.data_format)) * 5) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8))"
                    }
                  ]
                },
                {
                  "title": "6-data",
                  "const": 6,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($resource.features.TX_FIFO_SIZE > 2) && ($resource.features.RX_FIFO_SIZE > 2)) && (($common.helper_data_format_to_bits($basic.data_format)) * 6) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8)"
                    }
                  ]
                },
                {
                  "title": "7-data",
                  "const": 7,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($resource.features.TX_FIFO_SIZE > 2) && ($resource.features.RX_FIFO_SIZE > 2)) && (($common.helper_data_format_to_bits($basic.data_format)) * 7) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8)"
                    }
                  ]
                },
                {
                  "title": "8-data",
                  "const": 8,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($resource.features.TX_FIFO_SIZE > 2) && ($resource.features.RX_FIFO_SIZE > 2)) && (($common.helper_data_format_to_bits($basic.data_format)) * 8) <= ((2 ** $resource.features.TX_FIFO_SIZE) * 8)"
                    }
                  ]
                }
              ]
            },
            "i2s_io_configuration": {
              "title": "IO",
              "type": "object",
              "properties": {
                "enable_master_keep_io_state": {
                  "type": "boolean",
                  "title": "Master keep IO state",
                  "default": false,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$basic.mode === 'SLAVE_FULL_DUPLEX' || $basic.mode === 'SLAVE_TX' || $basic.mode === 'SLAVE_RX'",
                      "message": "Mode must be in master"
                    },
                    {
                      "type": "set",
                      "condition": "$basic.mode === 'SLAVE_FULL_DUPLEX' || $basic.mode === 'SLAVE_TX' || $basic.mode === 'SLAVE_RX'",
                      "attributes": {
                        "const": false
                      }
                    }
                  ]
                },
                "enable_io_swap": {
                  "type": "boolean",
                  "title": "Swap",
                  "description": "Invert MOSI and MISO alternate functions.",
                  "default": false
                },
                "lock_io_config": {
                  "title": "Lock",
                  "type": "boolean",
                  "description": "Lock the alternate function configuration of associated I/Os.",
                  "default": false
                }
              }
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_ck": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected I2S peripheral cannot be mapped to a I2S_CK pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CK')"
                    }
                  ],
                  "title": "GPIO CK",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_ws": {
                  "title": "GPIO WS",
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected I2S peripheral cannot be mapped to a I2S_WS pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'WS')"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "WS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_sdi": {
                  "title": "GPIO SDI",
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected I2S peripheral cannot be mapped to a I2S_SDI pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'SDI')"
                    },
                    {
                      "type": "exclude",
                      "condition": "(($basic.mode == 'SLAVE_RX' || $basic.mode == 'MASTER_TX') && ($additional.i2s_io_configuration.enable_io_swap == false)) || (($basic.mode == 'SLAVE_TX' || $basic.mode == 'MASTER_RX') && ($additional.i2s_io_configuration.enable_io_swap == true))"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SDI",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_sdo": {
                  "title": "GPIO SDO",
                  "type": "object",
                  "actions": [
                    {
                      "type": "error",
                      "message": "The selected I2S peripheral cannot be mapped to a I2S_SDO pin: no pin available in the selected package.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'SDO')"
                    },
                    {
                      "type": "exclude",
                      "condition": "(($basic.mode == 'SLAVE_TX' || $basic.mode == 'MASTER_RX') && ($additional.i2s_io_configuration.enable_io_swap == false)) || (($basic.mode == 'SLAVE_RX' || $basic.mode == 'MASTER_TX') && ($additional.i2s_io_configuration.enable_io_swap == true))"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SDO",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_mck": {
                  "title": "GPIO MCK",
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($additional.enable_mclk_output) && ($get('pinout.peripheralCanBeMapped', $resource.id, 'MCK'))"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "MCK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "title": "DMA Tx",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.mode == 'SLAVE_RX' || $basic.mode == 'MASTER_RX'"
                    }
                  ]
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "src_data_width": {
                          "default": "HALFWORD"
                        },
                        "dest_data_width": {
                          "default": "HALFWORD"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ]
                },
                "enable_dma_rx": {
                  "title": "DMA Rx",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.mode == 'SLAVE_TX' || $basic.mode == 'MASTER_TX'"
                    }
                  ]
                },
                "dma_config_rx": {
                  "type": "object",
                  "title": "DMA Rx",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "const": "INCREMENTED"
                        },
                        "src_data_width": {
                          "default": "HALFWORD"
                        },
                        "dest_data_width": {
                          "default": "HALFWORD"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interrupt": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ Handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interrupt && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interrupt"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}