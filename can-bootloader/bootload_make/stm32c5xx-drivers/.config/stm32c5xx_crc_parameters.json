{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CRC",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CRC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "actions": [
            {
              "type": "include",
              "condition": "$resource.features.full_poly==1"
            }
          ],
          "properties": {
            "default_polynomial": {
              "type": "boolean",
              "description": "Configure CRC with its default value.",
              "title": "Polynomial",
              "oneOf": [
                {
                  "title": "Default",
                  "const": true
                },
                {
                  "title": "Custom",
                  "const": false
                }
              ],
              "default": true
            },
            "crc_polynomial": {
              "type": "object",
              "description": "Set CRC generating polynomial as a 7, 8, 16 or 32-bit long value for a polynomial degree respectively equal to 7, 8, 16 or 32.",
              "objectType": "polynomial",
              "size": [
                32,
                16,
                8
              ],
              "force": [
                0
              ],
              "default": {
                "size": 32,
                "value": 79764919
              },
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.default_polynomial"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": {
                      "size": 32,
                      "value": 79764919
                    }
                  },
                  "condition": "$basic.default_polynomial"
                }
              ],
              "title": "CRC polynomial"
            },
            "crc_init_value": {
              "type": "integer",
              "description": "Initialisation value to initiate CRC computation.",
              "title": "Initialisation value",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.default_polynomial"
                },
                {
                  "type": "set",
                  "condition": "$basic.default_polynomial",
                  "attributes": {
                    "const": 4294967295
                  }
                }
              ],
              "default": 4294967295,
              "display_format": [
                "dec",
                "hex"
              ],
              "maximum": 4294967295,
              "minimum": 0
            },
            "input_data_reverse_mode": {
              "type": "string",
              "title": "Invert input data",
              "description": "Input data inversion mode.",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.default_polynomial"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NONE"
                  },
                  "condition": "$basic.default_polynomial"
                }
              ],
              "oneOf": [
                {
                  "description": "No input data inversion.",
                  "title": "None",
                  "const": "NONE"
                },
                {
                  "description": "The bit-reversal is done by byte, 0x1A2B3C4D becomes 0x58D43CB2.",
                  "const": "BYTE",
                  "title": "Bit by byte"
                },
                {
                  "description": "The bit-reversal is done by half word, 0x1A2B3C4D becomes 0xD458B23C.",
                  "const": "HALFWORD",
                  "title": "Bit by halfword"
                },
                {
                  "description": "The bit-reversal is done on the full word, 0x1A2B3C4D becomes 0xB23CD458.",
                  "const": "WORD",
                  "title": "Bit by Word"
                },
                {
                  "title": "Halfword by word",
                  "const": "HALFWORD_BYWORD",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.peripheralVersionNum >= 2.4"
                    }
                  ],
                  "description": "The reversibility is done by half word by word, 0x1A2B3C4D becomes 0x3C4D1A2B."
                },
                {
                  "title": "Byte by word",
                  "const": "BYTE_BYWORD",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.peripheralVersionNum >= 2.4"
                    }
                  ],
                  "description": "The reversibility is done byte by word, 0x1A2B3C4D becomes 0x4D3C2B1A."
                }
              ],
              "default": "NONE"
            },
            "output_data_reverse_mode": {
              "title": "Invert output Data",
              "description": "Output data inversion mode.",
              "type": "string",
              "oneOf": [
                {
                  "title": "None",
                  "const": "NONE",
                  "description": "The bit order of the output data is not affected."
                },
                {
                  "title": "Bit by word",
                  "const": "BIT",
                  "description": "The bit-reversal of the output data is done by word."
                },
                {
                  "title": "Halfword by word",
                  "const": "HALFWORD_BYWORD",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.peripheralVersionNum >= 2.4"
                    }
                  ],
                  "description": "The reversibility is done half word by word."
                },
                {
                  "const": "BYTE_BYWORD",
                  "description": "The reversibility is done byte by word.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.peripheralVersionNum >= 2.4"
                    }
                  ],
                  "title": "Byte by word"
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.default_polynomial"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NONE"
                  },
                  "condition": "$basic.default_polynomial"
                }
              ],
              "default": "NONE"
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "#comment": "Use for instance for CRC",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}