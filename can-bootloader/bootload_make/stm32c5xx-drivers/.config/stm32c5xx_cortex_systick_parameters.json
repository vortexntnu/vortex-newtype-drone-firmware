{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX SYSTICK",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/systick_helpers.js",
      "accessor": "systick"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "systick_not_configurable": {
              "title": "Systick not configurable",
              "type": "string",
              "actions": [
                {
                  "type": "include",
                  "condition": "$get('swproject.hasRTOSenabled') || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')"
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This field is informational and cannot be edited."
                },
                {
                  "type": "set",
                  "condition": "$get('swproject.hasRTOSenabled')",
                  "attributes": {
                    "title": "Systick is handled by FreeRTOS"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')",
                  "attributes": {
                    "title": "Systick is handled by HAL timebase"
                  }
                }
              ],
              "default": "Is not configurable"
            },
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              },
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$get('swproject.hasRTOSenabled') || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')"
                }
              ]
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "ARM CMSIS",
                  "const": "LL"
                }
              ],
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$get('swproject.hasRTOSenabled') || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$get('swproject.hasRTOSenabled') || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')",
                  "message": "Can't be changed when SysTick is managed by FreeRTOS or HAL timebase."
                },
                {
                  "type": "set",
                  "condition": "$get('swproject.hasRTOSenabled') || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')",
                  "attributes": {
                    "const": "disabled"
                  }
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_SYSTICK_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "clock_source": {
              "title": "Clock source",
              "type": "string",
              "description": "Select the clock source used to drive SysTick.",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_SYSTICK_SOURCE_EXTERNAL",
                  "condition": "$value === 'EXTERNAL'",
                  "semaphore": true
                }
              ],
              "oneOf": [
                {
                  "title": "External",
                  "const": "EXTERNAL",
                  "actions":
                  [
                    {
                      "type": "warning",
                      "condition": "!$get('peripheral.isBound', 'RCC')",
                      "message": "RCC is not bound, external SysTick clock is not configured."
                    }
                  ]
                },
                {
                  "title": "Internal",
                  "const": "INTERNAL"
                }
              ],
              "default": "INTERNAL"
            },
            "tick_frequency": {
              "title": "Tick frequency",
              "type": "string",
              "description": "Choose the SysTick interrupt rate (ticks per second).",
              "oneOf": [
                {
                  "title": "10 Hz",
                  "const": "10HZ",
                  "actions":
                  [
                    {
                      "type": "include",
                      "condition": "$systick.helper_cortex_systick_is_rate_supported($basic.clock_source, $get('clock.frequency', 'CORTEX'), $get('clock.frequency', 'FCLK'), '10HZ')"
                    }
                  ]
                },
                {
                  "title": "100 Hz",
                  "const": "100HZ",
                  "actions":
                  [
                    {
                      "type": "include",
                      "condition": "$systick.helper_cortex_systick_is_rate_supported($basic.clock_source, $get('clock.frequency', 'CORTEX'), $get('clock.frequency', 'FCLK'), '100HZ')"
                    }
                  ]
                },
                {
                  "title": "1 KHz",
                  "const": "1KHZ",
                  "actions":
                  [
                    {
                      "type": "include",
                      "condition": "$systick.helper_cortex_systick_is_rate_supported($basic.clock_source, $get('clock.frequency', 'CORTEX'), $get('clock.frequency', 'FCLK'), '1KHZ')"
                    }
                  ]
                }
              ],
              "default": "10HZ"
            }
          },
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.hasRTOSenabled')) || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')"
            }
          ]
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": true
                },
                "irq_handler_generation": {
                  "title": "IRQ Handler generation",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && ($info.layer === 'HAL')"
                    }
                  ],
                  "default": true
                },
                "irq_config1": {
                  "title": "Systick priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:SysTick"
                    }
                  ]
                }
              }
            }
          },
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.hasRTOSenabled')) || ($get('envVar.value','CORE_PROJECT_TIMEBASE') == 'SYSTICK')"
            }
          ]
        }
      }
    }
  }
}