hal_{{lowercase @root.current_resource}}_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_FLASH_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
   return NULL;
  }
      {{~#with additional}}
        {{~#if use_flash_programming}}


  if (HAL_FLASH_SetProgrammingMode(&h{{@root.current_resource}}, HAL_FLASH_PROGRAM_{{programming_mode}}) != HAL_OK)
  {
    return NULL;
  }
        {{~/if}}
        {{~#if enable_single_ecc_interrupt}}


  HAL_FLASH_ITF_ECC_EnableIT(HAL_{{@root.current_resource}}, HAL_FLASH_ITF_IT_ECC_SINGLE);
        {{/if}}
      {{~/with}}{{! additional}}
      {{~#with system.nvic}}
        {{#if (and enable_interruption (eq enable_interruption true))}}
  /* Enable the interuption for FLASH */
{{~assign 'complex_nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.complex_nvic_context irq_config1.needs @root.current_resource irq_handler_generation)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
        {{#if (and enable_interruption_nmi (eq enable_interruption_nmi true))}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nmi_config1.needs @root.current_resource irq_handler_generation_nmi)}}
        {{/if}}
      {{~/with}}


  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
  HAL_FLASH_DeInit(&h{{@root.current_resource}});
      {{~#with system.nvic}}
        {{~#if (and enable_interruption (eq enable_interruption true))}}


  /* Disable the interuption for FLASH */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
      {{~/with}}

}

