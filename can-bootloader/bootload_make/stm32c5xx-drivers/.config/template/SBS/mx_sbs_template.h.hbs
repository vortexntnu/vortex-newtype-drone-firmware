{{> LICENSE}}

/* Define to prevent recursive inclusion -----------------------------------------------------------------------------*/
#ifndef MX_SBS_H
#define MX_SBS_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ----------------------------------------------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{assign 'sbs_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.sbs_cxt.info.layer~}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}
#include "mx_def.h"

/* Exported types ----------------------------------------------------------------------------------------------------*/
/* Exported constants ------------------------------------------------------------------------------------------------*/
{{#each @root.instances}}
{{~assign 'sbs_ctxt' config~}}
{{~assign 'current_resource' current_resource~}}
{{~assign 'current_layer' @root.sbs_ctxt.info.layer~}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}

/* Exported macros ---------------------------------------------------------------------------------------------------*/
/* Exported functions ----------------------------------------------------------------------------------------------- */

/******************************************************************************/
/* Exported functions for SBS in {{@root.current_layer}} layer */
/******************************************************************************/

  {{#with @root.sbs_ctxt}}
/**
  * @brief {{@root.fct_name}} SBS init function
  * This function configures the SBS peripheral used in this example
  */
system_status_t {{@root.fct_name}}_init(void);

/**
  * @brief {{@root.fct_name}} SBS deinit function
  */
system_status_t {{@root.fct_name}}_deinit(void);

    {{#with security_privilege}}
      {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t mx_sbs_config_privilege(void);
      {{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t mx_sbs_config_security_privilege(void);
      {{/if}}
    {{/with}}
  {{/with}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='prototype' component='SBS'}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_SBS_H */
