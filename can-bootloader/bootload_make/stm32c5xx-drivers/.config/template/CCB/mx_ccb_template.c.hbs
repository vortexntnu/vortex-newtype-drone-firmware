{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' false~}}
{{#each @root.instances~}}
{{~assign 'ccb_cxt' config~}}
{{~log "CCB template ccb_cxt:" (toJSON @root.ccb_cxt)~}}
{{~assign 'current_resource' current_resource~}}
{{~assign 'current_layer' @root.ccb_cxt.info.layer~}}
{{~log "CCB template current_resource:" @root.current_resource~}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_exist false)}}
static hal_{{lowercase @root.current_resource}}_handle_t h{{@root.current_resource}};
{{assign 'hal_handle_exist' true~}}
{{/if}}
{{/if}}
{{/each}}
{{assign 'hal_handle_exist' false~}}
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{assign 'nvic_needs' 'undefined'~}}
{{assign 'nvic_generate_handler' true~}}
{{#each @root.instances}}
{{~assign 'ccb_cxt' config~}}
{{~assign 'current_resource' current_resource~}}
{{~assign 'name' @root.ccb_cxt.name~}}
{{~assign 'current_layer' @root.ccb_cxt.info.layer~}}
{{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{#with @root.ccb_cxt}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{!
    Generation of initialization function used in HAL
~}}
hal_{{lowercase @root.current_resource}}_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_{{@root.current_resource}}_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
  HAL_{{@root.current_resource}}_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

}

{{#if (eq @root.hal_handle_exist false)}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined )~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_{{lowercase @root.current_resource}}_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}

{{assign 'hal_handle_exist' true~}}
{{/if}}
{{#with security_privilege}}

{{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/******************************************************************************/
/*                      Privileged attribute management                       */
/******************************************************************************/
system_status_t {{@root.fct_name}}_config_privilege(void)
{{else}}
/******************************************************************************/
/*                Security and privileged attributes management               */
/******************************************************************************/
system_status_t {{@root.fct_name}}_config_security_privilege(void)
{{/if}}
{
{{> RIF fct='rif_config_security' layer=@root.current_layer resource=@root.current_resource}}

if (HAL_RIF_RISC_SetPeriphSecAttr(HAL_RIF_RISC_PKA, HAL_RIF_SEC) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
if (HAL_RIF_RISC_SetPeriphSecAttr(HAL_RIF_RISC_SAES, HAL_RIF_SEC) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
if (HAL_RIF_RISC_SetPeriphSecAttr(HAL_RIF_RISC_RNG, HAL_RIF_SEC) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
{{#if (eq privilege "PRIV")~}}
if (HAL_RIF_RISC_SetPeriphPrivAttr(HAL_RIF_RISC_PKA, HAL_RIF_PRIV) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
if (HAL_RIF_RISC_SetPeriphPrivAttr(HAL_RIF_RISC_SAES, HAL_RIF_PRIV) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
if (HAL_RIF_RISC_SetPeriphPrivAttr(HAL_RIF_RISC_RNG, HAL_RIF_PRIV) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
{{/if}}
{{#if (eq lock true)~}}
  if (HAL_RIF_RISC_LockPeriphConfig(HAL_RIF_RISC_PKA) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
  if (HAL_RIF_RISC_LockPeriphConfig(HAL_RIF_RISC_RNG) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
  if (HAL_RIF_RISC_LockPeriphConfig(HAL_RIF_RISC_SAES) != HAL_OK)
   {
    return SYSTEM_PERIPHERAL_ERROR;
   }
{{/if}}
  return SYSTEM_OK;
}
{{/with}}
{{/with}}
{{/each}}
