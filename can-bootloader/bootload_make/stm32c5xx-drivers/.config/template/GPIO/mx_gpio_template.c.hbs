    {{#each pin}}
  LL_GPIO_SetAFPin_{{#if (lt this 8)}}0_7{{else}}8_15{{/if}}({{#if (lookup ../aliases.master_label @index)}}{{lookup ../aliases.master_label @index}}_PORT{{else}}GPIO{{../port}}{{/if}}, {{#if (lookup ../aliases.master_label @index)}}{{lookup ../aliases.master_label @index}}_PIN{{else}}LL_GPIO_PIN_{{this}}{{/if}}, LL_GPIO_AF_15);
    {{/each}}
  {{/if}}

  {{#if (eq mode 'EVENTOUT')}}
  /* Configure {{#each pin}}P{{../port}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} GPIO {{#if (eq (length pin) 1)}}pin{{else}}pins{{/if}} in alternate mode for EVENTOUT */{{! ~}}
  {{else}}
  /* Configure {{#each pin}}P{{../port}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} GPIO {{#if (eq (length pin) 1)}}pin{{else}}pins{{/if}} in {{lowercase mode}} mode */{{! ~}}
  {{/if}}
    {{#each pin}}
      {{#if (and (eq this '13') (eq ../port 'A'))}}
        {{~assign 'lut_table' (helper_gpio_get_lut_table 'PA13_lut')~}}
      {{else if (and (eq this '14') (eq ../port 'A'))}}
        {{~assign 'lut_table' (helper_gpio_get_lut_table 'PA14_lut')~}}
      {{else if (or (and (eq this "15") (eq ../port "A")) (and (eq this "4") (eq ../port "B")))}}
        {{~assign 'lut_table' (helper_gpio_get_lut_table 'PA15_PB4_lut')~}}
