{{#helper_common_beautifier}}
{{assign "_define_" "#define"~}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'TAMP' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "TAMP template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{assign 'tamp_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.tamp_cxt.info.layer~}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
  {{#with @root.tamp_cxt.security_privilege}}
    {{#unless @root.include_mx_def}}
      {{~assign 'include_mx_def' true~}}
#include "mx_def.h"
    {{/unless}}
  {{/with}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
#include "mx_def.h"
{{else}}
#include "stm32_hal.h"
#include "mx_def.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{~assign 'tamp_cxt' config~}}
  {{~assign 'current_layer' @root.tamp_cxt.info.layer~}}
  {{~assign 'current_resource' current_resource~}}
  {{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
  {{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}

/******************************************************************************/
/* Exported defines for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
  {{#with @root.tamp_cxt}}
    {{#with basic}}
      {{#with tamper_indiv_config}}
        {{#each tampers}}
          {{#if use_channel}}
            {{#if tamper_label_name}}
              {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{tamper_label_name}} HAL_TAMP_{{_foreignKey}}
              {{else}}
{{@root._define_}} {{tamper_label_name}} LL_{{helper_tamp_convert _foreignKey}}
              {{/if}}
            {{/if}}
          {{/if}}
        {{/each}}
        {{#each internal_tampers}}
          {{#if use_channel}}
            {{#if int_tamper_label_name}}
              {{#if (eq @root.current_layer 'HAL')}}
{{@root._define_}} {{int_tamper_label_name}} HAL_TAMP_{{_foreignKey}}
              {{else}}
{{@root._define_}} {{int_tamper_label_name}} LL_{{helper_tamp_internal_convert _foreignKey}}
              {{/if}}
            {{/if}}
          {{/if}}
        {{/each}}
      {{/with}}
    {{/with}}
  {{/with}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#each @root.instances}}
  {{~assign 'tamp_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.tamp_cxt.info.layer~}}
  {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for TAMP in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
system_status_t {{@root.fct_name}}_init(void);

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);
  {{#with @root.tamp_cxt.security_privilege}}
    {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
    {{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
    {{/if}}

  {{/with}}
{{/each}}

{{#if (eq @root.current_layer 'HAL')}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='TAMP'}}
{{/if}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}
