                           LL_RCC_APB2_PRESCALER_{{apb2}} | LL_RCC_APB3_PRESCALER_{{apb3}}); */

      {{else}}
  LL_RCC_ConfigBusClock(LL_RCC_HCLK_PRESCALER_{{ahb}} | LL_RCC_APB1_PRESCALER_{{apb1}} |
                        LL_RCC_APB2_PRESCALER_{{apb2}} | LL_RCC_APB3_PRESCALER_{{apb3}});

      {{/if}}
    {{/if}}
  {{/with~}}

