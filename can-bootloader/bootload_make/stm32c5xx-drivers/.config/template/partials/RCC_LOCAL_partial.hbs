  HAL_FLASH_ITF_SetLatency(HAL_FLASH, HAL_FLASH_ITF_LATENCY_{{flash_latency}});
      {{/if}}
{{>RCC_LOCAL fct='generate_set_system_clock'}}

      {{#if (lte frequencies.ahb frequencies.default)}}
  /** Frequency will be decreased */
  HAL_FLASH_ITF_SetLatency(HAL_FLASH, HAL_FLASH_ITF_LATENCY_{{flash_latency}});
      {{/if}}
  HAL_FLASH_ITF_SetProgrammingDelay(HAL_FLASH, HAL_FLASH_ITF_PROGRAM_DELAY_{{flash_programming_delay}});
    {{/with}}

  {{~else}}
    {{#with @root.system_config}}
      {{#if (gt frequencies.ahb frequencies.default)}}
  /** Frequency will be increased */
  LL_FLASH_SetLatency(FLASH, LL_FLASH_LATENCY_{{flash_latency}}WS);
      {{/if}}
{{>RCC_LOCAL fct='generate_set_system_clock'}}

      {{#if (lte frequencies.ahb frequencies.default)}}
  /** Frequency will be decreased */
  LL_FLASH_SetLatency(FLASH, LL_FLASH_LATENCY_{{flash_latency}}WS);
      {{/if}}
  LL_FLASH_SetProgrammingDelay(FLASH, LL_FLASH_PROGRAM_DELAY_{{flash_programming_delay}});

    {{/with}}
  {{/if~}}

{{else if (eq fct 'generate_set_prescaler')}}
{{!     Generate the enable of the HSI ~}}
{{!> RCC fct='generate_set_prescaler'}}
