    {{~assign 'falling_list' ''~}}
    {{~assign 'interrupt_list' ''~}}
    {{~assign 'event_list' ''~}}
    {{~assign 'rising_not_falling_list' ''~}}
    {{~assign 'falling_not_rising_list' ''~}}
    {{~assign 'have_rising' false~}}
    {{~assign 'have_falling' false~}}
    {{~assign 'have_interrupt' false~}}
    {{~assign 'have_event' false~}}
