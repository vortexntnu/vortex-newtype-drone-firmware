  {{! Initialize EXTI in mx_gpio_template.c.hbs~}}
  {{! > EXTI fct='exti_gpio_init' layer=@root.layer needs=exti_config.needs found_exti=@root.found_exti gpio_port=port gpio_pin=pin~}}
  {{!       needs: only 1 need will be handled at one time (ex: [{ "id": "<uuid-#1>" }])~}}
  {{!       found_exti: boolean to generate only 1 time the hal_exti_config_t parameter~}}
  {{!~}}
  {{! ~}}
  {{#if (eq layer 'HAL')}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{assign 'layer' layer~}}
  {{log "EXTI_Partial (exti_gpio_init): needs" needs~}}
  {{#each needs~}}
    {{~assign 'get_exti_cfg_config_object' (@root.ExtiAPI.getNeedById id)~}}
  {{/each~}}
  {{~assign 'found_exti' found_exti~}}
