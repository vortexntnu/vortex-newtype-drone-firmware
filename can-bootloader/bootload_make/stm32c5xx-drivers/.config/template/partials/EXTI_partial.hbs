    {{#if (not @root.found_exti)}}
  hal_exti_config_t exti_config;

    {{/if}}
    {{#with @root.get_exti_cfg_config_object.configuration.basic}}
  /* Initialize the EXTI for line {{@root.gpio_pin}} */
  HAL_EXTI_Init(&hEXTI{{@root.gpio_pin}}, HAL_EXTI_LINE_{{@root.gpio_pin}});

  /* Set the trigger as {{trigger_detection}} for the GPIO{{@root.gpio_port}} */
  exti_config.trigger   = HAL_EXTI_TRIGGER_{{trigger_detection}};
  exti_config.gpio_port = HAL_EXTI_GPIO{{@root.gpio_port}};
  HAL_EXTI_SetConfig(&hEXTI{{@root.gpio_pin}}, &exti_config);

      {{#unless (eq mode 'NONE')}}
  /* Enable the {{mode}} mode */
  HAL_EXTI_Enable(&hEXTI{{@root.gpio_pin}}, HAL_EXTI_MODE_{{mode}});

      {{/unless}}
      {{#if interruption.enable_interruption}}
  /* Set line {{@root.gpio_pin}} Interrupt priority */
{{! The nvic_context must stay unchanged since it is used by another template~}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context interruption.nvic.needs 'EXTI' interruption.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.layer needs=interruption.nvic.needs}}

      {{/if}}
    {{/with}}
  {{else}}
