  exti_config.trigger = HAL_EXTI_TRIGGER_{{trigger_detection}};
  HAL_EXTI_SetConfig(&h{{@root.get_exti_cfg_config_object.resourceId}}, &exti_config);

      {{/unless}}
      {{#unless (eq mode 'NONE')}}
