      {{#each config}}
        {{#if exti_enabled}}
  {{helper_common_gen_ll_code 'LL_EXTI_SetEXTISource' (concat 'LL_EXTI_GPIO_PORT' port) (concat 'LL_EXTI_GPIO_LINE' pin)}}
        {{/if}}
      {{/each}}

    {{/if}}
    {{#each config}}
      {{#if exti_enabled}}
        {{~assign 'pin' pin~}}
        {{#each config.needs}}
        {{~assign 'get_exti_cfg_config_object' (@root.ExtiAPI.getNeedById id)~}}
          {{#with @root.get_exti_cfg_config_object.configuration.basic}}
            {{#if interruption.enable_interruption}}
  /* Set line {{@root.pin}} Interrupt priority */
  {{! The nvic_context must stay unchanged since it is used by another template~}}
  {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context interruption.nvic.needs 'EXTI' false)~}}
  {{> CORTEX fct='init' layer='LL' needs=interruption.nvic.needs}}

            {{/if}}
          {{/with}}
        {{/each}}
      {{/if}}
    {{/each}}
  {{/if}}
{{else if (eq fct 'exti_get_init')}}
