              {{#if @root.not_first_r}}
                {{~assign 'rising_list' (append @root.rising_list ' | ')~}}
              {{/if}}
              {{~assign 'rising_list' (append @root.rising_list @root.line_token)~}}
              {{~assign 'have_rising' true~}}
              {{~assign 'not_first_r' true~}}
              {{#if (eq trigger_detection 'RISING')}}
                {{#if @root.not_first_rnf}}
                  {{~assign 'rising_not_falling_list' (append @root.rising_not_falling_list ' | ')~}}
                {{/if}}
                {{~assign 'rising_not_falling_list' (append @root.rising_not_falling_list @root.line_token)~}}
                {{~assign 'not_first_rnf' true~}}
              {{/if}}
            {{/if}}
            {{#if (or (eq trigger_detection 'FALLING') (eq trigger_detection 'RISING_FALLING'))}}
              {{#if @root.not_first_f}}
                {{~assign 'falling_list' (append @root.falling_list ' | ')~}}
              {{/if}}
              {{~assign 'falling_list' (append @root.falling_list @root.line_token)~}}
              {{~assign 'have_falling' true~}}
              {{~assign 'not_first_f' true~}}
              {{#if (eq trigger_detection 'FALLING')}}
                {{#if @root.not_first_fnr}}
                  {{~assign 'falling_not_rising_list' (append @root.falling_not_rising_list ' | ')~}}
                {{/if}}
                {{~assign 'falling_not_rising_list' (append @root.falling_not_rising_list @root.line_token)~}}
                {{~assign 'not_first_fnr' true~}}
              {{/if}}
            {{/if}}
            {{#if (or (eq mode 'INTERRUPT') (eq mode 'INTERRUPT_EVENT'))}}
              {{#if @root.not_first_i}}
                {{~assign 'interrupt_list' (append @root.interrupt_list ' | ')~}}
              {{/if}}
              {{~assign 'interrupt_list' (append @root.interrupt_list @root.line_token)~}}
              {{~assign 'have_interrupt' true~}}
              {{~assign 'not_first_i' true~}}
            {{/if}}
            {{#if (or (eq mode 'EVENT') (eq mode 'INTERRUPT_EVENT'))}}
              {{#if @root.not_first_e}}
                {{~assign 'event_list' (append @root.event_list ' | ')~}}
              {{/if}}
              {{~assign 'event_list' (append @root.event_list @root.line_token)~}}
              {{~assign 'have_event' true~}}
              {{~assign 'not_first_e' true~}}
            {{/if}}
          {{/with}}
        {{/each}}
      {{/if}}
    {{/each~}}
    {{#if @root.have_rising}}
  LL_EXTI_EnableRisingTrig_0_31({{@root.rising_list}});
      {{#unless (eq @root.rising_not_falling_list '')}}
  {{helper_common_gen_ll_code_add_subinst @root.rising_not_falling_list~}}
  {{helper_common_gen_ll_code_subinst 'LL_EXTI_DisableFallingTrig_0_31'}}
      {{/unless}}
    {{/if}}
    {{#if @root.have_falling}}
