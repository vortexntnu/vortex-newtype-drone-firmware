{{> SYSTEM fct='system_check_ll_optim'}}
{{assign 'lut_table'   (helper_exti_get_lut_table 'EXTIV1')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table 'undefined'~}}
{{assign 'gpio_port' gpio_port~}}
{{assign 'gpio_pin' gpio_pin~}}
{{#if (eq fct 'exti_gpio_variables')}}
  {{! ~}}
  {{! Generate the EXTI handle variable in mx_gpio_template.c.hbs~}}
  {{! > EXTI fct='exti_gpio_variables' layer=@root.layer exti_list=@root.exti_object.list_exti~}}
  {{! ~}}
  {{log "EXTI_Partial (exti_gpio_variables): layer=" layer "exti_list=" exti_list~}}
  {{#if (eq layer 'HAL')}}
    {{#each exti_list}}
static hal_exti_handle_t h{{this}};
    {{/each}}
  {{/if}}
{{else if (eq fct 'exti_get_variables')}}
  {{! ~}}
  {{! Generate the EXTI handle variable other than requested by GPIO~}}
  {{! > EXTI fct='exti_get_variables' layer=@root.layer needs=exti_config.needs~}}
  {{! ~}}
  {{#if (eq layer 'HAL')}}
  {{#each needs}}
    {{~assign 'get_exti_cfg_config_object' (@root.ExtiAPI.getNeedById id)~}}
static hal_exti_handle_t h{{@root.get_exti_cfg_config_object.resourceId}};
  {{/each}}
  {{/if}}
{{else if (eq fct 'exti_gpio_init')}}
