{{! The nvic_context must stay unchanged since it is used by another template~}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context interruption.nvic.needs 'EXTI' interruption.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.layer needs=interruption.nvic.needs}}

      {{/if}}
    {{/with}}
  {{else}}
    {{#with @root.get_exti_cfg_config_object.configuration.basic}}
      {{~assign 'line' (concat 'LL_EXTI_LINE_' @root.exti_line)~}}
      {{#unless (eq trigger_detection undefined)}}
        {{#if (or (eq trigger_detection 'RISING') (eq trigger_detection 'RISING_FALLING'))}}
          {{#if (lt @root.exti_line 32)}}
  LL_EXTI_EnableRisingTrig_0_31({{@root.line}});
          {{else if (lt @root.exti_line 64)}}
  LL_EXTI_EnableRisingTrig_32_63({{@root.line}});
          {{else}}
  LL_EXTI_EnableRisingTrig_64_95({{@root.line}});
          {{/if}}
        {{else}}
          {{#if (lt @root.exti_line 32)}}
  {{helper_common_gen_ll_code_add_subinst @root.line~}}
  {{helper_common_gen_ll_code_subinst 'LL_EXTI_DisableRisingTrig_0_31'}}
          {{else if (lt @root.exti_line 64)}}
  {{helper_common_gen_ll_code_add_subinst @root.line~}}
  {{helper_common_gen_ll_code_subinst 'LL_EXTI_DisableRisingTrig_32_63'}}
          {{else}}
  {{helper_common_gen_ll_code_add_subinst @root.line~}}
  {{helper_common_gen_ll_code_subinst 'LL_EXTI_DisableRisingTrig_64_95'}}
          {{/if}}
        {{/if}}
        {{#if (or (eq trigger_detection 'FALLING') (eq trigger_detection 'RISING_FALLING'))}}
          {{#if (lt @root.exti_line 32)}}
  LL_EXTI_EnableFallingTrig_0_31({{@root.line}});
