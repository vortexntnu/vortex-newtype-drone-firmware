    {{/if}}
    {{#if @root.have_interrupt}}
  LL_EXTI_EnableIT_0_31({{@root.interrupt_list}});
    {{/if}}
    {{#if @root.have_event}}
  LL_EXTI_EnableEvent_0_31({{@root.event_list}});
    {{/if}}

    {{#if @root.have_src}}
