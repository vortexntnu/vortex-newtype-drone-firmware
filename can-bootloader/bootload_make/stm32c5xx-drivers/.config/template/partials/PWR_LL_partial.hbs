###################################
##  exported_functions_runtime_apis
###################################
~}}
{{else if (eq fct 'exported_functions_runtime_apis')}}
  {{#with runtime}}
    {{#if enable}}
      {{#if lp_entry}}
system_status_t mx_pwr_enter_low_power(void)
{
        {{#if (or (eq mode 'STOP_MODE')(eq mode 'STOP0_MODE')(eq mode 'STOP1_MODE')(eq mode 'STOP2_MODE')(eq mode 'STOP3_MODE'))}}
  /* Clear stop flag */
  LL_PWR_ClearFlag_STOP();

        {{/if}}
        {{#if (eq mode 'STANDBY_MODE')}}
  /* Clear standby flag */
  LL_PWR_ClearFlag_SB();

        {{/if}}
        {{#if (and (eq mode_entry 'HAL_PWR_LOW_PWR_MODE_WFE')(or (eq mode 'SLEEP_MODE')(eq mode 'STOP_MODE')(eq mode 'STOP0_MODE')(eq mode 'STOP1_MODE')(eq mode 'STOP2_MODE')(eq mode 'STOP3_MODE')))}}
  /* Clear core pending event */
  __SEV();
  __WFE();

        {{/if}}
        {{#if (not (eq mode 'SLEEP_MODE'))}}
  /* Set SLEEPDEEP bit of Cortex System Control Register */
  SCB_EnableDeepSleep();

  LL_PWR_SetPowerMode(LL_PWR_{{mode}});

        {{else}}
  /* Clear SLEEPDEEP bit of Cortex System Control Register */
  SCB_DisableDeepSleep();

        {{/if}}
          {{~assign 'entry_mode' ''~}}
          {{#if (and (eq mode_entry 'HAL_PWR_LOW_PWR_MODE_WFE')(not (or (eq mode 'STANDBY_MODE')(eq mode 'SHUTDOWN_MODE'))))}}
            {{assign 'entry_mode' 'WFE'}}
          {{else}}
            {{assign 'entry_mode' 'WFI'}}
          {{/if}}
  /* DSB to ensure there are no outstanding memory transactions prior to executing {{@root.entry_mode}} and going to {{mode}} */
  __DSB();

        {{#if (eq mode_entry 'HAL_PWR_LOW_PWR_MODE_WFI')}}
  /* Wait for interrupt request */
  __WFI();

        {{else}}
          {{#if (eq mode 'STANDBY_MODE')}}
  /* Wait for event cannot be used in standby mode */
          {{else}}
            {{#if (eq mode 'SHUTDOWN_MODE')}}
  /* Wait for event cannot be used in shutdown mode */
            {{else}}
  /* Wait for event request */
  __WFE();
            {{/if}}
          {{/if}}
        {{/if}}

        {{#if (or (eq mode 'STOP_MODE')(eq mode 'STOP0_MODE')(eq mode 'STOP1_MODE')(eq mode 'STOP2_MODE')(eq mode 'STOP3_MODE'))}}
  /* Clear SLEEPDEEP bit of Cortex System Control Register */
  SCB_DisableDeepSleep();
        {{/if}}

        {{#if (not (or (eq mode 'SLEEP_MODE')(eq mode 'STANDBY_MODE')(eq mode 'SHUTDOWN_MODE')))}}
  /* Execution will never reach this point */
        {{/if}}

  return SYSTEM_OK;
}

      {{/if}}
      {{#if lp_exit}}
system_status_t mx_pwr_exit_low_power(void)
{
          {{#if (inArray @root.modules_activated 'RCC')}}
  /* This API is the runtime API generated by RCC module */
  return (mx_rcc_init());
          {{else}}
  /* RCC module is not activated in CubeMX. You must manually configure the RCC clock to exit low power mode */
  return SYSTEM_OK;
          {{/if}}
}

      {{/if}}
      {{#if (eq lp_check true)}}
uint32_t mx_pwr_system_was_low_power(void)
{
        {{#if (not (or (eq mode 'SLEEP_MODE') (eq mode 'SHUTDOWN_MODE')))}}
  /* Check the flag that indicates if the system was resumed from a low power mode */
          {{#if (or (eq mode 'STOP_MODE')(eq mode 'STOP0_MODE')(eq mode 'STOP1_MODE')(eq mode 'STOP2_MODE')(eq mode 'STOP3_MODE'))}}
  return (LL_PWR_IsActiveFlag_STOP());
          {{/if}}
          {{#if (eq mode 'STANDBY_MODE')}}
  return (LL_PWR_IsActiveFlag_SB());
          {{/if}}
        {{else}}
  /* This API returns 0 as the MCU does not have hardware flags to indicate {{mode}} */
  return 0;
        {{/if}}
}

      {{/if}}
    {{/if}}
  {{/with}}
{{~else if (eq fct 'generate_peripheral_supply_activation')~}}
{{!~ Generate the PWR LL peripheral independent supply activation function ~}}
{{!~> PWR_LL fct='generate_peripheral_supply_activation' hw_resource=@root.current_resource ~}}
{{~assign 'independent_supply_activation_count' (lookup (helper_pwr_isPeriph_independent_supply_activated hw_resource "activate") hw_resource)~}}
{{#if (and (eq hw_resource 'XSPI1') (eq @root.independent_supply_activation_count 1))}}
{{else if (and (eq hw_resource 'USB') (eq @root.independent_supply_activation_count 1))}}
{{/if}}{{!(and (eq hw_resource 'XSPI1') (eq @root.independent_supply_activation_count 1))~}}
{{~else if (eq fct 'generate_peripheral_supply_deactivation')~}}
{{!~ Generate the PWR HAL peripheral independent supply deactivation function ~}}
{{!~> PWR_HAL fct='generate_peripheral_supply_deactivation' hw_resource=@root.current_resource ~}}
{{~assign 'independent_supply_activation_count' (lookup (helper_pwr_isPeriph_independent_supply_activated hw_resource "deactivate") hw_resource)~}}
{{#if (and (eq hw_resource 'XSPI1') (eq @root.independent_supply_activation_count 0))}}
{{else if (and (eq hw_resource 'USB') (eq @root.independent_supply_activation_count 0))}}
{{/if}}{{!(and (eq hw_resource 'XSPI1') (eq @root.independent_supply_activation_count 0))~}}
{{else if (eq fct 'generate_analog_io_switch_supply')}}
{{!
 Generate the PWR LL code to set the analog IO switch supply
~}}
{{!> PWR_LL fct='generate_analog_io_switch_supply'}}
{{else}}
{{!
 Default case which should not occur
~}}
#warning "Function {{fct}} not present in partial PWR_LL_partial.hbs"
{{/if}}