{{else if (eq fct 'exported_functions_init')}}
{{!
    Generation of initialization function used in LL
}}
system_status_t {{@root.pwr_root_fct_name}}_init(void)
{
  {{#if (length @root.pins_configs)}}
    {{~assign "wkup_pin_conc_max" (helper_pwr_get_max_wakeup_settings_pin_num @root.pins_configs)~}}
    {{#if (gt @root.wkup_pin_conc_max 1)}}
{{! Content to display if length > 1, initialize parameters for wkuppin management~}}
      {{~assign "wkup_pin_init" (helper_pwr_get_ll_wkup_pin_codegen_init 'C5')~}}
      {{{@root.wkup_pin_init}}}
    {{else}}
{{! nothing to display if length <= 1~}}
    {{/if}}
  {{/if}}
  {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
  {{/RCC}}
  {{#with additional}}
    {{#if (or (eq status_pins_configuration.enable_csleep true)(eq status_pins_configuration.enable_cstop true)(eq status_pins_configuration.enable_srdstop true)(and (eq voltage_detection_configuration.pvd_configuration.enable true)(eq voltage_detection_configuration.pvd_configuration.level_selection '0')))}}
  /****************************************************************************/
  /* GPIO Configuration                                                       */
  /****************************************************************************/
      {{#> GPIO_LL fct='init_resource' resource=@root.current_resource return_if_failed='SYSTEM_POWER_ERROR'}}
      {{/GPIO_LL}}
    {{/if}}
    {{#with voltage_detection_configuration}}
      {{#if pvd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of PVD (Programmable Voltage Detector)                     */
  /****************************************************************************/
        {{#with pvd_configuration}}
          {{#if level_selection}}
            {{~assign 'voltage_reference' (helper_pwr_get_pvdin_or_vdd_level level_selection (@root.peripheralsResourceManagerAPI.getHardwareIpDescription "PWR"))~}}
            {{!~ Line break because of the helper above}}
  /* Configure PVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetPVDLevel' (concat 'LL_PWR_PVD_' @root.voltage_reference)}}

          {{/if}}
  /* Enable PVD */
  LL_PWR_EnablePVD();

          {{#if (eq enable_exti true)}}
  /* Configure PVD EXTI Line */
            {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_exti_needs}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if avd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of AVD (Analog Voltage Detector)                           */
  /****************************************************************************/
        {{#with avd_configuration}}
          {{#if level_selection}}
  /* Configure AVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetAVDLevel' (concat 'LL_PWR_AVD_VDDA_LEVEL_' level_selection)}}


          {{/if}}
  /* Enable AVD */
  LL_PWR_EnableAVD();

          {{#if (eq enable_exti true)}}
  /* Configure AVD EXTI Line */
            {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.avd_exti_needs}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if (eq enable_exti true)}}
  /* Configure PVD/AVD EXTI Line */
        {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_avd_exti_needs}}
        {{/EXTI}}
      {{/if}}
      {{#if temperature_vbat_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VBAT/Temp monitor                                       */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VBAT/Temp monitoring */
  LL_PWR_EnableMonitoring();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
      {{#if temperature_vdd_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VDD/Temp monitor                                        */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VDD/Temp monitoring */
  LL_PWR_EnableTemperatureVddMonitor();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
    {{/with}}
    {{#with ram_configuration}}
      {{#if (length @root.sram_configs)}}
  /****************************************************************************/
  /* Configuration of RAM retention                                           */
  /****************************************************************************/
  /* By default, all RAM retention is enabled */
        {{#each @root.sram_configs}}
          {{#unless pageStatus}}
            {{#if fullretention}}
  /* For {{sram}} in {{mode}} mode, memory retention is disabled */
  LL_PWR_DisableMemoryStopRetention(LL_PWR_{{sram}}_{{mode}}_RETENTION);

            {{else}}
              {{#if pageDefinesStr}}
                {{#if enabledPagesStr}}
  /* For {{sram}} in {{mode}} mode, retention is enabled only for pages {{enabledPagesStr}} */
                {{else}}
  /* For {{sram}} in {{mode}} mode, memory retention is disabled on all pages */
                {{/if}}
  uint32_t pages = {{pageDefinesStr}};
  LL_PWR_Disable{{sram}}PagesStopRetention(pages);

              {{/if}}
            {{/if}}
          {{/unless}}
        {{/each}}
      {{/if}}
    {{/with}}
    {{#if flash_low_power_configuration.enable_flash_low_power_mode}}
  /****************************************************************************/
  /* Configuration of FLASH low power mode                                    */
  /****************************************************************************/
  LL_PWR_EnableFlashLowPWRMode();

    {{/if}}
    {{#if nvm_low_power_configuration.enable_nvm_low_power_mode}}
  /****************************************************************************/
  /* Configuration of NVM low power mode                                      */
  /****************************************************************************/
  LL_PWR_EnableNVMLowPWRMode();

    {{/if}}
    {{#if battery_configuration.enable_battery_charging}}
  /****************************************************************************/
  /* Configuration of the battery charging management                         */
  /****************************************************************************/
  /* Configure battery charging resistor value */
  {{helper_common_gen_ll_code 'LL_PWR_SetBattChargResistor' (concat 'LL_PWR_BATT_CHARG_RESISTOR_' (uppercase battery_configuration.battery_charging_resistor_selection))}}

  /* Enable battery charging */
  LL_PWR_EnableBatteryCharging();

    {{/if}}
    {{#if (or (eq ucpd_configuration.enable_dead_battery_mode true) (eq ucpd_configuration.enable_ucpd_config_retention true))}}
      {{#with ucpd_configuration}}
  /****************************************************************************/
  /* Configuration of the UCPD (USB Type-C and Power Delivery) PWR features   */
  /****************************************************************************/
        {{#if enable_dead_battery_mode}}
  /* Enable Dead Battery mode */
  LL_PWR_EnableUCPDDeadBattery();

        {{/if}}
        {{#if enable_ucpd_config_retention}}
  /* Enable UCPD configuration retention in Standby Mode */
  LL_PWR_EnableUCPDRetentionStandbyMode();

        {{/if}}
      {{/with}}
    {{/if}}
    {{~assign 'enabled_pins' ''~}}
    {{#with wakeup_pins_configuration}}
      {{~assign 'pull_availability' (helper_pwr_pull_or_source @root.pins_configs)~}}
      {{~helper_pwr_breakpoint (length @root.pins_configs) @root~}}
      {{#if (length @root.pins_configs)}}
  /****************************************************************************/
  /* Wakeup Pins Configurations                                               */
  /****************************************************************************/
        {{~helper_pwr_breakpoint @root.pull_availability @root}}
        {{#each @root.pins_configs}}
          {{#if (gt pinsnum 1)}}
  {{! Content to display if length > 1, pins concanated management }}
            {{#if @root.pull_availability}}
  /* Configuration of selected Wakeup pins with pull {{pull}} and {{polarity}} polarity */
              {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'C5' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull))}}
            {{else}}
  /* Configuration of selected Wakeup pins with {{source}} and {{polarity}} polarity */
              {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'C5' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) '' (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source))}}
            {{/if~}}
            {{{@root.pull_core_code}}}

          {{else}}
  {{! content to display if length <= 1, pins not concanated management }}
            {{#if @root.pull_availability}}
  /* Configuration of selected Wakeup pins with pull {{pull}} and {{polarity}} polarity */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPull' pins (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull)}}

            {{else}}
  /* Configuration of selected Wakeup pins with {{source}} and {{polarity}} polarity    */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeupPinSelection'pins (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source)}}

            {{/if}}
          {{/if}}
          {{~assign 'enabled_pins' (helper_pwr_concatenate_pins pins @root.enabled_pins)~}}
        {{/each}}
        {{~assign 'enabled_pins' (helper_pwr_reorder_pins @root.enabled_pins)~}}
      {{/if}}
      {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Enable all configured Wakeup Pins                                        */
  /****************************************************************************/
  LL_PWR_EnableWakeUpPin({{@root.enabled_pins}});

      {{/unless}}
    {{/with}}
    {{#with io_retention}}
      {{#if (or (eq all_io true)(eq jtag_io true))}}
  /****************************************************************************/
  /* Configuration of I/O retention in standby mode                           */
  /****************************************************************************/
      {{/if}}
      {{#if all_io}}
  /* Enable I/O retention mode for all I/Os except standby I/Os and PA13, PA14, PA15, PB4 pins */
  LL_PWR_EnableIORetentionStandbyMode();

      {{/if}}
      {{#if jtag_io}}
  /* Enable I/O retention mode for PA13, PA14, PA15, and PB4 */
  LL_PWR_EnableJTAGIORetentionStandbyMode();

      {{/if}}
    {{/with}}
  return SYSTEM_OK;
  {{/with}}
}

