{{!
  Partial used for LL USART:
  how to use
  > USART_LL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
~}}
{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
{{> DMA_LL fct='get_dma_lli_variables' resource=@root.dma_resource strategy=@root.strategy}}

USART_TypeDef *{{@root.fct_name}}_init(void)
{
  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='USART'}}
{{#with basic}}
{{#if nack}}
{{assign 'nack_state' "1U"}}
{{else}}
{{assign 'nack_state' "0U"}}
{{/if}}
  LL_USART_SetSmartcardGuardTime({{@root.current_resource}}, {{guard_time_etu}}U);
  LL_USART_SetSmartcardPrescaler({{@root.current_resource}}, LL_USART_SMARTCARD_PRESCALER_DIV{{sclk_prescaler}});

  LL_USART_SetSmartcardConfig({{@root.current_resource}}, LL_USART_STOP_BIT_{{stop_bit}}, LL_USART_BITORDER_{{first_bit}},
                              LL_USART_PARITY_{{parity}}, {{@root.nack_state}}, {{auto_retry_count}}U);
{{#if clock_output}}
  {{helper_common_gen_ll_code 'LL_USART_SetSmartcardClockConfig' 'LL_USART_CLOCK_OUTPUT_ENABLED' (concat 'LL_USART_CLOCK_POLARITY_' clock_polarity) (concat 'LL_USART_CLOCK_PHASE_' clock_phase "_EDGE")}}
{{else}}
  {{helper_common_gen_ll_code 'LL_USART_SetSmartcardClockConfig' 'LL_USART_CLOCK_OUTPUT_DISABLED' (concat 'LL_USART_CLOCK_POLARITY_' clock_polarity) (concat 'LL_USART_CLOCK_PHASE_' clock_phase "_EDGE")}}
{{/if}}
  {{helper_common_gen_ll_code 'LL_USART_SetPrescaler' (concat 'LL_USART_PRESCALER_DIV' clock_prescaler)}}

{{assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)}}
  LL_USART_SetBaudRate({{@root.current_resource}}, {{round @root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{clock_prescaler}}, LL_USART_OVERSAMPLING_16,
                       {{baud_rate}}U);
{{/with}} {{! basic ~}}
{{#with additional}}
{{#if enable_fifo_mode}}
  /* Fifo configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetTXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' set_tx_fifo_threshold)}}
  {{helper_common_gen_ll_code 'LL_USART_SetRXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' set_rx_fifo_threshold)}}
  LL_USART_EnableFIFO({{@root.current_resource}});
{{/if~}}
{{#if enable_io_invert}}
  /* Tx pin level inversion configuration */
  LL_USART_SetTXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);
{{#if enable_tx_rx_swap}}
  LL_USART_SetRXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);
{{/if~}}
{{/if~}}
{{#if enable_data_invert}}
  /* Data inversion configuration */
  LL_USART_SetBinaryDataLogic({{@root.current_resource}}, LL_USART_BINARY_LOGIC_NEGATIVE);
{{/if~}}
{{#if enable_tx_rx_swap}}
  /* Tx and Rx pins swapping configuration */
  LL_USART_SetTXRXSwap({{@root.current_resource}}, LL_USART_TXRX_SWAPPED);
{{/if~}}
{{#if disable_rx_over_run_detection}}
  /* Overrun configuration */
  LL_USART_DisableOverrunDetect({{@root.current_resource}});
{{/if~}}
{{#if enable_dma_stop_on_rx_error}}
  /* DMA stop on Rx error configuration */
  LL_USART_EnableDMADeactOnRxErr({{@root.current_resource}});
{{/if~}}
{{#if enable_receiver_timeout}}
  /* DMA stop on Rx error configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetRxTimeout'(concat set_receiver_timeout 'U')}}
  LL_USART_EnableRxTimeout({{@root.current_resource}});
{{/if~}}
{{#if (eq set_tx_cplt_indication "BEFORE")}}
  /* Enable the SMARTCARD Transmit Complete before guard time Interrupt */
  LL_USART_EnableIT_TCBGT({{@root.current_resource}});
{{else}}
  /* Enable the SMARTCARD Transmit Complete Interrupt */
  LL_USART_EnableIT_TC({{@root.current_resource}});
{{/if~}}
  /* Set the SMARTCARD block length */
  {{helper_common_gen_ll_code 'LL_USART_SetBlockLength'(concat set_block_length 'U')}}
{{/with}}
  LL_USART_Enable({{@root.current_resource}});
{{> GPIO_LL fct='init_resource' resource=@root.current_resource return_if_failed='0'~}}
{{#with system}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/if~}}
{{/with}}{{! nvic ~}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='init' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='init' needs=dma_config_rx.needs~}}
{{/if}}
{{/with}}{{! dma ~}}
{{/with}}{{! system~}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> GPIO_LL fct='deinit_resource' resource=@root.current_resource~}}
{{#with system}}
{{#if nvic.enable_interruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
  LL_USART_Disable({{@root.current_resource}});
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='deinit' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='deinit' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}
{{/with}}{{! system~}}
}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='implementation'}}

{{else}}
#warning "step {{step}} in partial USART_LL not managed"
{{/if}}
