{{!
  Partial used for LL TAMP:
  how to use
  > TAMP_LL fct='xxxx' with xxxx:
    * exported_functions_init
~}}

{{!
############################
##  exported_functions_init
############################
~}}
{{#with basic}}
{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if (eq mode "Passive")}}
{{#unless @root.found_passive_tamper}}
{{assign 'found_passive_tamper' true~}}
{{/unless}}
{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
{{#unless @root.found_active_tamper}}
{{assign 'found_active_tamper' true~}}
{{/unless}}
{{/if}}{{!Active~}}
{{/if}}{{!use_channel~}}
{{/each}}{{!tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#if (eq fct 'exported_functions_init')}}
{{!
    Generation of initialization function used in LL
~}}
system_status_t {{@root.fct_name}}_init(void)
{
{{> PWR_LL fct='generate_write_protection_disable'}}

{{#if (eq @root.found_active_tamper true)}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource~}}
{{/if}}

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource sw_resource='TAMP'}}

{{#with basic}}
{{#with tamper_global_config}}
{{#with passive}}
{{#if (eq @root.found_passive_tamper true)}}
  LL_TAMP_SetConfig(LL_TAMP_PULL_UP_{{#if precharge}}ENABLE{{else}}DISABLE{{/if}},
                    LL_TAMP_DURATION_{{#if precharge}}{{precharge_duration}}RTCCLK{{else}}1RTCCLK{{/if}},
                    LL_TAMP_FILTER_{{#if passive_filter}}{{filter_type_activation}}SAMPLES{{else}}DISABLE{{/if}},
                    LL_TAMP_SAMPLFREQDIV_{{sample_frequency_div}});

{{/if}}
{{/with}}{{!passive~}}

{{#with active}}
{{#if (eq @root.found_active_tamper true)}}
  LL_TAMP_ATAMP_SetConfig(LL_TAMP_ATAMP_FILTERING_{{#if active_filter}}ENABLE{{else}}DISABLE{{/if}},
                          {{output_periode}},
                          LL_TAMP_ATAMP_SHARING_{{#if output_shared}}ENABLE{{else}}DISABLE{{/if}},
                          LL_TAMP_ATAMP_ASYNCPRES_RTCCLK{{#if (eq asynchronous_prescaler 1)}}{{else}}_{{asynchronous_prescaler}}{{/if}});

{{/if}}
{{/with}}{{!active~}}
{{/with}}{{!tamper_global_config~}}

{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_channel}}
{{#if (eq mode "Passive")}}
  LL_TAMP_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}LL_{{helper_tamp_convert _foreignKey}}{{/if}},
                           LL_TAMP_ACTIVELEVEL_{{helper_tamp_passive_trigger_convert  trigger}},
                           LL_TAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVATE_ALL{{else}}NOERASE_TAMPER{{/if}},
                           LL_TAMP_MASK_{{#if (eq mask 'MASKED')}}TAMPER{{else}}NONE{{/if}});

{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
  LL_TAMP_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}LL_{{helper_tamp_convert _foreignKey}}{{/if}}, 0, LL_TAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVATE_ALL{{else}}NOERASE_TAMPER{{/if}}, 0);

{{/if}}{{!Active~}}

{{assign 'gpio_in_resolved' (helper_tamp_get_gpio_need @root.pinoutAPI ../../../system.gpio _foreignKey)~}}
{{assign 'gpio_in_remap_define' (helper_tamp_get_remap_define @root.gpio_in_resolved "TAMP_IN2,PC1,LL_TAMP_RMP_TAMP_IN2_PA0_TO_PC1|TAMP_IN3,PA2,LL_TAMP_RMP_TAMP_IN3_PA1_TO_PA2")~}}
{{#if @root.gpio_in_remap_define}}
  LL_TAMP_EnableRemap({{@root.gpio_in_remap_define}});
{{/if}}

{{#if (eq mode "Active")}}
{{assign 'gpio_out_resolved' (helper_tamp_get_gpio_need @root.pinoutAPI ../../../system.gpio tamper_output "out")~}}
#error "Missing TAMP output LL remap table for this STM32 series"

{{/if}}
{{/if}}{{!use_channel~}}
{{/each}}{{!tampers~}}

{{#each internal_tampers}}
{{#if use_channel}}
  LL_TAMP_SetConfigInternalTampers({{#if int_tamper_label_name}}{{int_tamper_label_name}}{{else}}LL_{{helper_tamp_internal_convert _foreignKey}}{{/if}}, LL_TAMP_ITAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVE_ALL{{else}}NOERASE_TAMPER{{/if}});

{{/if}}{{!use_channel~}}
{{/each}}{{!internal_tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#with additional}}
{{#if boot_hw_key_lock}}
  LL_TAMP_LockBootHardwareKey();

{{/if}}{{!boot_hw_key_lock~}}

{{#with backup_register_protection}}
{{#if (or (not (eq backup_registers_protection_zone1 0)) (not (eq backup_registers_protection_zone2 0)))}}
{{assign 'total_zone' (add backup_registers_protection_zone1 backup_registers_protection_zone2)}}
  LL_TAMP_SetBackupRegProtection({{backup_registers_protection_zone1}}, {{@root.total_zone}});

{{/if}}{{!backup_registers_protection_zone1 ~}}
{{/with}}{{!backup_register_protection~}}

{{#if (not (helper_tamp_default_resources resource))}}
{{#if (helper_tamp_is_resource_enabled resource)}}
  /* Resources: {{helper_tamp_format_resource_names resource}} */
  LL_TAMP_EnableResourceProtection({{helper_tamp_format_resources resource "LL_TAMP_RESOURCE"}});

{{/if}}{{!helper_tamp_is_resource_enabled~}}
{{#if (helper_tamp_is_resource_disabled resource "_31")}}
  /* Resources: Backup registers */
  LL_TAMP_DisableResourceProtection(LL_TAMP_RESOURCE_31);
{{/if}}{{!helper_tamp_is_resource_disabled~}}
{{/if}}{{!use_resource_protection~}}
{{/with}}{{!additional~}}

{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for TAMP */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource false)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}

{{/if}}

  return SYSTEM_OK;
}

void {{@root.fct_name}}_deinit(void)
{
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Disable the interuption for TAMP */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
}
{{#with security_privilege}}
  {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
   * Full access security path:
   * Configure RTC resources security/privilege attributes
   */

 {{> PWR_LL fct='generate_write_protection_disable'}}

 {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
 {{/RCC}}


{{#with security}}
{{assign "access_levels_all_states" (helper_tamp_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure security attributes for TAMP peripheral */
  LL_TAMP_SetSecAttr(LL_TAMP_SEC_ITEM_TAMPSEC | LL_TAMP_SEC_ITEM_CNT1SEC, LL_TAMP_ATTR_SEC);
{{else}}
{{assign "security_items" (helper_tamp_get_attribute_items @root.current_layer 'SEC' access_levels)}}
{{#unless (eq security_items '')}}
  /* Configure security attributes for TAMP peripheral */
  LL_TAMP_SetSecAttr({{@root.security_items}}, LL_TAMP_ATTR_SEC);
{{else}}
{{log "No specific security attributes require configuration for this TAMP instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No security attributes (all) require configuration for this TAMP instance."}}
{{/unless}}
{{/with}}

{{#with privilege}}
{{assign "access_levels_all_states" (helper_tamp_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure privilege attributes for TAMP peripheral */
  LL_TAMP_SetPrivAttr(LL_TAMP_PRIV_ITEM_TAMPPRIV | LL_TAMP_PRIV_ZONE_BKPRWPRIV | LL_TAMP_PRIV_ZONE_BKPWPRIV | LL_TAMP_PRIV_ITEM_CNT1PRIV, LL_TAMP_ATTR_PRIV);
{{else}}
{{assign "privilege_items" (helper_tamp_get_attribute_items @root.current_layer 'PRIV' access_levels)}}
{{#unless (eq privilege_items '')}}
  /* Configure privilege attributes for TAMP peripheral */
  LL_TAMP_SetPrivAttr({{@root.privilege_items}}, LL_TAMP_ATTR_PRIV);
{{else}}
{{log "No specific privilege attributes require configuration for this TAMP instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No privilege attributes (all) require configuration for this TAMP instance."}}
{{/unless}}
{{/with}}

{{#> GPIO_LL fct='gpio_config_security' resource=@root.current_resource}}{{/GPIO_LL}}

{{#if illegal_access}}
  /* Enable HSEM IAC interrupt */
  LL_RIF_IAC_EnableIT(LL_RIF_TAMP);
{{/if}}

  return SYSTEM_OK;
}
{{/with}}
{{else}}
#warning "Function {{fct}} not present in partial TAMP_partial.hbs"
{{/if}}
