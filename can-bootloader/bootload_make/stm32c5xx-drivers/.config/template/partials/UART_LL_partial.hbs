    * exported_functions_gethandle_prototype
~}}

{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
{{#startsWith 'UART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}
{{#startsWith 'USART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}
{{#startsWith 'LPUART' @root.current_resource}}
{{assign 'prefix' 'LPUART'~}}
{{assign 'instance_type' 'LPUART'~}}
{{/startsWith}}

{{> DMA_LL fct='get_dma_lli_variables' resource=@root.dma_resource strategy=@root.strategy}}

USART_TypeDef *{{@root.fct_name}}_init(void)
{
  uint32_t reg_temp;

  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}
  LL_USART_ConfigAsyncMode({{@root.current_resource}});

  reg_temp = (LL_USART_DATAWIDTH_{{basic.word_length}}_BIT | LL_USART_PARITY_{{basic.parity}}
              | LL_USART_DIRECTION_{{basic.direction}} | LL_USART_OVERSAMPLING_{{additional.over_sampling}});
  LL_{{@root.prefix}}_ConfigXfer({{@root.current_resource}}, reg_temp, LL_USART_STOP_BIT_{{basic.stop_bit}});

  {{helper_common_gen_ll_code 'LL_USART_SetHWFlowCtrl'(concat 'LL_USART_HWCONTROL_' basic.hw_flow_ctl)}}

  {{helper_common_gen_ll_code 'LL_USART_SetPrescaler'(concat 'LL_USART_PRESCALER_DIV' additional.clock_prescaler)}}

{{#if additional.one_bit_sampling}}
  LL_USART_EnableOneBitSample({{@root.current_resource}});

{{/if}}
{{assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)}}
{{#if (eq @root.prefix "LPUART")}}
  LL_LPUART_SetBaudRate({{@root.current_resource}}, {{round @root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{additional.clock_prescaler}}, {{basic.baud_rate}});
{{else}}
  LL_USART_SetBaudRate({{@root.current_resource}}, {{round @root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{additional.clock_prescaler}}, LL_USART_OVERSAMPLING_{{additional.over_sampling}},
                       {{basic.baud_rate}});
{{/if}}
{{#if (eq basic.mode "half_duplex_single_wire_mode")}}
  /* Half duplex configuration */
  LL_USART_ConfigHalfDuplexMode({{@root.current_resource}});

{{else if (eq basic.mode "multiprocessor_communication")}}
  /* Multiprocessor configuration */
{{#if (eq additional.wakeup_method "ADDRESS_MARK")}}
  {{helper_common_gen_ll_code 'LL_USART_SetWakeUpMethod'(concat 'LL_USART_WAKEUP_METHOD_' additional.wakeup_method)}}
  LL_USART_ConfigNodeAddress({{@root.current_resource}}, LL_USART_ADDRESS_DETECT_{{additional.address_length}}_BIT, {{additional.address}});

{{/if~}}
  LL_USART_ConfigMultiProcessMode({{@root.current_resource}});

  LL_USART_EnableMuteMode({{@root.current_resource}});

{{else if (eq basic.mode "lin")}}
  /* LIN configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetLINBrkDetectionLen'(concat 'LL_USART_LIN_BREAK_DETECT_' additional.set_lin_mode_break_detect_length '_BIT')}}

  LL_USART_ConfigLINMode({{@root.current_resource}});

{{/if~}}
{{#with additional}}
{{#if enable_rs485_mode}}
  {{helper_common_gen_ll_code 'LL_USART_SetDESignalPolarity'(concat 'LL_USART_DE_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_USART_ConfigDETime'(concat assertion_time_samples 'U') (concat deassertion_time_samples 'U')}}
  LL_USART_EnableDEMode({{@root.current_resource}});

{{/if~}}
{{#if enable_fifo_mode}}
  /* Fifo configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetTXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' set_tx_fifo_threshold)}}
  {{helper_common_gen_ll_code 'LL_USART_SetRXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' set_rx_fifo_threshold)}}

  LL_USART_EnableFIFO({{@root.current_resource}});

{{/if~}}
{{#if enable_receiver_timeout}}
  {{helper_common_gen_ll_code 'LL_USART_SetRxTimeout'(concat set_receiver_timeout 'U')}}
  LL_USART_EnableRxTimeout({{@root.current_resource}});

{{/if~}}

{{#if am_enable_packet_trigger}}
  LL_USART_AM_ConfigPacketTrigger({{@root.current_resource}}, LL_USART_AM_TRIG_{{trigger_polarity}}, LL_{{@root.prefix}}_AM_TRIG_{{source.source}},
                                  {{packet_size_byte}});
{{#if am_enable_idle}}
  LL_USART_Enable_AutonomousSendIdleFrame({{@root.current_resource}});

{{/if}}
  LL_USART_DisableDirectionTx({{@root.current_resource}});

  LL_USART_Enable_SelectedTrigger({{@root.current_resource}});

{{/if~}}
{{#if set_config_auto_baud_rate}}
{{#if (not (eq set_config_auto_baud_rate "DISABLE"))}}
  /* Auto baud rate mode configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetAutoBaudRateMode'(concat 'LL_USART_AUTO_BAUD_DETECT_ON_' set_config_auto_baud_rate)}}
  LL_USART_EnableAutoBaudRate({{@root.current_resource}});
{{/if~}}
{{/if~}}
{{#if enable_tx_pin_level_invert}}
  /* Tx pin level inversion configuration */
  LL_USART_SetTXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if enable_rx_pin_level_invert}}
  /* Rx pin level inversion configuration */
  LL_USART_SetRXPinLevel({{@root.current_resource}}, LL_USART_RXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if enable_data_invert}}
  /* Data inversion configuration */
  LL_USART_SetBinaryDataLogic({{@root.current_resource}}, LL_USART_BINARY_LOGIC_NEGATIVE);

{{/if~}}
{{#if enable_tx_rx_swap}}
  /* Tx and Rx pins swapping configuration */
  LL_USART_SetTXRXSwap({{@root.current_resource}}, LL_USART_TXRX_SWAPPED);

{{/if~}}
{{#if (not rx_over_run_detection)}}
  /* Overrun configuration */
  LL_USART_DisableOverrunDetect({{@root.current_resource}});

{{/if~}}
{{#if enable_dma_stop_on_rx_error}}
  /* DMA stop on Rx error configuration */
  LL_USART_EnableDMADeactOnRxErr({{@root.current_resource}});

{{/if~}}
{{#if enable_msb_first}}
  /* MSB first configuration */
  LL_USART_SetTransferBitOrder({{@root.current_resource}}, LL_USART_BITORDER_MSB_FIRST);

{{/if~}}
{{#if enable_stop_mode}}
  /* Wake up from low power mode configuration */
  LL_USART_EnableInStopMode({{@root.current_resource}});
{{/if~}}
{{/with}}

{{> GPIO_LL fct='init_resource' resource=@root.current_resource return_if_failed='0'~}}

{{#with system}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/if~}}
{{/with}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='init' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='init' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}
{{/with}}

  LL_USART_Enable({{@root.current_resource}});
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{#if system.nvic.enable_interruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
  LL_USART_Disable({{@root.current_resource}});

{{> GPIO_LL fct='deinit_resource' resource=@root.current_resource~}}

{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_LL fct='deinit' needs=dma_config_tx.needs~}}
{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_LL fct='deinit' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}
{{/with}}
}

{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='implementation'}}

{{else}}
#warning "step {{fct}} in partial UART_HAL not managed"
{{/if~}}
