{{!--
  Partial used for HAL CORDIC:
  how to use
  > CORDIC_HAL fct='xxxx' with xxxx:
    * init
    * deinit
--}}
{{!==================== partial function: init ====================~}}
{{#if (eq fct 'init')}}
hal_cordic_handle_t *{{@root.fct_name}}_init(void)
{
  hal_cordic_config_t cordic_config;

  if (HAL_CORDIC_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }
  /* configure RCC clock activation*/
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{#with basic}}
  /* Basic Configuration ***************************************************/
{{#if (eq function "NATURALLOG")}}
  cordic_config.function       = HAL_CORDIC_FUNCTION_NATURAL_LOG;
{{else}}
{{#if (eq function "SQUAREROOT")}}
  cordic_config.function       = HAL_CORDIC_FUNCTION_SQUARE_ROOT;
{{else}}
  cordic_config.function       = HAL_CORDIC_FUNCTION_{{function}};
{{/if}}
{{/if}}
  cordic_config.in_width       = HAL_CORDIC_IN_WIDTH_{{in_width}}_BIT;
  cordic_config.nb_arg         = HAL_CORDIC_NB_ARG_{{nb_arg}};
  cordic_config.out_width      = HAL_CORDIC_OUT_WIDTH_{{out_width}}_BIT;
  cordic_config.nb_result      = HAL_CORDIC_NB_RESULT_{{nb_result}};
  cordic_config.scaling_factor = HAL_CORDIC_SCALING_FACTOR_{{scaling_factor}};
  cordic_config.precision      = HAL_CORDIC_PRECISION_{{precision}}_CYCLE;
{{/with}}
  if (HAL_CORDIC_SetConfig(&h{{uppercase @root.current_resource}},&cordic_config) != HAL_OK)
  {
    return NULL;
  }
{{#with system}}
{{#with dma}}
{{#if enable_dma_wr}}
  /* Configure the DMA Write request */
{{~assign 'found_cordic_dma_write' true}}
{{#> DMA_HAL fct='init' needs=dma_config_wr.needs}}
{{/DMA_HAL}}
  /* Link the write DMA handle to the CORDIC handle */
  if (HAL_CORDIC_SetWriteDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{! enable_dma_wr}}
{{~#if enable_dma_rd}}
  /* Configure the DMA Read request */
{{~assign 'found_cordic_dma_read' true}}
{{#> DMA_HAL fct='init' needs=dma_config_rd.needs}}
{{/DMA_HAL}}
  /* Link the Read DMA handle to the CORDIC handle */
  if (HAL_CORDIC_SetReadDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{! enable_dma_rd}}
{{/with}}
{{~#with nvic}}
{{~#if (eq interruption_global true)}}
  /* Enable the interruption for CORDIC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/CORTEX}}
{{/if}}
{{/with}}
{{/with}}{{! system}}
  return &h{{@root.current_resource}};
}
{{!==================== partial function: deinit ====================~}}
{{else if (eq fct 'deinit')}}
void {{@root.fct_name}}_deinit(void)
{
{{#if (eq system.nvic.interruption_global true)}}
  /* Disable the interruption for CORDIC */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}
  /* CORDIC De-intialization */
  (void)HAL_CORDIC_DeInit(&h{{@root.current_resource}});
  /* Disable CORDIC Clock */
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{#if system.dma.enable_dma_wr}}
{{#> DMA_HAL fct='deinit' needs=system.dma.dma_config_wr.needs}}
{{/DMA_HAL~}}
{{/if}}
{{#if system.dma.enable_dma_rd}}
{{#> DMA_HAL fct='deinit' needs=system.dma.dma_config_rd.needs}}
{{/DMA_HAL~}}
{{/if}}
}
{{else}}
#warning "step {{fct}} in partial CORDIC_HAL not managed"
{{/if}}