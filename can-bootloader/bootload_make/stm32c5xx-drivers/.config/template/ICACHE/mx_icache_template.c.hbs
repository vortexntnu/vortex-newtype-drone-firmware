hal_icache_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_ICACHE_Init(&h{{@root.current_resource}}, HAL_{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }
      {{~#with basic}}
        {{~#if (eq associativity_mode '2WAYS')}}


  /* Associativity mode set to default value 2-ways */
        {{~else}}


  if (HAL_ICACHE_SetAssociativityMode(&h{{@root.current_resource}}, HAL_ICACHE_ASSOCIATIVITY_{{associativity_mode}}) != HAL_OK)
  {
    return NULL;
  }
        {{~/if}}
      {{~/with}}{{! basic}}
      {{~#with additional}}
        {{~#each remap_regions}}
          {{~#if use_region}}
            {{~#unless @root.found_region}}
              {{~assign 'found_region' true}}


  hal_icache_region_config_t p_region_config = {0};
            {{~/unless}}


  p_region_config.size          = HAL_ICACHE_REGION_SIZE_{{size}}MBYTES;
  p_region_config.base_address  = 0x{{#if (eq base_address 0)}}00000000{{else}}{{uppercase (dec2hex base_address)}}{{/if}};
  p_region_config.remap_address = 0x{{#if (eq remap_address 0)}}00000000{{else}}{{uppercase (dec2hex remap_address)}}{{/if}};
  p_region_config.master_port   = HAL_ICACHE_MASTER{{master_port}}_PORT;
  p_region_config.output_burst  = HAL_ICACHE_BURST_{{output_burst}};

  if (HAL_ICACHE_SetConfigRemapRegion(&h{{@root.current_resource}}, HAL_ICACHE_{{_foreignKey}}, &p_region_config) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_ICACHE_EnableRemapRegion(&h{{@root.current_resource}}, HAL_ICACHE_{{_foreignKey}}) != HAL_OK)
  {
    return NULL;
  }
          {{~/if}}
        {{~/each}}
        {{~#if (and monitors.hit_monitor monitors.miss_monitor)}}


  HAL_ICACHE_EnableMonitors(&h{{@root.current_resource}}, HAL_ICACHE_MONITOR_ALL);

        {{~else}}
          {{~#if monitors.hit_monitor}}


  HAL_ICACHE_EnableMonitors(&h{{@root.current_resource}}, HAL_ICACHE_MONITOR_HIT);
          {{~/if}}
          {{~#if monitors.miss_monitor}}


  HAL_ICACHE_EnableMonitors(&h{{@root.current_resource}}, HAL_ICACHE_MONITOR_MISS);
          {{~/if}}
        {{~/if}}
      {{~/with}}{{! additional}}
      {{~#with system.nvic}}
        {{~#if enable_interruption}}


  /* Enable the interuption for ICACHE */
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource irq_handler_generation)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
      {{~/with}}{{! system.nvic}}


  return &h{{@root.current_resource}};
}

