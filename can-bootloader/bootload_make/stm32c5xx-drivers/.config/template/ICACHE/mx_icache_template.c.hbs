ICACHE_TypeDef *{{@root.fct_name}}_init(void)
{
      {{~#with basic}}

  {{!helper_common_gen_ll_code 'LL_ICACHE_SetMode' @root.current_resource (concat 'LL_ICACHE_' associativity_mode)}}
        {{~#if (eq associativity_mode '2WAYS')}}
  //LL_ICACHE_SetMode({{@root.current_resource}}, LL_ICACHE_2WAYS);
        {{~else}}
  LL_ICACHE_SetMode({{@root.current_resource}}, LL_ICACHE_1WAY);
        {{~/if}}
      {{~/with}}{{!basic}}
      {{~#with additional}}
        {{~#each remap_regions}}
          {{~#if use_region}}

  LL_ICACHE_SetConfigRemapRegion({{@root.current_resource}}, LL_ICACHE_{{_foreignKey}},
                                 0x{{#if (eq base_address 0)}}00000000{{else}}{{uppercase (dec2hex base_address)}}{{/if}} /* Base Address*/,
                                 0x{{#if (eq remap_address 0)}}00000000{{else}}{{uppercase (dec2hex remap_address)}}{{/if}} /* Remap Address*/,
                                 LL_ICACHE_REGIONSIZE_{{size}}MB,
                                 LL_ICACHE_MASTER{{master_port}}_PORT,
                                 LL_ICACHE_OUTPUT_BURST_{{output_burst}});

  LL_ICACHE_EnableRegion({{@root.current_resource}}, LL_ICACHE_{{_foreignKey}});

          {{~/if}}
        {{~/each}}
        {{~#if (and monitors.hit_monitor monitors.miss_monitor)}}


  LL_ICACHE_EnableMonitors({{@root.current_resource}}, LL_ICACHE_MONITOR_ALL);

        {{~else}}
          {{~#if monitors.hit_monitor}}


  LL_ICACHE_EnableMonitors({{@root.current_resource}}, HAL_ICACHE_MONITOR_HIT);
          {{~/if}}
          {{~#if monitors.miss_monitor}}


  LL_ICACHE_EnableMonitors({{@root.current_resource}}, HAL_ICACHE_MONITOR_MISS);
          {{~/if}}
        {{~/if}}
      {{~/with}}{{!additional}}
      {{~#with system.nvic}}
        {{~#if enable_interruption}}


  /* Enable the interuption for ICACHE */
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource false)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
      {{~/with}}


  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
      {{~#with system.nvic}}
        {{~#if enable_interruption}}

{{> CORTEX fct='deinit' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}{{! enable_interruption}}
      {{~/with}}{{! system.nvic}}


  /* interrupts disabled */
  LL_ICACHE_DisableIT({{@root.current_resource}}, LL_ICACHE_IER_ALL);

  /* Clear any pending flags */
  LL_ICACHE_ClearFlag({{@root.current_resource}}, LL_ICACHE_FCR_ALL);

  /* Reset monitors */
  LL_ICACHE_ResetMonitors({{@root.current_resource}}, LL_ICACHE_MONITOR_ALL);

  /* Disable monitors and ICACHE, 2_ways associative mode is set */
  LL_ICACHE_WRITE_REG({{@root.current_resource}}, CR, LL_ICACHE_2WAYS);

  /* Reset and disable remapped remap_regions */
  LL_ICACHE_WRITE_REG({{@root.current_resource}}, CRR0, 0x00000200U);
  LL_ICACHE_WRITE_REG({{@root.current_resource}}, CRR1, 0x00000200U);
  LL_ICACHE_WRITE_REG({{@root.current_resource}}, CRR2, 0x00000200U);
  LL_ICACHE_WRITE_REG({{@root.current_resource}}, CRR3, 0x00000200U);
}
