  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.tim_cxt.info.layer~}}
  {{~log "TIM template current_resource:" @root.current_resource~}}
  {{#if (eq @root.current_layer 'HAL')}}
static hal_tim_handle_t h{{@root.current_resource}};
  {{/if}}
{{/each}}
{{#if (eq @root.current_layer 'HAL')}}
