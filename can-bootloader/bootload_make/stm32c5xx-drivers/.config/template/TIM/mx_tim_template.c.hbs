{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
{{assign 'IsEnableDithering' false~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#with @root.tim_cxt}}
{{#if (eq @root.current_layer 'HAL')}}
hal_tim_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_TIM_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{#with basic}}
{{#with time_base}}
{{#unless (eq frequency undefined)}}
  /* Timer configuration to reach the output frequency at {{frequency}} */
{{else}}
  /* Timer configuration with external clock */
{{/unless}}
  hal_tim_config_t config;
  config.prescaler              = {{clock_source_configuration.prescaler}};
  config.counter_mode           = HAL_TIM_COUNTER_{{counter.counter_mode}};
  {{assign 'period_value_hex' (uppercase (dec2hex counter.period))~}}
  config.period                 = 0x{{#if (eq counter.period 0)}}00000000{{else}}{{@root.period_value_hex}}{{/if}};
{{#if counter.repetition_counter}}
  config.repetition_counter     = {{counter.repetition_counter}};
{{else}}
  config.repetition_counter     = 0;
{{/if}}
{{#with clock_source_configuration}}
{{#if (eq clock_source 'ENCODER_MODE')}}
  config.clock_sel.clock_source = HAL_TIM_CLK_{{encoder_mode}};
{{else}}
  config.clock_sel.clock_source = HAL_TIM_CLK_{{clock_source}};
{{/if}}
{{#if (eq clock_source 'EXTERNAL_MODE1')}}
{{#if (eq trigger_input 'ITR')}}
  config.clock_sel.trigger      = HAL_TIM_TRIG_{{uppercase internal_trigger.ip_signal}};
{{else}}
  config.clock_sel.trigger      = HAL_TIM_TRIG_{{uppercase trigger_input}};
{{/if}}
{{/if}}
  {{assign 'found_SetConfig' true~}}
  if (HAL_TIM_SetConfig(&h{{@root.current_resource}}, &config) != HAL_OK)
  {
    return NULL;
  }

{{#if external_trigger}}
  /* Configure the external trigger input */
  hal_tim_ext_trig_config_t ext_trig;
  ext_trig.source         = HAL_TIM_EXT_TRIG_{{@root.current_resource}}_{{helper_tim_convert_etr external_trigger.source}};
  ext_trig.polarity       = HAL_TIM_EXT_TRIG_{{clock_polarity}};
  ext_trig.filter         = HAL_TIM_{{clock_filter}};
  ext_trig.prescaler      = HAL_TIM_EXT_TRIG_DIV{{clock_prescaler}};
{{#if clock_sync_prescaler}}
  ext_trig.sync_prescaler = HAL_TIM_EXT_TRIG_SYNC_DIV{{clock_sync_prescaler}};
{{/if}}
  {{assign 'found_SetExternalTriggerInput_Clock' true~}}
  HAL_TIM_SetExternalTriggerInput(&h{{@root.current_resource}}, &ext_trig);

{{/if}}{{!external_trigger~}}
{{/with}}{{!clock_source_configuration~}}
{{#with counter}}
{{#if one_pulse_mode}}
  {{assign 'found_SetOnePulseMode' true~}}
  if (HAL_TIM_EnableOnePulseMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{!one_pulse_mode~}}
{{#if dithering}}
  {{assign 'IsEnableDithering' true~}}
  {{assign 'found_EnableDithering' true~}}
  if (HAL_TIM_EnableDithering(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_TIM_SetDitheredPeriod(&h{{@root.current_resource}}, 0x{{#if (eq period 0)}}00000000{{else}}{{@root.period_value_hex}}{{/if}}, HAL_TIM_DITHERING_{{period_dithering_pattern}}_16) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{!dithering~}}
{{/with}}{{!counter~}}
{{/with}}{{!time_base~}}
{{#with sampling_clock}}
