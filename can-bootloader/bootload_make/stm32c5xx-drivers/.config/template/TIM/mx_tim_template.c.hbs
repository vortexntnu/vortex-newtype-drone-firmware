{{#if clock_division}}
  if (HAL_TIM_SetDTSPrescaler(&h{{@root.current_resource}}, HAL_TIM_DTS_DIV{{clock_division}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{!clock_division~}}
{{#if clock_division2}}
  if (HAL_TIM_SetDTS2Prescaler(&h{{@root.current_resource}}, HAL_TIM_DTS2_DIV{{clock_division2}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{!clock_division2}}
{{/with}}{{!sampling_clock~}}
{{#if autoreload_preload}}
  {{assign 'found_EnableAutoReloadPreload' true~}}
  if (HAL_TIM_EnableAutoReloadPreload(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{!autoreload_preload~}}
{{/with}}{{!basic~}}
