{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macros ------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' 0~}}
{{#each @root.instances~}}
{{assign 'crc_cxt' config~}}
{{log "CRC template crc_cxt:" (toJSON @root.crc_cxt)~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.crc_cxt.info.layer~}}
{{log "CRC template current_resource:" @root.current_resource~}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_exist 0)}}
static hal_crc_handle_t h{{uppercase @root.current_resource}};
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}
