{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'CORDIC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "CORDIC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{assign 'dma_resource' @root.codegen_ctxt.dma_resource~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}


/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototypes ----------------------------------------------*/
/* Exported variables by reference -------------------------------------------*/
{{assign 'hal_handle_exist' false~}}
{{assign 'nvic_context' 'undefined'~}}
{{#each @root.instances~}}
  {{~assign 'cordic_cxt' config~}}
  {{~log "CORDIC template cordic_cxt:" (toJSON @root.cordic_cxt)~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.cordic_cxt.info.layer~}}
  {{~log "CORDIC template current_resource:" @root.current_resource~}}
{{#if (eq @root.current_layer 'HAL')}}
{{#unless @root.hal_handle_exist}}
{{~assign 'hal_handle_exist' true~}}
static hal_cordic_handle_t h{{@root.current_resource}};
{{/unless}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource strategy=@root.codegen_ctxt.strategy}}
{{else}}
{{> DMA_LL fct='get_dma_lli_variables' resource=@root.current_resource strategy=@root.codegen_ctxt.strategy}}
{{/if}}
{{/each}}

{{assign 'hal_handle_exist' 0~}}
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
{{assign 'cordic_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'name' @root.cordic_cxt.name~}}
{{assign 'current_layer' @root.cordic_cxt.info.layer~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{assign 'lut_table'   (helper_cordic_get_lut_table 'V1')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for CORDIC in {{@root.current_layer}} layer                                 */
/******************************************************************************/
{{#with @root.cordic_cxt}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}

{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL
~}}
{{> CORDIC_HAL fct='init'}}
{{!
    Generation of de-initialization function used in HAL
~}}
{{> CORDIC_HAL fct='deinit'}}

{{!
    Generation of getHandle functions used in HAL
~}}
hal_cordic_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{else}}
{{assign 'nvic_generate_handler' false~}}
{{!
    Generation of initialization function used in LL
~}}
{{> CORDIC_LL fct='init'}}
{{!
    Generation of de-initialization function used in LL
~}}
{{> CORDIC_LL fct='deinit'}}

{{> DMA_LL fct='get_dma_lli_reg' resource=@root.current_resource strategy=@root.codegen_ctxt.strategy type='implementation'}}

{{/if}}
{{#with security_privilege}}
{{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
    Full access security path:
    - Enable clock for RIF/RCC peripherals
    - Configure the security/privilege items for CORDIC peripheral
    - other CORDIC systems security/privilege configuration if any (DMA)
    */

{{#> RIF fct='rif_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/RIF}}
{{#> GTZC fct='gtzc_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/GTZC}}

  {{#if (eq @root.current_layer 'HAL')~}}
{{#> DMA_HAL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_HAL}}
  {{else}}
{{#> DMA_LL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_LL}}
  {{/if}}

  return SYSTEM_OK;
}
{{/with}}
{{/with}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='implementation' component='CORDIC'}}
{{/helper_common_beautifier}}
