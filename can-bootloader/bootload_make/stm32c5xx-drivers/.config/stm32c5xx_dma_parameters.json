{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:DMA",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/dma_helpers.js",
      "accessor": "dma_helpers"
    }
  ],
  "properties": {
    "parameters": {
      "title": "DMA Parameters",
      "configFor": [
        "need.dma.channels"
      ],
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$isNeed"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_DMA_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$isNeed"
                }
              ]
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "dma_mode": {
              "title": "Mode",
              "description": "Select transfer sequencing: direct, linked-list or circular.",
              "type": "integer",
              "oneOf": [
                {
                  "title": "Direct transfer",
                  "const": 0
                },
                {
                  "title": "Linked list transfer",
                  "const": 1,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$isNeed)"
                    }
                  ]
                },
                {
                  "title": "Circular transfer",
                  "const": 2,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($isNeed)"
                    }
                  ]
                }
              ],
              "default": 0
            },
            "request": {
              "title": "Peripheral request",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "$isNeed"
                }
              ],
              "objectType": "query",
              "query": {
                "entity": "dma.channel.interconnect.request",
                "parent": "$resource.id",
                "where": "$entity.instance === $owner"
              }
            },
            "direction": {
              "title": "Direction",
              "type": "string",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode != 1",
                  "message": "DMA mode must be direct or circular"
                }
              ],
              "oneOf": [
                {
                  "title": "Memory to memory",
                  "const": "MEMORY_TO_MEMORY"
                },
                {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$isNeed"
                    }
                  ],
                  "title": "Peripheral to memory",
                  "const": "PERIPH_TO_MEMORY"
                },
                {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$isNeed"
                    }
                  ],
                  "title": "Memory to peripheral",
                  "const": "MEMORY_TO_PERIPH"
                }
              ],
              "default": "MEMORY_TO_MEMORY"
            },
            "src_inc": {
              "title": "Source address incrementing",
              "type": "string",
              "description": "Select whether the source address is incremented by the data size after each transfer (reading from consecutive memory locations) or the source address remains fixed (useful for reading repeatedly from a single register).",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode != 1",
                  "message": "DMA mode must be direct or circular"
                }
              ],
              "oneOf": [
                {
                  "title": "Fixed",
                  "const": "FIXED"
                },
                {
                  "title": "Incremented",
                  "const": "INCREMENTED"
                }
              ],
              "default": "FIXED"
            },
            "dest_inc": {
              "title": "Destination address incrementing",
              "type": "string",
              "description": "Select whether the destination address is incremented by the data size after each transfer (writing to consecutive memory location) or destination address remains fixed (useful for writing repeatedly to a single register ).",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode != 1",
                  "message": "DMA mode must be direct or circular"
                }
              ],
              "oneOf": [
                {
                  "title": "Fixed",
                  "const": "FIXED"
                },
                {
                  "title": "Incremented",
                  "const": "INCREMENTED"
                }
              ],
              "default": "FIXED"
            },
            "src_data_width": {
              "title": "Source data width",
              "type": "string",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode != 1",
                  "message": "DMA mode must be direct or circular"
                }
              ],
              "oneOf": [
                {
                  "title": "Byte",
                  "const": "BYTE"
                },
                {
                  "title": "Half-word",
                  "const": "HALFWORD"
                },
                {
                  "title": "Word",
                  "const": "WORD"
                },
                {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64)"
                    }
                  ],
                  "title": "Double-word",
                  "const": "DOUBLEWORD"
                }
              ],
              "default": "BYTE"
            },
            "dest_data_width": {
              "title": "Destination data width",
              "type": "string",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode != 1",
                  "message": "DMA mode must be direct or circular"
                }
              ],
              "oneOf": [
                {
                  "title": "Byte",
                  "const": "BYTE"
                },
                {
                  "title": "Half-word",
                  "const": "HALFWORD"
                },
                {
                  "title": "Word",
                  "const": "WORD"
                },
                {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64)"
                    }
                  ],
                  "title": "Double-word",
                  "const": "DOUBLEWORD"
                }
              ],
              "default": "BYTE"
            },
            "priority": {
              "title": "Priority",
              "type": "string",
              "description": "Select the priority level for the channel.",
              "oneOf": [
                {
                  "title": "Low weight low",
                  "const": "LOW_WEIGHT_LOW"
                },
                {
                  "title": "Low weight medium",
                  "const": "LOW_WEIGHT_MID"
                },
                {
                  "title": "Low weight high",
                  "const": "LOW_WEIGHT_HIGH"
                },
                {
                  "title": "High",
                  "const": "HIGH"
                }
              ],
              "default": "LOW_WEIGHT_LOW"
            },
            "node_fetch_port": {
              "title": "Node fetch port",
              "type": "integer",
              "description": "Select which master port fetches the node in circular mode.",
              "oneOf": [
                {
                  "title": "Port 0",
                  "const": 0
                },
                {
                  "title": "Port 1",
                  "const": 1
                }
              ],
              "actions": [
                {
                  "type": "include",
                  "condition": "$isNeed && ($resource.features.master_ports.length>1)"
                },
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode == 2",
                  "message": "DMA mode must be circular"
                }
              ],
              "default": 0
            },
            "linked_list_fetch_port": {
              "title": "Linked-list fetch port",
              "type": "integer",
              "description": "Select which master port fetches nodes in linked-list mode.",
              "oneOf": [
                {
                  "title": "Port 0",
                  "const": 0
                },
                {
                  "title": "Port 1",
                  "const": 1
                }
              ],
              "actions": [
                {
                  "type": "include",
                  "condition": "(!$isNeed) && ($resource.features.master_ports.length>1)"
                },
                {
                  "type": "enable",
                  "condition": "$config.basic.dma_mode == 1",
                  "message": "DMA mode must be linked-list"
                }
              ],
              "default": 0
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "actions": [
            {
              "type": "enable",
              "condition": "$config.basic.dma_mode != 1",
              "message": "DMA mode must be direct or circular"
            }
          ],
          "properties": {
            "access_ports_xfer": {
              "title": "Access ports transfer",
              "type": "object",
              "description": "Select which master ports the channel uses.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.master_ports.length>1"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set access port",
                  "description": "Enable manual selection of source/destination ports.",
                  "type": "boolean",
                  "default": false
                },
                "dma_channel_source_port": {
                  "title": "Source",
                  "type": "integer",
                  "description": "Allocate the master port for the source transfer.",
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.access_ports_xfer.configuration==false"
                    }
                  ],
                  "default": 0
                },
                "dma_channel_destination_port": {
                  "title": "Destination",
                  "type": "integer",
                  "description": "Allocate the master port for the destination transfer.",
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.access_ports_xfer.configuration==false"
                    }
                  ],
                  "default": 0
                }
              }
            },
            "burst_xfer": {
              "title": "Burst transfer",
              "type": "object",
              "description": "Select length for burst accesses.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.g_transfers.burst==true"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set burst",
				  "description": "Enable burst length selection.",
                  "type": "boolean",
                  "default": false
                },
                "dma_channel_source_burst": {
                  "title": "Source",
                  "type": "integer",
                  "description": "Set how many beats per source burst.",
                  "minimum": 1,
                  "maximum": 64,
                  "unit": "Beat",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.burst_xfer.configuration==false"
                    }
                  ],
                  "default": 1
                },
                "dma_channel_destination_burst": {
                  "title": "Destination",
                  "type": "integer",
                  "description": "Set how many beats per destination burst.",
                  "minimum": 1,
                  "maximum": 64,
                  "unit": "Beat",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.burst_xfer.configuration==false"
                    }
                  ],
                  "default": 1
                }
              }
            },
            "trigger_xfer": {
              "title": "Trigger transfer",
              "type": "object",
              "description": "When enabled, the channel waits for the specified external signal before starting the transfer.",
              "properties": {
                "configuration": {
                  "title": "Set trigger",
				  "description": "Enable trigger source and mode options.",
                  "type": "boolean",
                  "default": false
                },
                "dma_channel_trigger_source": {
                  "title": "Source",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.trigger_xfer.configuration==false"
                    },
                    {
                      "type": "info",
                      "message": "The selected interconnect must be configured manually."
                    }
                  ],
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "entity": "dma.channel.interconnect.trigger",
                    "parent": "$resource.id"
                  }
                },
                "dma_channel_trigger_polarity": {
                  "title": "Polarity",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Rising",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "const": "FALLING"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.trigger_xfer.configuration==false"
                    }
                  ],
                  "default": "RISING"
                },
                "dma_channel_trigger_mode": {
                  "title": "Mode",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Block transfer at each trigger",
                      "const": "BLOCK_TRANSFER"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($resource.features.g_addressing.programmable2D==true) && ($config.additional.repeated_block_xfer.configuration==true)"
                        }
                      ],
                      "title": "Repeated block transfer at each trigger",
                      "const": "REPEATED_BLOCK_TRANSFER"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$config.basic.dma_mode == 1"
                        }
                      ],
                      "title": "Node transfer at each trigger",
                      "const": "NODE_TRANSFER"
                    },
                    {
                      "title": "Single transfer at each trigger",
                      "const": "SINGLE_BURST_TRANSFER",
                      "actions": [
                        {
                          "type": "set",
                          "condition": "($resource.features.g_transfers.burst==false) || (($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_source_burst==1))",
                          "attributes": {
                            "title": "Single transfer at each trigger hit detected"
                          }
                        },
                        {
                          "type": "set",
                          "condition": "($resource.features.g_transfers.burst==true) && ($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_source_burst>1)",
                          "attributes": {
                            "title": "Burst transfer at each trigger hit detected"
                          }
                        }
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.trigger_xfer.configuration==false"
                    }
                  ],
                  "default": "SINGLE_BURST_TRANSFER"
                }
              }
            },
            "data_handling_xfer": {
              "title": "Data handling transfer",
              "type": "object",
              "description": "Select the data handling options.",
              "properties": {
                "configuration": {
                  "title": "Set data handling",
                  "description": "Turn on data manipulation options.",
                  "type": "boolean",
                  "default": false
                },
                "src_byte_exchange": {
                  "title": "Source byte exchange",
                  "type": "string",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_fifo_size>0"
                    },
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_byte_exchange": {
                  "title": "Destination byte exchange",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_fifo_size>0"
                    },
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_halfword_exchange": {
                  "title": "Destination half-word exchange",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_fifo_size>0"
                    },
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_word_exchange": {
                  "title": "Destination word exchange",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($resource.features.g_fifo_size>0) && (($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64))"
                    },
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "trunc_padd": {
                  "title": "Truncation and padding",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Left padding zero extended",
                      "const": "LEFT_PADD_ZERO"
                    },
                    {
                      "title": "Right padding sign extended",
                      "const": "RIGHT_PADD_SIGN"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "default": "LEFT_PADD_ZERO"
                },
                "pack": {
                  "title": "Packing",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Packed or unpacked",
                      "const": "PACKED_UNPACKED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_fifo_size>0"
                    },
                    {
                      "type": "disable",
                      "condition": "$config.additional.data_handling_xfer.configuration==false"
                    }
                  ],
                  "default": "PRESERVED"
                }
              }
            },
            "repeated_block_xfer": {
              "title": "Repeated block transfer",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.g_addressing.programmable2D==true"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set repeated block",
				  "type": "boolean",
                  "default": false
                },
                "block_count": {
                  "title": "Block repeat counter",
                  "type": "integer",
                  "description": "Select the number of repetitions of the current block.",
                  "unit": "Block",
                  "minimum": 1,
                  "maximum": 2048,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": 1
                },
                "burst_src_inc": {
                  "title": "Source single address incrementing",
                  "type": "string",
                  "description": "Select whether the source address is incremented by adding the programmed offset after each burst transfer from the source.",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_source_burst>1)",
                      "attributes": {
                        "title": "Source burst address incrementing",
                        "description": "Select the DMA channel burst source address increment."
                      }
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "burst_src_offset_byte": {
                  "title": "Source address offset increment",
                  "type": "integer",
                  "description": "Select the offset to increment or decrement the source address by a programmable value after each burst.",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 8191,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_source_burst>1)",
                      "attributes": {
                        "title": "Source burst address offset",
                        "description": "Select the DMA channel burst source address offset."
                      }
                    }
                  ],
                  "default": 0
                },
                "burst_dest_inc": {
                  "title": "Destination single address incrementing",
                  "type": "string",
                  "description": "Select whether the destination address is incremented by adding the programmed offset after each burst transfer to the destination.",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_destination_burst>1)",
                      "attributes": {
                        "title": "Destination burst address incrementing",
                        "description": "Select the DMA channel burst destination address increment."
                      }
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "burst_dest_offset_byte": {
                  "title": "Destination address offset increment",
                  "type": "integer",
                  "description": "Select the offset to increment or decrement the destination address by a programmable value after each burst.",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 8191,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.additional.burst_xfer.configuration==true) && ($config.additional.burst_xfer.dma_channel_destination_burst>1)",
                      "attributes": {
                        "title": "Destination burst address offset",
                        "description": "Select the DMA channel burst destination address offset."
                      }
                    }
                  ],
                  "default": 0
                },
                "block_src_inc": {
                  "title": "Source block address incrementing",
                  "type": "string",
                  "description": "Select the DMA channel block source address increment.",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "block_src_offset_byte": {
                  "title": "Source block address offset",
                  "type": "integer",
                  "description": "Select the repeated source address offset.",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 65535,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": 0
                },
                "block_dest_inc": {
                  "title": "Destination block address incrementing",
                  "type": "string",
                  "description": "Select the DMA channel block destination address increment.",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "block_dest_offset_byte": {
                  "title": "Destination block address offset",
                  "type": "integer",
                  "description": "Select the repeated destination address offset.",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 65535,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": 0
                },
                "event_mode": {
                  "title": "Event mode generation",
                  "type": "string",
                  "description": "Select the transfer complete event mode.",
                  "oneOf": [
                    {
                      "title": "At each block transfer",
                      "description": "The complete (and the half-complete) transfer event is generated at the (respectively half of the) end of a block.",
                      "const": "BLOCK"
                    },
                    {
                      "title": "At each repeated block transfer",
                      "description": "The complete (and the half) transfer event is generated at the end (respectively half of the end) of the 2D/repeated block.",
                      "const": "REPEATED_BLOCK"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$config.additional.repeated_block_xfer.configuration==false"
                    }
                  ],
                  "default": "BLOCK"
                }
              }
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
             {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "($get('swproject.getCurrentEngine').secure === 'Non-secure')",
              "attributes": {
                "title": "Privilege",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "title": "Security",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "$get('swproject.getCurrentEngine').secure === 'Secure-only'",
                  "message": "In Secure-only engine, all items are Secure."
                }
              ],
              "properties": {
                "channel_sec": {
                  "type": "string",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$isNeed",
                      "computed": {
                        "const": "$getRootParameter('security')"
                      }
                    }
                  ],
                  "title": "Channel security attribute",
                  "oneOf": [
                    {
                      "title": "Secure",
                      "const": "SEC"
                    },
                    {
                      "title": "Non-secure",
                      "const": "NSEC"
                    }
                  ],
                  "default": "SEC"
                },
                "xfer_sec": {
                  "title": "Transfer access security attributes",
                  "type": "object",
                  "properties": {
                    "dest_sec": {
                      "type": "string",
                      "title": "Destination access security attribute",
                      "oneOf": [
                        {
                          "title": "Secure",
                          "const": "SEC"
                        },
                        {
                          "title": "Non-secure",
                          "const": "NSEC"
                        }
                      ],
                      "default": "SEC"
                    },
                    "src_sec": {
                      "type": "string",
                      "title": "Source access security attribute",
                      "oneOf": [
                        {
                          "title": "Secure",
                          "const": "SEC"
                        },
                        {
                          "title": "Non-secure",
                          "const": "NSEC"
                        }
                      ],
                      "default": "SEC"
                    }
                  }
                }
              }
            },
            "privilege": {
              "title": "Privilege",
              "type": "object",
              "properties": {
                "channel_priv": {
                  "type": "string",
                  "title": "Channel privilege attribute",
                  "oneOf": [
                    {
                      "title": "Privileged",
                      "const": "PRIV"
                    },
                    {
                      "title": "Unprivileged",
                      "const": "NPRIV"
                    }
                  ],
                  "default": "PRIV"
                }
              }
            },
            "lock": {
              "title": "Lock",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "properties": {
                "channel_lock": {
                  "type": "boolean",
                  "title": "Channel lock attribute",
                  "default": false
                }
              }
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "type": "boolean",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "default": false,
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              }
            },
            "clock": {
              "type": "boolean",
              "default": false,
              "title": "Clock management in the generated code",
              "oneOf": [
                  {
                    "title": "Keep active after initialization",
                    "const": false
                  },
                  {
                    "title": "Deactivated at the end of sequence",
                    "const": true
                  }
                ]
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "set",
                      "computed": {
                        "default": "$isNeed ? true : false"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "$isNeed"
                    }
                  ]
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "Interrupt handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.system.nvic.enable_interruption && (!$isNeed && $config.info?.layer !== 'LL') || ($isNeed && ($getRootParameter('layer') === 'HAL'))"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$isNeed ||$config.system.nvic.enable_interruption"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "(!$isNeed && $config.info?.layer !== 'LL') || ($isNeed && ($getRootParameter('layer') === 'HAL'))",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}