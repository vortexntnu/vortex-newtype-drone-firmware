{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:RAMCFG",
  "grammarVersion": "3.7",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RAMCFG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "type": "string",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "enable_ecc": {
              "type": "boolean",
              "title": "Error Correction Code (ECC)",
              "default": false
            },
            "enable_single_ecc_interrupt": {
              "title": "Single ECC error interrupt",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$additional.enable_ecc === false",
                  "message": "This parameter is disabled because ECC is not enabled."
                }
              ]
            },
            "enable_double_ecc_interrupt": {
              "title": "Double ECC error interrupt",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$additional.enable_ecc === false",
                  "message": "This parameter is disabled because ECC is not enabled."
                }
              ]
            },
            "double_ecc_interrupt_line": {
              "title": "Double ECC error interrupt line",
              "type": "string",
              "description": "Choose which line triggers on a double ECC error.",
              "oneOf": [
                {
                  "title": "RAMCFG interrupt",
                  "const": "RAMCFG interrupt"
                },
                {
                  "title": "NMI (Non-Maskable Interrupt)",
                  "const": "NMI (Non-Maskable Interrupt)"
                }
              ],
              "default": "RAMCFG interrupt",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$additional.enable_double_ecc_interrupt === true",
                  "message": "This parameter is disabled because double ECC error interrupt is not enabled."
                }
              ]
            }
          },
          "actions": [
            {
              "type": "include",
              "condition": "$resource.features.ecc_feature == 1"
            }
          ]
        },
        "security_privilege": {
          "title": "Security and privilege",
          "#comment": "Use for instance for RAMCFG",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.parent"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privilege attribute",
              "description": "Set the privilege attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.parent"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.parent"
              },
              "default": false
            },
            "illegal_access": {
              "type": "boolean",
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.parent"
              },
              "default": false
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "description": "System configuration.",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "ramcfg_interruption": {
                  "type": "boolean",
                  "title": "RAMCFG interrupt",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "RAMCFG IRQ handler generation",
                  "description": "Handles RAMCFG interrupts when ECC errors occur in SRAM.",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.ramcfg_interruption === true ) && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "irq_config1": {
                  "title": "RAMCFG IRQ line priority",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.ramcfg_interruption === true)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "RAMCFG",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                },
                "nmi_interruption": {
                  "title": "NMI RAMCFG exception management",
                  "description": "This handler processes the NMI exception that occurs when a double ECC error is detected in the RAM.",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation_nmi": {
                  "type": "boolean",
                  "title": "NMI IRQ handler generation",
                  "description": "Handles NMI when a double ECC error occurs in SRAM.",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.nmi_interruption && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "irq_config_nmi": {
                  "title": "NMI IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.nmi_interruption"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "system:NMI"
                    }
                  ]
                }
              }
            }
          },
          "actions": [
            {
              "type": "include",
              "condition": "$resource.features.ecc_feature == 1"
            }
          ]
        }
      }
    }
  }
}