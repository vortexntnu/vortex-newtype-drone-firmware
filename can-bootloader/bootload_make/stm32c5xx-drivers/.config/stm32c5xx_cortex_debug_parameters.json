{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX DEBUG",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "mode": {
              "title": "Mode",
              "type": "integer",
              "oneOf": [
                {
                  "title": "JTAG (4 pins)",
                  "const": 0
                },
                {
                  "title": "JTAG (5 pins)",
                  "const": 1
                },
                {
                  "title": "JTAG with trace synchronous (1 bit)",
                  "const": 2,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED0') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (2 bits)",
                  "const": 3,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED1') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (4 bits)",
                  "const": 4,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED3') == true"
                    }
                  ]
                },
                {
                  "title": "Single-wire trace asynchronous",
                  "const": 5
                },
                {
                  "title": "Serial-wire",
                  "const": 6
                },
                {
                  "title": "Serial-wire trace synchronous (1 bit)",
                  "const": 7,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED0') == true"
                    }
                  ]
                },
                {
                  "title": "Serial-wire trace synchronous (2 bit)",
                  "const": 8,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED1') == true"
                    }
                  ]
                }
              ],
              "default": 0
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_jtms": {
                  "type": "object",
                  "title": "GPIO JTMS",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'JTMS') == true) || !($basic.mode <= 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "JTMS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_jtck": {
                  "type": "object",
                  "title": "GPIO JTCK",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'JTCK') == true) || !($basic.mode <= 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "JTCK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_jtdi": {
                  "type": "object",
                  "title": "GPIO JTDI",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'JTDI') == true) || !($basic.mode <= 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "JTDI",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_jtdo": {
                  "type": "object",
                  "title": "GPIO JTDO",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'JTDO') == true) || !($basic.mode <= 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "JTDO",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_swdio": {
                  "type": "object",
                  "title": "GPIO SWDIO",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'SWDIO') == true) || !($basic.mode >= 5)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "SWDIO",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_swclk": {
                  "type": "object",
                  "title": "GPIO SWCLK",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'SWCLK') == true) || !($basic.mode >= 5)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "SWCLK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traceswo": {
                  "type": "object",
                  "title": "GPIO TRACESWO",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACESWO') == true) || !($basic.mode == 5)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACESWO",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_njtrst": {
                  "type": "object",
                  "title": "GPIO NJTRST",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'NJTRST') == true) || !($basic.mode == 1)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "NJTRST",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traceclk": {
                  "type": "object",
                  "title": "GPIO TRACECLK",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACECLK') == true) || !($basic.mode >= 2 && $basic.mode != 5 && $basic.mode != 6)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACECLK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traced0": {
                  "type": "object",
                  "title": "GPIO TRACED0",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED0') == true) || !($basic.mode >= 2 && $basic.mode != 5 && $basic.mode != 6)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACED0",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traced1": {
                  "type": "object",
                  "title": "GPIO TRACED1",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED1') == true) || !($basic.mode == 3 || $basic.mode == 4 || $basic.mode == 8)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACED1",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traced2": {
                  "type": "object",
                  "title": "GPIO TRACED2",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED2') == true) || !($basic.mode == 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACED2",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_traced3": {
                  "type": "object",
                  "title": "GPIO TRACED3",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!($get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED3') == true) || !($basic.mode == 4)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "TRACED3",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}