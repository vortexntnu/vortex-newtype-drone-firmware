{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORDIC",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORDIC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "function": {
              "type": "string",
              "title": "Function",
              "description": "Trigonometric function calculation algorithm.",
              "default": "COSINE",
              "oneOf": [
                {
                  "title": "Cosine",
                  "const": "COSINE"
                },
                {
                  "title": "Sine",
                  "const": "SINE"
                },
                {
                  "title": "Phase",
                  "const": "PHASE"
                },
                {
                  "title": "Modulus",
                  "const": "MODULUS"
                },
                {
                  "title": "Arctangent",
                  "const": "ARCTANGENT"
                },
                {
                  "title": "Hyperbolic cosine",
                  "const": "HCOSINE",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 1"
                    }
                  ]
                },
                {
                  "title": "Hyperbolic sine",
                  "const": "HSINE",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 1"
                    }
                  ]
                },
                {
                  "title": "Hyperbolic arctangent",
                  "const": "HARCTANGENT",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 1"
                    }
                  ]
                },
                {
                  "title": "Natural logarithm",
                  "const": "NATURALLOG",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 1"
                    }
                  ]
                },
                {
                  "title": "Square root",
                  "const": "SQUAREROOT",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 1"
                    }
                  ]
                },
                {
                  "title": "Arccosine",
                  "const": "ARCCOSINE",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 2"
                    }
                  ]
                },
                {
                  "title": "Arcsine",
                  "const": "ARCSINE",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_func === 2"
                    }
                  ]
                }
              ]
            },
            "in_width": {
              "type": "integer",
              "title": "Input width",
              "default": 32,
              "oneOf": [
                {
                  "title": "32 bits",
                  "const": 32
                },
                {
                  "title": "16 bits",
                  "const": 16
                }
              ]
            },
            "nb_arg": {
              "type": "integer",
              "title": "Number of arguments",
              "description": "Number of 32-bit arguments required for one calculus.",
              "default": 1,
              "oneOf": [
                {
                  "title": "1",
                  "const": 1
                },
                {
                  "title": "2",
                  "const": 2,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'COSINE') || ($basic.function === 'SINE') || ($basic.function === 'PHASE') || ($basic.function === 'MODULUS')",
                      "message": "Two arguments are available only for COSINE, SINE, PHASE, and MODULUS functions."
                    }
                  ]
                }
              ]
            },
            "out_width": {
              "type": "integer",
              "title": "Output width",
              "default": 32,
              "oneOf": [
                {
                  "title": "32 bits",
                  "const": 32
                },
                {
                  "title": "16 bits",
                  "const": 16
                }
              ]
            },
            "nb_result": {
              "type": "integer",
              "title": "Number of results",
              "description": "Number of 32-bit result required after one calculus.",
              "default": 1,
              "oneOf": [
                {
                  "title": "1",
                  "const": 1
                },
                {
                  "title": "2",
                  "const": 2,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "(($basic.function === 'COSINE') || ($basic.function === 'SINE') || ($basic.function === 'PHASE') || ($basic.function === 'MODULUS') || ($basic.function === 'HCOSINE') || ($basic.function === 'HSINE')) && ($basic.out_width === 32)",
                      "message": "Two results are available only for 32-bit COSINE, SINE, PHASE, MODULUS, HCOSINE, and HSINE functions."
                    }
                  ]
                }
              ]
            },
            "scaling_factor": {
              "type": "integer",
              "title": "Scaling factor",
              "default": 0,
              "oneOf": [
                {
                  "title": "Scale 0",
                  "const": 0,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'COSINE') || ($basic.function === 'SINE') || ($basic.function === 'PHASE') || ($basic.function === 'MODULUS') || ($basic.function === 'SQUAREROOT') || ($basic.function === 'ARCTANGENT')",
                      "message": "Scale 0 is available for COSINE, SINE, PHASE, MODULUS, SQUAREROOT, and ARCTANGENT functions."
                    }
                  ]
                },
                {
                  "title": "Scale 1",
                  "const": 1,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'NATURALLOG') || ($basic.function === 'SQUAREROOT') || ($basic.function === 'ARCTANGENT') || ($basic.function === 'HARCTANGENT') || ($basic.function === 'HCOSINE') || ($basic.function === 'HSINE')",
                      "message": "Scale 1 is available for NATURALLOG, SQUAREROOT, ARCTANGENT, HARCTANGENT, HCOSINE, and HSINE functions."
                    }
                  ]
                },
                {
                  "title": "Scale 2",
                  "const": 2,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'SQUAREROOT') || ($basic.function === 'ARCTANGENT') || ($basic.function === 'NATURALLOG')",
                      "message": "Scale 2 is available for SQUAREROOT, ARCTANGENT, and NATURALLOG functions."
                    }
                  ]
                },
                {
                  "title": "Scale 3",
                  "const": 3,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'ARCTANGENT') || ($basic.function === 'NATURALLOG')",
                      "message": "Scale 3 is available for ARCTANGENT and NATURALLOG functions."
                    }
                  ]
                },
                {
                  "title": "Scale 4",
                  "const": 4,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'ARCTANGENT') || ($basic.function === 'NATURALLOG')",
                      "message": "Scale 4 is available for ARCTANGENT and NATURALLOG functions."
                    }
                  ]
                },
                {
                  "title": "Scale 5",
                  "const": 5,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'ARCTANGENT')",
                      "message": "Scale 5 is available only for the ARCTANGENT function."
                    }
                  ]
                },
                {
                  "title": "Scale 6",
                  "const": 6,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'ARCTANGENT')",
                      "message": "Scale 6 is available only for the ARCTANGENT function."
                    }
                  ]
                },
                {
                  "title": "Scale 7",
                  "const": 7,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.function === 'ARCTANGENT')",
                      "message": "Scale 7 is available only for the ARCTANGENT function."
                    }
                  ]
                }
              ]
            },
            "precision": {
              "type": "integer",
              "title": "Precision",
              "description": "Precision expressed in number of cycles.",
              "default": 5,
              "oneOf": [
                {
                  "title": "1 cycle",
                  "const": 1
                },
                {
                  "title": "2 cycles",
                  "const": 2
                },
                {
                  "title": "3 cycles",
                  "const": 3
                },
                {
                  "title": "4 cycles",
                  "const": 4
                },
                {
                  "title": "5 cycles",
                  "const": 5
                },
                {
                  "title": "6 cycles",
                  "const": 6
                },
                {
                  "title": "7 cycles",
                  "const": 7
                },
                {
                  "title": "8 cycles",
                  "const": 8
                },
                {
                  "title": "9 cycles",
                  "const": 9
                },
                {
                  "title": "10 cycles",
                  "const": 10
                },
                {
                  "title": "11 cycles",
                  "const": 11
                },
                {
                  "title": "12 cycles",
                  "const": 12
                },
                {
                  "title": "13 cycles",
                  "const": 13
                },
                {
                  "title": "14 cycles",
                  "const": 14
                },
                {
                  "title": "15 cycles",
                  "const": 15
                }
              ],
              "actions": [
                {
                  "type": "warning",
                  "condition": "($basic.precision > 3) && ($basic.function === 'SQUAREROOT') ",
                  "message": "The recommended precision range is 3."
                },
                {
                  "type": "warning",
                  "condition": "($basic.precision > 6) && ($basic.function != 'SQUAREROOT') ",
                  "message": "The recommended precision range is 6 "
                }
              ]
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "#comment": "Use for instance for CORDIC",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_wr": {
                  "type": "boolean",
                  "title": "DMA Write",
                  "default": false
                },
                "dma_config_wr": {
                  "title": "DMA Write",
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_wr"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "WR",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "default": "INCREMENTED"
                        },
                        "src_data_width": {
                          "default": "WORD"
                        },
                        "dest_data_width": {
                          "default": "WORD"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rd": {
                  "type": "boolean",
                  "title": "DMA Read",
                  "default": false
                },
                "dma_config_rd": {
                  "title": "DMA Read",
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rd"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "RD",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "dest_inc": {
                          "default": "INCREMENTED"
                        },
                        "src_data_width": {
                          "default": "WORD"
                        },
                        "dest_data_width": {
                          "default": "WORD"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "interruption_global": {
                  "title": "Global interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.interruption_global) && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.interruption_global"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}