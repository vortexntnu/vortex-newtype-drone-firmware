{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX SCB",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "ARM CMSIS",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "fault_management": {
              "title": "Fault management",
              "type": "object",
              "properties": {
                "enable_mem_management_fault": {
                  "title": "Memory management fault",
                  "type": "boolean",
                  "description": "The system escalates to hard fault if you do not enable it.",
                  "synchronize": true,
                  "synchronizeOn": {
                    "path": "mem_management_fault",
                    "component": "CORTEX"
                  },
                  "default": false
                },
                "enable_bus_fault": {
                  "title": "Bus fault",
                  "type": "boolean",
                  "description": "The system escalates to hard fault if you do not enable it.",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "CORTEX_BUSFAULT_ENABLED",
                      "condition": "$value",
                      "value": true
                    }
                  ],
                  "default": false
                },
                "enable_usage_fault": {
                  "title": "Usage fault",
                  "type": "boolean",
                  "description": "The system escalates to hard fault if you do not enable it.",
                  "default": false
                }
              }
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_management_mem": {
                  "title": "Memory management priority management",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$basic.fault_management.enable_mem_management_fault",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_config1": {
                  "title": "Memory management priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_management_mem"
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:MemManage"
                    }
                  ]
                },
                "enable_management_bus": {
                  "title": "Bus fault priority management",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$basic.fault_management.enable_bus_fault",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_config2": {
                  "title": "Bus fault priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_management_bus"
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:BusFault"
                    }
                  ]
                },
                "enable_management_usage": {
                  "title": "Usage fault priority management",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$basic.fault_management.enable_usage_fault",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_config3": {
                  "title": "Usage fault priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_management_usage"
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "system:UsageFault"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}