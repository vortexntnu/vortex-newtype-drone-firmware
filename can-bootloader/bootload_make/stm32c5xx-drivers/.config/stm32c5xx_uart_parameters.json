{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:UART",
  "grammarVersion": "3.1",
  "functions": [
    {
      "path": ".config/template/helpers/uart_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_UART_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "readOnly": true,
              "default": "UART"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "mode": {
              "type": "string",
              "title": "Mode",
              "oneOf": [
                {
                  "title": "Asynchronous",
                  "const": "async"
                },
                {
                  "title": "Single wire (half-duplex)",
                  "const": "half_duplex_single_wire_mode"
                },
                {
                  "title": "Multiprocessor communication",
                  "const": "multiprocessor_communication"
                },
                {
                  "title": "LIN",
                  "const": "lin",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.lin_master==true"
                    }
                  ]
                }
              ],
              "default": "async"
            },
            "baud_rate": {
              "type": "integer",
              "title": "Baud rate",
              "description": "This member configures the UART communication baud rate.\n      The baud rate register is computed using the following formula:\n          - LPUART:\n            - Baud Rate Register = ((256 * lpuart_ker_ckpres) / ((hal_uart_config_t->baud_rate)))\n              where lpuart_ker_ck_pres is the UART input clock divided by a prescaler\n          - UART:\n            - If oversampling is 16 or in LIN mode,\n              Baud Rate Register = ((uart_ker_ckpres) / ((hal_uart_config_t->baud_rate)))\n            - If oversampling is 8,\n              Baud Rate Register[15:4] = ((2 * uart_ker_ckpres) /\n              ((hal_uart_config_t->baud_rate)))[15:4]\n              Baud Rate Register[3] =  0\n              Baud Rate Register[2:0] =  (((2 * uart_ker_ckpres) /\n              ((hal_uart_config_t->baud_rate)))[3:0]) >> 1\n            where uart_ker_ck_pres is the UART input clock divided by a prescaler.",
              "actions": [
                {
                  "type": "set",
                  "computed": {
                    "minimum": "$common.helper_uart_get_min_baud_rate($get('clock.frequency',$resource.id), $additional.clock_prescaler, $additional.over_sampling, $resource.features.baudgen_type)",
                    "maximum": "$common.helper_uart_get_max_baud_rate($get('clock.frequency',$resource.id), $additional.clock_prescaler, $additional.over_sampling, $resource.features.baudgen_type)"
                  },
                  "condition": "true"
                }
              ],
              "minimum": 0,
              "maximum": 20000000,
              "default": 115200
            },
            "word_length": {
              "type": "string",
              "title": "Word length",
              "description": "Number of data bits transmitted or received in a frame.",
              "oneOf": [
                {
                  "title": "7-bit (including parity)",
                  "const": "7",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.mode==='lin'"
                    }
                  ]
                },
                {
                  "title": "8-bit (including parity)",
                  "const": "8"
                },
                {
                  "title": "9-bit (including parity)",
                  "const": "9",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.mode==='lin'"
                    }
                  ]
                }
              ],
              "default": "8"
            },
            "parity": {
              "type": "string",
              "title": "Parity",
              "description": "Parity mode. When parity is enabled, the computed parity is inserted at the MSB position of the transmitted data (9th bit when the word length is set to 9 data bits; 8th bit when the word length is set to 8 data bits).",
              "oneOf": [
                {
                  "title": "None",
                  "const": "NONE"
                },
                {
                  "title": "Even",
                  "const": "EVEN"
                },
                {
                  "title": "Odd",
                  "const": "ODD"
                }
              ],
              "default": "NONE"
            },
            "stop_bit": {
              "type": "string",
              "title": "Stop bit",
              "description": "Number of stop bit transmitted.",
              "oneOf": [
                {
                  "title": "0.5 stop bit",
                  "const": "0_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.id != 'LPUART1'"
                    }
                  ]
                },
                {
                  "title": "1 stop bit",
                  "const": "1"
                },
                {
                  "title": "1.5 stop bits",
                  "const": "1_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.id != 'LPUART1'"
                    }
                  ]
                },
                {
                  "title": "2 stop bits",
                  "const": "2"
                }
              ],
              "default": "1"
            },
            "direction": {
              "type": "string",
              "title": "Data direction",
              "description": "Receive and/or transmit mode selection.",
              "oneOf": [
                {
                  "title": "Receive",
                  "const": "RX"
                },
                {
                  "title": "Transmit",
                  "const": "TX"
                },
                {
                  "title": "Transmit and receive",
                  "const": "TX_RX",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') && $get('pinout.peripheralCanBeMapped', $resource.id, 'RX')"
                    }
                  ]
                }
              ],
              "default": "TX_RX"
            },
            "hw_flow_ctl": {
              "type": "string",
              "title": "Hardware flow control (RS232)",
              "oneOf": [
                {
                  "title": "None",
                  "const": "NONE"
                },
                {
                  "title": "RTS",
                  "const": "RTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'RTS') && $basic.mode==='async' && $basic.direction!='TX'"
                    }
                  ]
                },
                {
                  "title": "CTS",
                  "const": "CTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'CTS') && $basic.mode==='async' && $basic.direction!='RX'"
                    }
                  ]
                },
                {
                  "title": "RTS/CTS",
                  "const": "RTS_CTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'RTS') && $get('pinout.peripheralCanBeMapped', $resource.id, 'CTS')) && $basic.mode==='async' && $basic.direction==='TX_RX'"
                    }
                  ]
                }
              ],
              "default": "NONE"
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "over_sampling": {
              "type": "string",
              "title": "Over sampling",
              "description": "Over sampling 8 to achieve higher speed (up to f_PCLK/8).",
              "oneOf": [
                {
                  "title": "16",
                  "const": "16"
                },
                {
                  "title": "8",
                  "const": "8",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($basic.mode==='lin') || ($resource.features.baudgen_type==true)"
                    }
                  ]
                }
              ],
              "default": "16"
            },
            "one_bit_sampling": {
              "type": "boolean",
              "title": "One bit sampling",
              "description": "Single sample or three samples majority. Selecting the single sample method increases the receiver tolerance to clock deviations.",
              "default": false,
              "actions": [
                {
                  "message": "One bit sampling is not available in this instance.",
                  "type": "disable",
                  "condition": "$resource.features.baudgen_type==true"
                }
              ]
            },
            "clock_prescaler": {
              "type": "integer",
              "title": "Clock prescaler",
              "description": "Prescaler value used to divide the UART clock source.",
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                },
                {
                  "title": "DIV256",
                  "const": 256
                }
              ],
              "default": 1
            },
            "enable_rs485_mode": {
              "type": "boolean",
              "title": "RS485 driver",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.mode=='async'"
                },
                {
                  "type": "error",
                  "condition": "$basic.hw_flow_ctl != 'NONE' && additional.enable_rs485_mode == true",
                  "message": "Hardware flow control (RS232) must be set to None."
                }
              ],
              "default": false
            },
            "polarity": {
              "type": "string",
              "title": "Driver enable (DE) polarity",
              "oneOf": [
                {
                  "title": "High",
                  "const": "HIGH"
                },
                {
                  "title": "Low",
                  "const": "LOW"
                }
              ],
              "default": "HIGH",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_rs485_mode===true"
                }
              ]
            },
            "assertion_time_samples": {
              "type": "integer",
              "title": "Assertion time (sample time unit)",
              "description": "Assertion time must be between 0 sample time unit and 31 sample time unit.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_rs485_mode===true"
                }
              ],
              "minimum": 0,
              "maximum": 31,
              "default": 0
            },
            "deassertion_time_samples": {
              "type": "integer",
              "title": "Deassertion time (sample time unit)",
              "description": "Deassertion time must be between 0 sample time unit and 31 sample time unit.",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_rs485_mode===true"
                }
              ],
              "minimum": 0,
              "maximum": 31,
              "default": 0
            },
            "am_enable_packet_trigger": {
              "type": "boolean",
              "title": "Autonomous mode",
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.features.auton) && ($basic.mode==='async') && ((!$additional.enable_rs485_mode) || ($additional.enable_rs485_mode===false)) && ((!$basic.hw_flow_ctl) || ($basic.hw_flow_ctl ==='NONE'))"
                },
                {
                  "type": "info",
                  "condition": "true",
                  "message": "The selected interconnect must be configured manually."
                }
              ],
              "default": false
            },
            "trigger_polarity": {
              "type": "string",
              "title": "Trigger polarity",
              "oneOf": [
                {
                  "title": "Rising",
                  "const": "RISING"
                },
                {
                  "title": "Falling",
                  "const": "FALLING"
                }
              ],
              "default": "RISING",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.am_enable_packet_trigger"
                }
              ]
            },
            "packet_size_byte": {
              "type": "integer",
              "title": "Data size (bytes)",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.am_enable_packet_trigger"
                }
              ],
              "minimum": 0,
              "maximum": 65535,
              "default": 0
            },
            "source": {
              "type": "object",
              "title": "Trigger source selection",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.am_enable_packet_trigger"
                },
                {
                  "type": "info",
                  "condition": "true",
                  "message": "The selected interconnect must be configured manually"
                }
              ],
              "objectType": "query",
              "query": {
                "entity": "peripheral.interconnect.input trigger",
                "parent": "$resource.id",
                "title": "{{source}} ({{id}})"
              }
            },
            "am_enable_idle": {
              "type": "boolean",
              "title": "Idle frame",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.am_enable_packet_trigger"
                }
              ],
              "default": false
            },
            "enable_fifo_mode": {
              "type": "boolean",
              "title": "FIFO mode",
              "default": false,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.mode==='lin'"
                },
                {
                  "type": "set",
                  "condition": "$basic.mode==='lin'",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "set_tx_fifo_threshold": {
              "type": "string",
              "title": "Tx FIFO threshold",
              "oneOf": [
                {
                  "title": "1 eighth full",
                  "const": "1_8"
                },
                {
                  "title": "1 quart full",
                  "const": "1_4"
                },
                {
                  "title": "Half full",
                  "const": "1_2"
                },
                {
                  "title": "3 quarts full",
                  "const": "3_4"
                },
                {
                  "title": "7 eighth full",
                  "const": "7_8"
                },
                {
                  "title": "Empty",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            },
            "set_rx_fifo_threshold": {
              "type": "string",
              "title": "Rx FIFO threshold",
              "oneOf": [
                {
                  "title": "1 eighth full",
                  "const": "1_8"
                },
                {
                  "title": "1 quart full",
                  "const": "1_4"
                },
                {
                  "title": "Half full",
                  "const": "1_2"
                },
                {
                  "title": "3 quarts full",
                  "const": "3_4"
                },
                {
                  "title": "7 eighth full",
                  "const": "7_8"
                },
                {
                  "title": "Full",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional.enable_fifo_mode"
                }
              ]
            },
            "set_lin_mode_break_detect_length": {
              "type": "string",
              "title": "Break detect length",
              "description": "In LIN mode, set the break detection length.",
              "oneOf": [
                {
                  "title": "10 bits",
                  "const": "10"
                },
                {
                  "title": "11 bits",
                  "const": "11"
                }
              ],
              "default": "10",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.mode==='lin'"
                }
              ]
            },
            "wakeup_method": {
              "title": "Wake up method from mute mode",
              "type": "string",
              "oneOf": [
                {
                  "title": "Idle line",
                  "const": "IDLE_LINE"
                },
                {
                  "title": "Address mark",
                  "const": "ADDRESS_MARK"
                }
              ],
              "default": "IDLE_LINE",
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.mode==='multiprocessor_communication'"
                }
              ]
            },
            "address_length": {
              "type": "string",
              "title": "Wake up address length",
              "oneOf": [
                {
                  "title": "4 bits",
                  "const": "4"
                },
                {
                  "title": "7 bits",
                  "const": "7"
                }
              ],
              "default": "4",
              "actions": [
                {
                  "type": "include",
                  "condition": "($basic.mode==='multiprocessor_communication') && ($additional.wakeup_method==='ADDRESS_MARK')"
                }
              ]
            },
            "address": {
              "type": "integer",
              "title": "Wake up address",
              "description": "Address of the UART node.",
              "actions": [
                {
                  "type": "set",
                  "attributes": {
                    "maximum": 15
                  },
                  "condition": "$additional.address_length==='4'"
                },
                {
                  "type": "set",
                  "attributes": {
                    "maximum": 63
                  },
                  "condition": "$additional.address_length==='7' && $basic.word_length==='7' "
                },
                {
                  "type": "set",
                  "attributes": {
                    "maximum": 127
                  },
                  "condition": "$additional.address_length==='7' && $basic.word_length==='8' "
                },
                {
                  "type": "include",
                  "condition": "($basic.mode==='multiprocessor_communication') && ($additional.wakeup_method==='ADDRESS_MARK')"
                }
              ],
              "minimum": 0,
              "maximum": 255,
              "default": 0
            },
            "enable_stop_mode": {
              "type": "boolean",
              "title": "Wake up from low power mode (LP)",
              "default": false
            },
            "set_config_auto_baud_rate": {
              "type": "string",
              "title": "Auto baudrate mode",
              "oneOf": [
                {
                  "title": "Disable",
                  "const": "DISABLE"
                },
                {
                  "title": "On start bit",
                  "const": "START_BIT"
                },
                {
                  "title": "On falling edge",
                  "const": "FALLING_EDGE"
                },
                {
                  "title": "On 0x7F frame",
                  "const": "0X7F_FRAME",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.word_length=='7'"
                    }
                  ]
                },
                {
                  "title": "On 0x55 frame",
                  "const": "0X55_FRAME",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.word_length=='7'"
                    }
                  ]
                }
              ],
              "default": "DISABLE",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.abr_rto_sct1==true"
                }
              ]
            },
            "enable_tx_pin_level_invert": {
              "type": "boolean",
              "title": "Tx pin active level inversion",
              "default": false
            },
            "enable_rx_pin_level_invert": {
              "type": "boolean",
              "title": "Rx pin active level inversion",
              "default": false
            },
            "enable_data_invert": {
              "type": "boolean",
              "title": "Data inversion",
              "default": false
            },
            "enable_tx_rx_swap": {
              "type": "boolean",
              "title": "Tx and Rx pins swapping",
              "default": false
            },
            "enable_receiver_timeout": {
              "type": "boolean",
              "title": "Receiver timeout",
              "description": "UART receiver timeout feature into the handler instance registers.",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.id != 'LPUART1'"
                }
              ]
            },
            "set_receiver_timeout": {
              "type": "integer",
              "title": "Receiver timeout value",
              "description": "UART receiver timeout value passed in parameters into the handler instance registers.",
              "default": 0,
              "actions": [
                {
                  "type": "include",
                  "condition": "($additional.enable_receiver_timeout)"
                }
              ],
              "minimum": 0,
              "maximum": 16777215
            },
            "rx_over_run_detection": {
              "type": "boolean",
              "title": "Overrun detection",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.direction=='TX'"
                }
              ],
              "default": true
            },
            "enable_dma_stop_on_rx_error": {
              "type": "boolean",
              "title": "DMA stop on Rx error",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$basic.direction=='TX'"
                }
              ],
              "default": false
            },
            "enable_msb_first": {
              "type": "boolean",
              "title": "MSB first",
              "default": false
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_tx": {
                  "title": "GPIO Tx",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'TX') || ($basic.mode!='half_duplex_single_wire_mode' && (($basic.direction == 'RX' && (!$additional.enable_tx_rx_swap)) || ($basic.direction == 'TX' && $additional.enable_tx_rx_swap))) || ($basic.mode=='half_duplex_single_wire_mode' && $additional.enable_tx_rx_swap)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rx": {
                  "title": "GPIO Rx",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'RX') || (($basic.mode!='half_duplex_single_wire_mode'  && (($basic.direction == 'RX' && $additional.enable_tx_rx_swap) || ($basic.direction == 'TX' && (!$additional.enable_tx_rx_swap)))) || ($basic.mode=='half_duplex_single_wire_mode' && (!$additional.enable_tx_rx_swap)))"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rts": {
                  "title": "GPIO RTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'RTS') && ($basic.hw_flow_ctl === 'RTS' || $basic.hw_flow_ctl === 'RTS_CTS') && (!$additional.enable_rs485_mode)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RTS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_cts": {
                  "title": "GPIO CTS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'CTS') && ($basic.hw_flow_ctl === 'CTS' || $basic.hw_flow_ctl === 'RTS_CTS')"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CTS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_de": {
                  "title": "GPIO DE",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'RTS') && ($additional.enable_rs485_mode)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RTS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "type": "boolean",
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'TX' || $basic.direction === 'TX_RX'"
                    }
                  ],
                  "default": false
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "default": "INCREMENTED"
                        },
                        "dest_inc": {
                          "default": "FIXED"
                        },
                        "dest_data_width": {
                          "default": "BYTE"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rx": {
                  "type": "boolean",
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.direction === 'RX' || $basic.direction === 'TX_RX'"
                    },
                    {
                      "type": "set",
                      "condition": "$additional.enable_dma_stop_on_rx_error",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "dma_config_rx": {
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "default": "FIXED"
                        },
                        "dest_inc": {
                          "default": "INCREMENTED"
                        },
                        "dest_data_width": {
                          "default": "BYTE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "message": "Interrupt is mandatory when DMA is enabled.",
                      "type": "disable",
                      "condition": "$system.dma.enable_dma_tx"
                    },
                    {
                      "type": "set",
                      "condition": "$system.dma.enable_dma_tx",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC UART global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}