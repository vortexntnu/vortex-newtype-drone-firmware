{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CRS",
  "grammarVersion": "3.8",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "title": "Add a label",
              "type": "array",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CRS_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "type": "string",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "init": {
              "title": "Use default synchronization signal",
              "description": "Enable the CRS with the default source of synchronization.",
              "type": "boolean",
              "default": true
            },
            "trimming": {
              "title": "Trimming capability",
              "type": "object",
              "properties": {
                "auto_trimming": {
                  "title": "Auto-trimming",
                  "description": "Enable the automatic hardware adjustment of HSI144 oscillator trimming.",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ],
                  "default": false
                },
                "trimming_value": {
                  "title": "Trimming value",
                  "description": "Adjust the HSI144 oscillator trimming value. This value is relevant only when auto-trimming is disabled.",
                  "type": "integer",
                  "default": 48,
                  "minimum": 0,
                  "maximum": 95,
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($basic.trimming.auto_trimming === false) && ($basic.init === false)",
                      "message": "Can be configured only when the default synchronization signal is not used and auto-trimming is disabled."
                    }
                  ]
                }
              }
            },
            "sync_signal": {
              "title": "Synchronization signal",
              "type": "object",
              "properties": {
                "sync_source": {
                  "title": "Synchronization signal source",
                  "type": "string",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    },
                    {
                      "type": "error",
                      "condition": "($basic.init === false) && ($basic.sync_signal.sync_source === 'LSE') && ($get('envVar.value', 'RCC_PROJECT_LSE') !== true)",
                      "message": "LSE clock must be enabled."
                    },
                    {
                      "type": "error",
                      "condition": "($basic.init === false) && (($basic.sync_signal.sync_source === 'OTG_FS') || ($basic.sync_signal.sync_source === 'OTG_HS') || ($basic.sync_signal.sync_source === 'USB')) && !$get('peripheral.isBound', 'USB_DRD_FS.HOST')",
                      "message": "USB host must be enabled."
                    },
                    {
                      "type": "error",
                      "condition": "($basic.init === false) && ($basic.sync_signal.sync_source === 'HSE_1MHZ') && ($get('envVar.value', 'RCC_PROJECT_HSE') !== true)",
                      "message": "HSE clock must be enabled."
                    },
                    {
                      "type": "error",
                      "condition": "($basic.init === false) && ($basic.sync_signal.sync_source === 'HSE_1MHZ') && ($get('clock.frequency','HSE_Divider_RTC') !== 1000000)",
                      "message": "HSE divider RTC frequency must be set to 1 MHz."
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "GPIO as synchronization source",
                      "description": "GPIO is selected as sync source.",
                      "const": "GPIO"
                    },
                    {
                      "title": "LSE as synchronization source",
                      "description": "LSE is selected as sync source.",
                      "const": "LSE",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', 'RCC', 'OSC32_IN') === true) && ($get('pinout.peripheralCanBeMapped', 'RCC', 'OSC32_OUT') === true)"
                        }
                      ]
                    },
                    {
                      "title": "USB SOF as synchronization source",
                      "description": "USB SOF is selected as sync source.",
                      "const": "USB"
                    },
                    {
                      "title": "HSE 1 MHz as synchronization source",
                      "description": "HSE 1 MHz is selected as sync source.",
                      "const": "HSE_1MHZ",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', 'RCC', 'OSC_IN') === true) && ($get('pinout.peripheralCanBeMapped', 'RCC', 'OSC_OUT') === true)"
                        }
                      ]
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": " CRS_CORE_USE_HSE_SYNC ",
                      "condition": "$value === 'HSE_1MHZ'",
                      "semaphore": true
                    },
                    {
                      "on": "update-value",
                      "name": " CRS_CORE_USE_LSE_SYNC ",
                      "condition": "$value === 'LSE'",
                      "semaphore": true
                    }
                  ],
                  "default": "USB"
                },
                "sync_polarity": {
                  "title": "Synchronization signal polarity",
                  "type": "string",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Synchronization active on rising edge",
                      "const": "RISING"
                    },
                    {
                      "title": "Synchronization active on falling edge",
                      "const": "FALLING"
                    }
                  ],
                  "default": "RISING"
                },
                "sync_divider": {
                  "title": "Synchronization signal divider",
                  "type": "integer",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Not divided",
                      "const": 1
                    },
                    {
                      "title": "Divided by 2",
                      "const": 2
                    },
                    {
                      "title": "Divided by 4",
                      "const": 4
                    },
                    {
                      "title": "Divided by 8",
                      "const": 8
                    },
                    {
                      "title": "Divided by 16",
                      "const": 16
                    },
                    {
                      "title": "Divided by 32",
                      "const": 32
                    },
                    {
                      "title": "Divided by 64",
                      "const": 64
                    },
                    {
                      "title": "Divided by 128",
                      "const": 128
                    }
                  ],
                  "default": 1
                }
              }
            },
            "frequency_error_counter": {
              "title": "Frequency error counter",
              "type": "object",
              "properties": {
                "counter_reload": {
                  "title": "Counter reload",
                  "description": "The value to be loaded in the frequency error counter with each synchronization event.",
                  "type": "integer",
                  "default": 47999,
                  "minimum": 0,
                  "maximum": 65535,
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ]
                },
                "frequency_error_limit": {
                  "title": "Frequency error limit",
                  "description": "The value to be used to evaluate the captured frequency error value.",
                  "type": "integer",
                  "default": 34,
                  "minimum": 0,
                  "maximum": 255,
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ]
                }
              }
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "#comment": "Use for instance for CRS",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "gpio": {
              "title": "GPIO",
              "type": "object",
              "properties": {
                "sync_gpio": {
                  "title": "Sync",
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($basic.sync_signal.sync_source === 'GPIO') && ($basic.init === false)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                        "on": "update-value",
                        "name": "HAL_GPIO_PROJECT_USE_HAL",
                        "condition": "$info.layer === 'HAL'",
                        "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "SYNC",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ]
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.enable_interruption) && ($info.layer === 'HAL')"
                    },
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ]
                },
                "irq_line": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_CORTEX_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.enable_interruption) && ($basic.init === false)"
                    },
                    {
                      "type": "enable",
                      "condition": "$basic.init === false",
                      "message": "Can be configured only when the default synchronization signal is not used."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}