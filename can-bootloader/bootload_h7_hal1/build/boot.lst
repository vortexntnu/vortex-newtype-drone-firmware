  48:Core/Src/boot.c **** int boot_can_senderror(uint32_t code)
  49:Core/Src/boot.c **** {
  50:Core/Src/boot.c **** 	uint64_t errsig = 0xdeadbeef + ((uint64_t)code << 32);
  51:Core/Src/boot.c **** 	can_senddata((uint8_t*)&errsig, 8, BOOT_SEND_PING);
  52:Core/Src/boot.c **** 	err(1);
  53:Core/Src/boot.c **** 	return 1;
  54:Core/Src/boot.c **** }
  55:Core/Src/boot.c **** int boot_can_resendfrom(uint32_t idx)
  56:Core/Src/boot.c **** {
