  42:Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c_ex.c ****           (++) HAL_I2CEx_EnableWakeUp()
  43:Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c_ex.c ****           (++) HAL_I2CEx_DisableWakeUp()
